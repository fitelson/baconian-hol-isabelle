theorem pp_named_r_boomerang_if_F:
  assumes F_r:
      "[] ; pp_full_QLN_named_r_axioms \<turnstile>\<^sub>CEV\<^sub>s App pp_F pp_r"
  shows
      "[] ; pp_full_QLN_named_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        Conj (App pp_F pp_r) (Neg (\<box>\<^sub>o (App pp_F pp_r)))"
  using F_r pp_named_r_derives_not_box_F
  by (rule CEV_set_conj_intro)

subsection \<open>Fresh-representative obstructions\<close>

lemma CEV_Kr_fresh_rep_implies_KTrue_eq_KFalse:
  assumes M_type: "\<Gamma> \<turnstile> M : Prop \<rightarrow>\<^sub>o Prop"
    and fresh: "c \<notin> consts_of M"
    and rep:
      "\<Gamma> \<turnstile>\<^sub>CEV
        Eq (Prop \<rightarrow>\<^sub>o Prop) (pp_K (Const c Prop)) M"
  shows
    "\<Gamma> \<turnstile>\<^sub>CEV
      Eq (Prop \<rightarrow>\<^sub>o Prop) (pp_K ObjTrue) (pp_K ObjFalse)"
proof -
  have K_true_type: "\<Gamma> \<turnstile> pp_K ObjTrue : Prop \<rightarrow>\<^sub>o Prop"
    using typed_ObjTrue by (rule typed_pp_K)
  have K_false_type: "\<Gamma> \<turnstile> pp_K ObjFalse : Prop \<rightarrow>\<^sub>o Prop"
    using typed_ObjFalse by (rule typed_pp_K)
  have d_true_raw:
      "\<Gamma> \<turnstile>\<^sub>CEV subst_const c Prop ObjTrue
        (Eq (Prop \<rightarrow>\<^sub>o Prop) (pp_K (Const c Prop)) M)"
    using rep typed_ObjTrue by (rule CEV_proves_subst_const)
  have d_true:
      "\<Gamma> \<turnstile>\<^sub>CEV
        Eq (Prop \<rightarrow>\<^sub>o Prop) (pp_K ObjTrue) M"
    using d_true_raw fresh
    by (simp add: subst_const_pp_K)
  have d_false_raw:
      "\<Gamma> \<turnstile>\<^sub>CEV subst_const c Prop ObjFalse
        (Eq (Prop \<rightarrow>\<^sub>o Prop) (pp_K (Const c Prop)) M)"
    using rep typed_ObjFalse by (rule CEV_proves_subst_const)
  have d_false:
      "\<Gamma> \<turnstile>\<^sub>CEV
        Eq (Prop \<rightarrow>\<^sub>o Prop) (pp_K ObjFalse) M"
    using d_false_raw fresh
    by (simp add: subst_const_pp_K)
  have d_false_sym:
      "\<Gamma> \<turnstile>\<^sub>CEV
        Eq (Prop \<rightarrow>\<^sub>o Prop) M (pp_K ObjFalse)"
    using K_false_type M_type d_false by (rule CEV_eq_sym_from)
  show ?thesis
    using K_true_type M_type K_false_type d_true d_false_sym
    by (rule CEV_eq_trans_from)
qed

lemma no_pure_rep_Kr:
  assumes noncollapse:
      "\<not> \<Gamma> \<turnstile>\<^sub>CEV
        Eq (Prop \<rightarrow>\<^sub>o Prop) (pp_K ObjTrue) (pp_K ObjFalse)"
  shows
    "\<not> (\<exists>M.
      \<Gamma> \<turnstile> M : Prop \<rightarrow>\<^sub>o Prop \<and>
      c \<notin> consts_of M \<and>
      \<Gamma> \<turnstile>\<^sub>CEV
        Eq (Prop \<rightarrow>\<^sub>o Prop) (pp_K (Const c Prop)) M)"
proof
  assume "\<exists>M.
    \<Gamma> \<turnstile> M : Prop \<rightarrow>\<^sub>o Prop \<and>
    c \<notin> consts_of M \<and>
    \<Gamma> \<turnstile>\<^sub>CEV
      Eq (Prop \<rightarrow>\<^sub>o Prop) (pp_K (Const c Prop)) M"
  then obtain M where
    M_type: "\<Gamma> \<turnstile> M : Prop \<rightarrow>\<^sub>o Prop" and
    fresh: "c \<notin> consts_of M" and
    rep:
      "\<Gamma> \<turnstile>\<^sub>CEV
        Eq (Prop \<rightarrow>\<^sub>o Prop) (pp_K (Const c Prop)) M"
    by blast
  have "\<Gamma> \<turnstile>\<^sub>CEV
      Eq (Prop \<rightarrow>\<^sub>o Prop) (pp_K ObjTrue) (pp_K ObjFalse)"
    using M_type fresh rep
    by (rule CEV_Kr_fresh_rep_implies_KTrue_eq_KFalse)
  then show False
    using noncollapse by contradiction
qed

lemma CEV_fun_role_fresh_rep_implies_true_false_role_collapse:
  assumes M_type: "\<Gamma> \<turnstile> M : Prop \<rightarrow>\<^sub>o Prop"
    and fresh: "c \<notin> consts_of M"
    and rep:
      "\<Gamma> \<turnstile>\<^sub>CEV
        Eq (Prop \<rightarrow>\<^sub>o Prop)
          (pp_singleton_fun_role (Const c Prop)) M"
  shows
    "\<Gamma> \<turnstile>\<^sub>CEV
      Eq (Prop \<rightarrow>\<^sub>o Prop)
        (pp_singleton_fun_role ObjTrue)
        (pp_singleton_fun_role ObjFalse)"
proof -
  have true_role_type:
      "\<Gamma> \<turnstile> pp_singleton_fun_role ObjTrue : Prop \<rightarrow>\<^sub>o Prop"
    using typed_ObjTrue by (rule typed_pp_singleton_fun_role)
  have false_role_type:
      "\<Gamma> \<turnstile> pp_singleton_fun_role ObjFalse : Prop \<rightarrow>\<^sub>o Prop"
    using typed_ObjFalse by (rule typed_pp_singleton_fun_role)
  have d_true_raw:
      "\<Gamma> \<turnstile>\<^sub>CEV subst_const c Prop ObjTrue
        (Eq (Prop \<rightarrow>\<^sub>o Prop)
          (pp_singleton_fun_role (Const c Prop)) M)"
    using rep typed_ObjTrue by (rule CEV_proves_subst_const)
  have d_true:
      "\<Gamma> \<turnstile>\<^sub>CEV
        Eq (Prop \<rightarrow>\<^sub>o Prop)
          (pp_singleton_fun_role ObjTrue) M"
    using d_true_raw fresh
    by (simp add: subst_const_pp_singleton_fun_role)
  have d_false_raw:
      "\<Gamma> \<turnstile>\<^sub>CEV subst_const c Prop ObjFalse
        (Eq (Prop \<rightarrow>\<^sub>o Prop)
          (pp_singleton_fun_role (Const c Prop)) M)"
    using rep typed_ObjFalse by (rule CEV_proves_subst_const)
  have d_false:
      "\<Gamma> \<turnstile>\<^sub>CEV
        Eq (Prop \<rightarrow>\<^sub>o Prop)
          (pp_singleton_fun_role ObjFalse) M"
    using d_false_raw fresh
    by (simp add: subst_const_pp_singleton_fun_role)
  have d_false_sym:
      "\<Gamma> \<turnstile>\<^sub>CEV
        Eq (Prop \<rightarrow>\<^sub>o Prop)
          M (pp_singleton_fun_role ObjFalse)"
    using false_role_type M_type d_false by (rule CEV_eq_sym_from)
  show ?thesis
    using true_role_type M_type false_role_type d_true d_false_sym
    by (rule CEV_eq_trans_from)
qed

lemma no_pure_rep_singleton_fun_role:
  assumes noncollapse:
      "\<not> \<Gamma> \<turnstile>\<^sub>CEV
        Eq (Prop \<rightarrow>\<^sub>o Prop)
          (pp_singleton_fun_role ObjTrue)
          (pp_singleton_fun_role ObjFalse)"
  shows
    "\<not> (\<exists>M.
      \<Gamma> \<turnstile> M : Prop \<rightarrow>\<^sub>o Prop \<and>
      c \<notin> consts_of M \<and>
      \<Gamma> \<turnstile>\<^sub>CEV
        Eq (Prop \<rightarrow>\<^sub>o Prop)
          (pp_singleton_fun_role (Const c Prop)) M)"
proof
  assume "\<exists>M.
    \<Gamma> \<turnstile> M : Prop \<rightarrow>\<^sub>o Prop \<and>
    c \<notin> consts_of M \<and>
    \<Gamma> \<turnstile>\<^sub>CEV
      Eq (Prop \<rightarrow>\<^sub>o Prop)
        (pp_singleton_fun_role (Const c Prop)) M"
  then obtain M where
    M_type: "\<Gamma> \<turnstile> M : Prop \<rightarrow>\<^sub>o Prop" and
    fresh: "c \<notin> consts_of M" and
    rep:
      "\<Gamma> \<turnstile>\<^sub>CEV
        Eq (Prop \<rightarrow>\<^sub>o Prop)
          (pp_singleton_fun_role (Const c Prop)) M"
    by blast
  have "\<Gamma> \<turnstile>\<^sub>CEV
      Eq (Prop \<rightarrow>\<^sub>o Prop)
        (pp_singleton_fun_role ObjTrue)
        (pp_singleton_fun_role ObjFalse)"
    using M_type fresh rep
    by (rule CEV_fun_role_fresh_rep_implies_true_false_role_collapse)
  then show False
    using noncollapse by contradiction
qed

