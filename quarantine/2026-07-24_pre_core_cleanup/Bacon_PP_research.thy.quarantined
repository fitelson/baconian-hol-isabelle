    using membership pp_purity_schema_typed[OF pp_pure_prop_id_in_schema]
    by (rule CEV_set_derivable.Assumption)
qed

lemma pp_QSS_r_derives_pure_prop_id:
  "[] ; pp_full_QLN_QSS_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_pure (Prop \<rightarrow>\<^sub>o Prop) prop_id"
  using pp_full_QLN_derives_pure_prop_id
  by (rule CEV_set_derivable_mono)
    (auto simp: pp_full_QLN_QSS_r_axioms_def pp_full_QLN_r_axioms_def)

lemma pp_QSS_r_derives_pure_K_true:
  "[] ; pp_full_QLN_QSS_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K ObjTrue)"
