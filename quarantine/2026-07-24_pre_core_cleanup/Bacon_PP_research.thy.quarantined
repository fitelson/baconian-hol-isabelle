lemma pp_consistency_with_persistence_imp_consistency:
  assumes "pp_consistency_question_with_persistence"
  shows "pp_consistency_question"
  using assms pp_full_QLN_subset_persistence
  unfolding pp_consistency_question_with_persistence_def
    pp_consistency_question_def
  by (rule CEV_consistent_mono)

subsection \<open>The K/F terms\<close>

definition pp_K :: "oterm \<Rightarrow> oterm" where
  "pp_K P = Lam Prop (shift P)"

definition pp_F :: oterm where
  "pp_F =
    Lam Prop
      (Neg
        (pp_pure (Prop \<rightarrow>\<^sub>o Prop)
          (pp_K (Var 0))))"

definition pp_F_builder_type :: otype where
  "pp_F_builder_type = (Prop \<rightarrow>\<^sub>o Prop) \<rightarrow>\<^sub>o Prop"

definition pp_F_builder :: oterm where
  "pp_F_builder =
    Lam pp_F_builder_type
      (Lam Prop
        (Neg
          (App (Var 1) (pp_K (Var 0)))))"

definition pp_singleton_fun_role :: "oterm \<Rightarrow> oterm" where
  "pp_singleton_fun_role R =
    Lam Prop (Eq Prop (Var 0) (shift R))"

definition pp_agreement_builder :: oterm where
  "pp_agreement_builder =
    Lam (Prop \<rightarrow>\<^sub>o Prop)
      (Lam Prop
        (Eq Prop
          (App (Var 1) (Var 0))
          (Var 0)))"

definition pp_Kr_agreement :: oterm where
  "pp_Kr_agreement = App pp_agreement_builder (pp_K pp_r)"

definition pp_agreement_application_purity_instance :: oterm where
  "pp_agreement_application_purity_instance =
    Imp
      (Conj
        (pp_pure
          ((Prop \<rightarrow>\<^sub>o Prop) \<rightarrow>\<^sub>o
            (Prop \<rightarrow>\<^sub>o Prop))
          pp_agreement_builder)
        (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K pp_r)))
      (pp_pure (Prop \<rightarrow>\<^sub>o Prop) pp_Kr_agreement)"

lemma typed_pp_K:
  assumes "\<Gamma> \<turnstile> P : Prop"
  shows "\<Gamma> \<turnstile> pp_K P : Prop \<rightarrow>\<^sub>o Prop"
  unfolding pp_K_def
  using assms weakening_front by auto

lemma typed_pp_F:
  "[] \<turnstile> pp_F : Prop \<rightarrow>\<^sub>o Prop"
  by (rule infer_type_sound)
    (simp add: pp_F_def pp_K_def pp_pure_def pp_Pure_def
      shift_def lookup_def)

lemma typed_pp_F_builder:
  "[] \<turnstile> pp_F_builder :
    pp_F_builder_type \<rightarrow>\<^sub>o (Prop \<rightarrow>\<^sub>o Prop)"
  by (rule infer_type_sound)
    (simp add: pp_F_builder_def pp_F_builder_type_def pp_K_def
      shift_def lookup_def)

lemma typed_pp_singleton_fun_role:
  assumes "\<Gamma> \<turnstile> R : Prop"
  shows "\<Gamma> \<turnstile> pp_singleton_fun_role R : Prop \<rightarrow>\<^sub>o Prop"
proof -
  have shifted_R: "Prop # \<Gamma> \<turnstile> shift R : Prop"
    using assms by (rule weakening_front)
  have "Prop # \<Gamma> \<turnstile> Eq Prop (Var 0) (shift R) : Prop"
    using shifted_R by auto
  then show ?thesis
    unfolding pp_singleton_fun_role_def
    by (rule has_type.Lam)
qed

lemma typed_pp_agreement_builder:
  "\<Gamma> \<turnstile> pp_agreement_builder :
    (Prop \<rightarrow>\<^sub>o Prop) \<rightarrow>\<^sub>o (Prop \<rightarrow>\<^sub>o Prop)"
  by (rule infer_type_sound)
    (simp add: pp_agreement_builder_def lookup_def)

lemma typed_pp_Kr_agreement:
  "[] \<turnstile> pp_Kr_agreement : Prop \<rightarrow>\<^sub>o Prop"
  unfolding pp_Kr_agreement_def
  using typed_pp_agreement_builder typed_pp_K[OF typed_pp_r]
  by auto

lemma typed_pp_agreement_application_purity_instance:
  "[] \<turnstile> pp_agreement_application_purity_instance : Prop"
  unfolding pp_agreement_application_purity_instance_def
  using typed_pp_agreement_builder typed_pp_K[OF typed_pp_r]
    typed_pp_Kr_agreement
  by (intro has_type.Imp has_type.Conj typed_pp_pure)

lemma pp_F_has_expanded_pure_vocabulary:
  "pp_expanded_pure_vocabulary pp_F"
  by (simp add: pp_expanded_pure_vocabulary_def pp_F_def pp_K_def pp_pure_def
      pp_Pure_def pp_pure_name_def shift_def)

lemma pp_F_builder_has_logical_vocabulary:
  "pp_logical_vocabulary pp_F_builder"
  by (simp add: pp_logical_vocabulary_def pp_F_builder_def pp_K_def shift_def)

lemma pp_agreement_builder_has_logical_vocabulary:
  "pp_logical_vocabulary pp_agreement_builder"
  by (simp add: pp_logical_vocabulary_def pp_agreement_builder_def)

lemma pp_agreement_builder_purity_in_schema:
  "pp_pure
      ((Prop \<rightarrow>\<^sub>o Prop) \<rightarrow>\<^sub>o
        (Prop \<rightarrow>\<^sub>o Prop))
      pp_agreement_builder
    \<in> pp_purity_schema"
  unfolding pp_purity_schema_def
  using typed_pp_agreement_builder[
    of "[]"] pp_agreement_builder_has_logical_vocabulary
  by blast

lemma pp_F_builder_application_beta:
  "beta_eta_equiv [] (Prop \<rightarrow>\<^sub>o Prop)
    (App pp_F_builder (pp_Pure (Prop \<rightarrow>\<^sub>o Prop)))
    pp_F"
proof -
  have left_type:
      "[] \<turnstile> App pp_F_builder (pp_Pure (Prop \<rightarrow>\<^sub>o Prop)) :
        Prop \<rightarrow>\<^sub>o Prop"
    using typed_pp_F_builder typed_pp_Pure
    unfolding pp_F_builder_type_def
    by auto
  have step:
      "compatible_step beta_contract
        (App pp_F_builder (pp_Pure (Prop \<rightarrow>\<^sub>o Prop)))
        pp_F"
  proof -
    have root:
        "compatible_step beta_contract
          (App pp_F_builder (pp_Pure (Prop \<rightarrow>\<^sub>o Prop)))
          (subst0 (pp_Pure (Prop \<rightarrow>\<^sub>o Prop))
            (Lam Prop
              (Neg
                (App (Var 1) (pp_K (Var 0))))))"
      unfolding pp_F_builder_def
      by (intro compatible_step.root beta_contract.beta)
    then show ?thesis
      by (simp add: pp_F_def pp_K_def pp_pure_def subst0_def
          pp_Pure_def subst_lift_shift)
  qed
  show ?thesis
    using left_type typed_pp_F step
    by (rule beta_eta_equiv.Beta)
qed

lemma pp_K_ObjTrue_has_pure_vocabulary:
  "pp_logical_vocabulary (pp_K ObjTrue)"
  by (simp add: pp_logical_vocabulary_def pp_K_def shift_def ObjTrue_def)

lemma pp_pure_K_ObjTrue_in_schema:
  "pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K ObjTrue) \<in> pp_purity_schema"
  unfolding pp_purity_schema_def
  using typed_pp_K[OF typed_ObjTrue, of "[]"]
    pp_K_ObjTrue_has_pure_vocabulary
  by blast

lemma pp_F_builder_purity_in_schema:
  "pp_pure
      (pp_F_builder_type \<rightarrow>\<^sub>o (Prop \<rightarrow>\<^sub>o Prop))
      pp_F_builder
    \<in> pp_purity_schema"
  unfolding pp_purity_schema_def
  using typed_pp_F_builder pp_F_builder_has_logical_vocabulary
  by blast

lemma subst_const_pp_K:
  "subst_const c Prop N (pp_K P) =
    pp_K (subst_const c Prop N P)"
  unfolding pp_K_def
  by (simp add: subst_const_shift)

lemma subst_const_pp_singleton_fun_role:
  "subst_const c Prop N (pp_singleton_fun_role R) =
    pp_singleton_fun_role (subst_const c Prop N R)"
  unfolding pp_singleton_fun_role_def
  by (simp add: subst_const_shift)

lemma beta_eta_pp_F_apply:
  assumes P_type: "\<Gamma> \<turnstile> P : Prop"
  shows "beta_eta_equiv \<Gamma> Prop
    (App pp_F P)
    (Neg (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K P)))"
proof -
  have F_type: "\<Gamma> \<turnstile> pp_F : Prop \<rightarrow>\<^sub>o Prop"
    by (rule infer_type_sound)
      (simp add: pp_F_def pp_K_def pp_pure_def pp_Pure_def
        shift_def lookup_def)
  have left_type: "\<Gamma> \<turnstile> App pp_F P : Prop"
    using F_type P_type by auto
  have K_type: "\<Gamma> \<turnstile> pp_K P : Prop \<rightarrow>\<^sub>o Prop"
    using P_type by (rule typed_pp_K)
  have right_type:
      "\<Gamma> \<turnstile> Neg (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K P)) : Prop"
    using typed_pp_pure[OF K_type] by auto
  have step: "compatible_step beta_contract
      (App pp_F P)
      (Neg (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K P)))"
  proof -
    have root: "compatible_step beta_contract
        (App pp_F P)
        (subst0 P
          (Neg
            (pp_pure (Prop \<rightarrow>\<^sub>o Prop)
              (pp_K (Var 0)))))"
      unfolding pp_F_def
      by (intro compatible_step.root beta_contract.beta)
    then show ?thesis
      by (simp add: pp_K_def pp_pure_def pp_Pure_def subst0_def
          subst_lift_shift)
  qed
  show ?thesis
    using left_type right_type step by (rule beta_eta_equiv.Beta)
qed

lemma beta_eta_pp_K_apply:
  assumes P_type: "\<Gamma> \<turnstile> P : Prop"
    and Q_type: "\<Gamma> \<turnstile> Q : Prop"
  shows "beta_eta_equiv \<Gamma> Prop (App (pp_K P) Q) P"
proof -
  have K_type: "\<Gamma> \<turnstile> pp_K P : Prop \<rightarrow>\<^sub>o Prop"
    using P_type by (rule typed_pp_K)
  have left_type: "\<Gamma> \<turnstile> App (pp_K P) Q : Prop"
    using K_type Q_type by auto
  have step:
      "compatible_step beta_contract (App (pp_K P) Q) P"
  proof -
    have root:
        "compatible_step beta_contract
          (App (pp_K P) Q) (subst0 Q (shift P))"
      unfolding pp_K_def
      by (intro compatible_step.root beta_contract.beta)
    then show ?thesis
      by simp
  qed
  show ?thesis
    using left_type P_type step by (rule beta_eta_equiv.Beta)
qed

lemma beta_eta_pp_singleton_fun_role_apply:
  assumes R_type: "\<Gamma> \<turnstile> R : Prop"
    and Q_type: "\<Gamma> \<turnstile> Q : Prop"
  shows "beta_eta_equiv \<Gamma> Prop
    (App (pp_singleton_fun_role R) Q)
    (Eq Prop Q R)"
proof -
  have role_type:
      "\<Gamma> \<turnstile> pp_singleton_fun_role R : Prop \<rightarrow>\<^sub>o Prop"
    using R_type by (rule typed_pp_singleton_fun_role)
  have left_type:
      "\<Gamma> \<turnstile> App (pp_singleton_fun_role R) Q : Prop"
    using role_type Q_type by auto
  have right_type: "\<Gamma> \<turnstile> Eq Prop Q R : Prop"
    using Q_type R_type by auto
  have step:
      "compatible_step beta_contract
        (App (pp_singleton_fun_role R) Q)
        (Eq Prop Q R)"
  proof -
    have root:
        "compatible_step beta_contract
          (App (pp_singleton_fun_role R) Q)
          (subst0 Q (Eq Prop (Var 0) (shift R)))"
      unfolding pp_singleton_fun_role_def
      by (intro compatible_step.root beta_contract.beta)
    then show ?thesis
      by (simp add: subst0_def)
  qed
  show ?thesis
    using left_type right_type step by (rule beta_eta_equiv.Beta)
qed

lemma CEV_pp_singleton_fun_role_apply_eq:
  assumes R_type: "\<Gamma> \<turnstile> R : Prop"
    and Q_type: "\<Gamma> \<turnstile> Q : Prop"
  shows "\<Gamma> \<turnstile>\<^sub>CEV
    Eq Prop
      (App (pp_singleton_fun_role R) Q)
      (Eq Prop Q R)"
proof -
  have left_type:
      "\<Gamma> \<turnstile> App (pp_singleton_fun_role R) Q : Prop"
    using typed_pp_singleton_fun_role[OF R_type] Q_type by auto
  have right_type: "\<Gamma> \<turnstile> Eq Prop Q R : Prop"
    using Q_type R_type by auto
  have bicond:
      "\<Gamma> \<turnstile>\<^sub>CEV
        (App (pp_singleton_fun_role R) Q \<longleftrightarrow>\<^sub>o
          Eq Prop Q R)"
    using beta_eta_pp_singleton_fun_role_apply[OF R_type Q_type]
    by (rule CEV_beta_eta_equiv)
  show ?thesis
    using left_type right_type bicond by (rule CEV_zeroary_equivalence)
qed

lemma beta_eta_pp_Kr_agreement_apply:
  assumes Q_type: "\<Gamma> \<turnstile> Q : Prop"
  shows "beta_eta_equiv \<Gamma> Prop
    (App pp_Kr_agreement Q)
    (Eq Prop pp_r Q)"
proof -
  let ?H =
    "Lam Prop
      (Eq Prop
        (App (pp_K pp_r) (Var 0))
        (Var 0))"
  let ?E = "Eq Prop (App (pp_K pp_r) Q) Q"
  have Kr_type: "\<Gamma> \<turnstile> pp_K pp_r : Prop \<rightarrow>\<^sub>o Prop"
    using typed_pp_r by (rule typed_pp_K)
  have agreement_type:
      "\<Gamma> \<turnstile> pp_Kr_agreement : Prop \<rightarrow>\<^sub>o Prop"
    unfolding pp_Kr_agreement_def
    using typed_pp_agreement_builder Kr_type by auto
  have left_type: "\<Gamma> \<turnstile> App pp_Kr_agreement Q : Prop"
    using agreement_type Q_type by auto
  have H_type: "\<Gamma> \<turnstile> ?H : Prop \<rightarrow>\<^sub>o Prop"
  proof -
    have Kr_ext:
        "Prop # \<Gamma> \<turnstile> pp_K pp_r : Prop \<rightarrow>\<^sub>o Prop"
      using weakening_front[OF Kr_type, of Prop]
      by (simp add: pp_K_def pp_r_def shift_def)
    have var_type: "Prop # \<Gamma> \<turnstile> Var 0 : Prop"
      by auto
    have app_type:
        "Prop # \<Gamma> \<turnstile> App (pp_K pp_r) (Var 0) : Prop"
      using Kr_ext var_type by auto
    have body_type:
        "Prop # \<Gamma> \<turnstile>
          Eq Prop (App (pp_K pp_r) (Var 0)) (Var 0) : Prop"
      using app_type var_type by auto
    show ?thesis
      using body_type by auto
  qed
  have H_Q_type: "\<Gamma> \<turnstile> App ?H Q : Prop"
    using H_type Q_type by auto
  have E_type: "\<Gamma> \<turnstile> ?E : Prop"
    using Kr_type Q_type by auto
  have target_type: "\<Gamma> \<turnstile> Eq Prop pp_r Q : Prop"
    using typed_pp_r Q_type by auto
  have step1:
      "compatible_step beta_contract
        (App pp_Kr_agreement Q)
        (App ?H Q)"
  proof -
    have root:
        "compatible_step beta_contract
          (App pp_agreement_builder (pp_K pp_r))
          (subst0 (pp_K pp_r)
            (Lam Prop
              (Eq Prop
                (App (Var 1) (Var 0))
                (Var 0))))"
      unfolding pp_agreement_builder_def
      by (intro compatible_step.root beta_contract.beta)
    have reduced:
        "subst0 (pp_K pp_r)
            (Lam Prop
              (Eq Prop
                (App (Var 1) (Var 0))
                (Var 0))) = ?H"
      by (simp add: subst0_def pp_K_def pp_r_def shift_def)
    show ?thesis
      unfolding pp_Kr_agreement_def
      using compatible_step.App_left[OF root] reduced by simp
  qed
  have eqv1: "beta_eta_equiv \<Gamma> Prop
      (App pp_Kr_agreement Q) (App ?H Q)"
    using left_type H_Q_type step1 by (rule beta_eta_equiv.Beta)
  have step2: "compatible_step beta_contract (App ?H Q) ?E"
  proof -
    have root:
        "compatible_step beta_contract
          (App ?H Q)
          (subst0 Q
            (Eq Prop
              (App (pp_K pp_r) (Var 0))
              (Var 0)))"
      by (intro compatible_step.root beta_contract.beta)
    then show ?thesis
      by (simp add: subst0_def pp_K_def pp_r_def shift_def)
  qed
  have eqv2: "beta_eta_equiv \<Gamma> Prop (App ?H Q) ?E"
    using H_Q_type E_type step2 by (rule beta_eta_equiv.Beta)
  have K_step:
      "compatible_step beta_contract
        (App (pp_K pp_r) Q) pp_r"
  proof -
    have root:
        "compatible_step beta_contract
          (App (pp_K pp_r) Q)
          (subst0 Q (shift pp_r))"
      unfolding pp_K_def
      by (intro compatible_step.root beta_contract.beta)
    then show ?thesis by simp
  qed
  have step3:
      "compatible_step beta_contract ?E (Eq Prop pp_r Q)"
    using K_step by (rule compatible_step.Eq_left)
  have eqv3: "beta_eta_equiv \<Gamma> Prop ?E (Eq Prop pp_r Q)"
    using E_type target_type step3 by (rule beta_eta_equiv.Beta)
  have "beta_eta_equiv \<Gamma> Prop
      (App pp_Kr_agreement Q) ?E"
    using eqv1 eqv2 by (rule beta_eta_equiv.Trans)
  then show ?thesis
    using eqv3 by (rule beta_eta_equiv.Trans)
qed

lemma CEV_pp_Kr_agreement_apply:
  assumes Q_type: "\<Gamma> \<turnstile> Q : Prop"
  shows "\<Gamma> \<turnstile>\<^sub>CEV
    (App pp_Kr_agreement Q \<longleftrightarrow>\<^sub>o Eq Prop pp_r Q)"
  using beta_eta_pp_Kr_agreement_apply[OF Q_type]
  by (rule CEV_beta_eta_equiv)

lemma CEV_pp_K_apply_eq:
  assumes P_type: "\<Gamma> \<turnstile> P : Prop"
    and Q_type: "\<Gamma> \<turnstile> Q : Prop"
  shows "\<Gamma> \<turnstile>\<^sub>CEV Eq Prop (App (pp_K P) Q) P"
proof -
  have app_type: "\<Gamma> \<turnstile> App (pp_K P) Q : Prop"
    using typed_pp_K[OF P_type] Q_type by auto
  have bicond:
      "\<Gamma> \<turnstile>\<^sub>CEV (App (pp_K P) Q \<longleftrightarrow>\<^sub>o P)"
    using beta_eta_pp_K_apply[OF P_type Q_type]
    by (rule CEV_beta_eta_equiv)
  show ?thesis
    using app_type P_type bicond by (rule CEV_zeroary_equivalence)
qed

lemma CEV_prop_id_apply_eq:
  assumes A_type: "\<Gamma> \<turnstile> A : Prop"
  shows "\<Gamma> \<turnstile>\<^sub>CEV Eq Prop (App prop_id A) A"
proof -
  have app_type: "\<Gamma> \<turnstile> App prop_id A : Prop"
    using typed_prop_id A_type by auto
  show ?thesis
    using app_type A_type CEV_beta_prop_id[OF A_type]
    by (rule CEV_zeroary_equivalence)
qed

lemma CEV_pp_F_apply:
  assumes "\<Gamma> \<turnstile> P : Prop"
  shows "\<Gamma> \<turnstile>\<^sub>CEV
    (App pp_F P \<longleftrightarrow>\<^sub>o
      Neg (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K P)))"
  using beta_eta_pp_F_apply[OF assms]
  by (rule CEV_beta_eta_equiv)

subsection \<open>Deriving the purity of the diagonal operator\<close>

lemma CEV_set_forall_elim:
  assumes derivation: "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Forall \<sigma> A"
    and term_type: "\<Gamma> \<turnstile> M : \<sigma>"
  shows "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s subst0 M A"
proof -
  have forall_type: "\<Gamma> \<turnstile> Forall \<sigma> A : Prop"
    using derivation by (rule CEV_set_derivable_formula)
  have body_type: "\<sigma> # \<Gamma> \<turnstile> A : Prop"
    using forall_type by cases simp
  have ui:
      "\<Gamma> \<turnstile>\<^sub>CEV Imp (Forall \<sigma> A) (subst0 M A)"
    using body_type term_type
    by (intro CEV_proves.CE CE_proves.C C_proves.H H_proves.UI)
  have local_ui:
      "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Imp (Forall \<sigma> A) (subst0 M A)"
    using ui by (rule CEV_set_derivable.Theorem)
  show ?thesis
    using derivation local_ui by (rule CEV_set_derivable.Derive_MP)
qed

lemma pp_QSS_r_derives_instance:
  assumes X_type: "[] \<turnstile> X : Prop \<rightarrow>\<^sub>o Prop"
    and Y_type: "[] \<turnstile> Y : Prop \<rightarrow>\<^sub>o Prop"
    and R_type: "[] \<turnstile> R : Prop"
    and X_closed: "rename Suc X = X"
    and Y_closed: "rename Suc Y = Y"
  shows "[] ; pp_full_QLN_QSS_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_QSS_instance X Y R"
proof -
  let ?T = "Prop \<rightarrow>\<^sub>o Prop"
  have qss_member: "pp_QSS \<in> pp_full_QLN_QSS_r_axioms"
    by (simp add: pp_full_QLN_QSS_r_axioms_def)
  have qss: "[] ; pp_full_QLN_QSS_r_axioms \<turnstile>\<^sub>CEV\<^sub>s pp_QSS"
    using qss_member typed_pp_QSS
    by (rule CEV_set_derivable.Assumption)
  have first_raw:
      "[] ; pp_full_QLN_QSS_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        subst0 X
          (Forall ?T
            (Forall Prop
              (Imp
                (Conj
                  (pp_pure ?T (Var 2))
                  (Conj
                    (pp_pure ?T (Var 1))
                    (pp_fun Prop (Var 0))))
                (Imp
                  (Eq Prop (App (Var 2) (Var 0))
                    (App (Var 1) (Var 0)))
                  (Eq ?T (Var 2) (Var 1))))))"
    using qss X_type
    unfolding pp_QSS_def
    by (rule CEV_set_forall_elim)
  have first:
      "[] ; pp_full_QLN_QSS_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        Forall ?T
          (Forall Prop
            (Imp
              (Conj
                (pp_pure ?T (rename Suc (rename Suc X)))
                (Conj
                  (pp_pure ?T (Var 1))
                  (pp_fun Prop (Var 0))))
              (Imp
                (Eq Prop
                  (App (rename Suc (rename Suc X)) (Var 0))
                  (App (Var 1) (Var 0)))
                (Eq ?T (rename Suc (rename Suc X)) (Var 1)))))"
    using first_raw
    by (simp add: subst0_def pp_pure_def pp_Pure_def
        pp_fun_def pp_Fun_def subst_lift_shift eval_nat_numeral)
  have second_raw:
      "[] ; pp_full_QLN_QSS_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        subst0 Y
          (Forall Prop
            (Imp
              (Conj
                (pp_pure ?T (rename Suc (rename Suc X)))
                (Conj
                  (pp_pure ?T (Var 1))
                  (pp_fun Prop (Var 0))))
              (Imp
                (Eq Prop
                  (App (rename Suc (rename Suc X)) (Var 0))
                  (App (Var 1) (Var 0)))
                (Eq ?T (rename Suc (rename Suc X)) (Var 1)))))"
    using first Y_type
    by (rule CEV_set_forall_elim)
  have cancel_X:
      "subst (lift_subst (case_nat Y Var))
        (rename Suc (rename Suc X)) = rename Suc X"
  proof -
    have inner:
        "subst (case_nat Y Var) (shift X) = X"
      using subst0_shift[of Y X]
      unfolding subst0_def .
    have outer:
        "subst (lift_subst (case_nat Y Var)) (shift (shift X)) =
          shift (subst (case_nat Y Var) (shift X))"
      by (rule subst_lift_shift)
    show ?thesis
      using outer inner unfolding shift_def by simp
  qed
  have second:
      "[] ; pp_full_QLN_QSS_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        Forall Prop
          (Imp
            (Conj
              (pp_pure ?T (rename Suc X))
              (Conj
                (pp_pure ?T (rename Suc Y))
                (pp_fun Prop (Var 0))))
            (Imp
              (Eq Prop
                (App (rename Suc X) (Var 0))
                (App (rename Suc Y) (Var 0)))
              (Eq ?T (rename Suc X) (rename Suc Y))))"
    using second_raw
    by (simp add: subst0_def pp_pure_def pp_Pure_def
        pp_fun_def pp_Fun_def subst_lift_shift cancel_X)
  have second_closed:
      "[] ; pp_full_QLN_QSS_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        Forall Prop
          (Imp
            (Conj
              (pp_pure ?T X)
              (Conj
                (pp_pure ?T Y)
                (pp_fun Prop (Var 0))))
            (Imp
              (Eq Prop (App X (Var 0)) (App Y (Var 0)))
              (Eq ?T X Y)))"
    using second X_closed Y_closed by simp
  have third_raw:
      "[] ; pp_full_QLN_QSS_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        subst0 R
          (Imp
            (Conj
              (pp_pure ?T X)
              (Conj
                (pp_pure ?T Y)
                (pp_fun Prop (Var 0))))
            (Imp
              (Eq Prop (App X (Var 0)) (App Y (Var 0)))
              (Eq ?T X Y)))"
    using second_closed R_type
    by (rule CEV_set_forall_elim)
  have cancel_X_R: "subst (case_nat R Var) X = X"
    using subst0_shift[of R X] X_closed
    unfolding subst0_def shift_def by simp
  have cancel_Y_R: "subst (case_nat R Var) Y = Y"
    using subst0_shift[of R Y] Y_closed
    unfolding subst0_def shift_def by simp
  show ?thesis
    using third_raw X_closed Y_closed
    by (simp add: pp_QSS_instance_def subst0_def pp_pure_def pp_Pure_def
        pp_fun_def pp_Fun_def cancel_X_R cancel_Y_R)
qed

lemma pp_derives_unary_recombination_instance:
  assumes unary_member: "pp_unary_recombination \<in> T"
    and X_type: "[] \<turnstile> X : Prop \<rightarrow>\<^sub>o Prop"
    and R_type: "[] \<turnstile> R : Prop"
    and X_closed: "rename Suc X = X"
  shows "[] ; T \<turnstile>\<^sub>CEV\<^sub>s
    pp_unary_recombination_instance X R"
proof -
  have unary: "[] ; T \<turnstile>\<^sub>CEV\<^sub>s pp_unary_recombination"
    using unary_member typed_pp_unary_recombination
    by (rule CEV_set_derivable.Assumption)
  have first_raw:
      "[] ; T \<turnstile>\<^sub>CEV\<^sub>s
        subst0 X
          (Forall Prop
            (Imp
              (Conj
                (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (Var 1))
                (pp_fun Prop (Var 0)))
              (Imp
                (\<box>\<^sub>o (App (Var 1) (Var 0)))
                (Forall Prop (App (Var 2) (Var 0))))))"
    using unary X_type
    unfolding pp_unary_recombination_def
    by (rule CEV_set_forall_elim)
  have first:
      "[] ; T \<turnstile>\<^sub>CEV\<^sub>s
        Forall Prop
          (Imp
            (Conj
              (pp_pure (Prop \<rightarrow>\<^sub>o Prop) X)
              (pp_fun Prop (Var 0)))
            (Imp
              (\<box>\<^sub>o (App X (Var 0)))
              (Forall Prop (App X (Var 0)))))"
    using first_raw X_closed
    by (simp add: subst0_def pp_pure_def pp_Pure_def
        pp_fun_def pp_Fun_def ObjBox_def ObjTrue_def
        subst_lift_shift shift_def eval_nat_numeral)
  have second_raw:
      "[] ; T \<turnstile>\<^sub>CEV\<^sub>s
        subst0 R
          (Imp
            (Conj
              (pp_pure (Prop \<rightarrow>\<^sub>o Prop) X)
              (pp_fun Prop (Var 0)))
            (Imp
              (\<box>\<^sub>o (App X (Var 0)))
              (Forall Prop (App X (Var 0)))))"
    using first R_type by (rule CEV_set_forall_elim)
  have cancel_X_R: "subst (case_nat R Var) X = X"
    using subst0_shift[of R X] X_closed
    unfolding subst0_def shift_def by simp
  have cancel_X_lift_R:
      "subst (lift_subst (case_nat R Var)) X = X"
  proof -
    have lifted:
        "subst (lift_subst (case_nat R Var)) (shift X) =
          shift (subst (case_nat R Var) X)"
      by (rule subst_lift_shift)
    show ?thesis
      using lifted cancel_X_R X_closed unfolding shift_def by simp
  qed
  show ?thesis
    using second_raw X_closed
    by (simp add: pp_unary_recombination_instance_def subst0_def
        pp_pure_def pp_Pure_def pp_fun_def pp_Fun_def
        ObjBox_def ObjTrue_def cancel_X_R cancel_X_lift_R)
qed

lemma CEV_eq_app_cong:
  assumes F_type: "\<Gamma> \<turnstile> F : \<sigma> \<rightarrow>\<^sub>o \<tau>"
    and G_type: "\<Gamma> \<turnstile> G : \<sigma> \<rightarrow>\<^sub>o \<tau>"
    and M_type: "\<Gamma> \<turnstile> M : \<sigma>"
  shows "\<Gamma> \<turnstile>\<^sub>CEV
    Imp
      (Eq (\<sigma> \<rightarrow>\<^sub>o \<tau>) F G)
      (Eq \<tau> (App F M) (App G M))"
proof -
  let ?rho = "\<sigma> \<rightarrow>\<^sub>o \<tau>"
  let ?A = "App F M"
  let ?B = "App G M"
  let ?P =
    "Lam ?rho
      (Eq \<tau>
        (App (shift F) (shift M))
        (App (Var 0) (shift M)))"
  have A_type: "\<Gamma> \<turnstile> ?A : \<tau>"
    using F_type M_type by auto
  have B_type: "\<Gamma> \<turnstile> ?B : \<tau>"
    using G_type M_type by auto
  have shifted_F_type: "?rho # \<Gamma> \<turnstile> shift F : ?rho"
    using F_type by (rule weakening_front)
  have shifted_M_type: "?rho # \<Gamma> \<turnstile> shift M : \<sigma>"
    using M_type by (rule weakening_front)
  have var_type: "?rho # \<Gamma> \<turnstile> Var 0 : ?rho"
    by auto
  have left_type:
      "?rho # \<Gamma> \<turnstile> App (shift F) (shift M) : \<tau>"
    using shifted_F_type shifted_M_type by (rule has_type.App)
  have right_type:
      "?rho # \<Gamma> \<turnstile> App (Var 0) (shift M) : \<tau>"
    using var_type shifted_M_type by (rule has_type.App)
  have body_type:
      "?rho # \<Gamma> \<turnstile>
        Eq \<tau> (App (shift F) (shift M)) (App (Var 0) (shift M)) : Prop"
    using left_type right_type by (rule has_type.Eq)
  have P_type: "\<Gamma> \<turnstile> ?P : ?rho \<rightarrow>\<^sub>o Prop"
    using body_type by (rule has_type.Lam)
  have app_PF_type: "\<Gamma> \<turnstile> App ?P F : Prop"
    using P_type F_type by auto
  have app_PG_type: "\<Gamma> \<turnstile> App ?P G : Prop"
    using P_type G_type by auto
  have ref_A: "\<Gamma> \<turnstile>\<^sub>CEV Eq \<tau> ?A ?A"
    using A_type
    by (intro CEV_proves.CE CE_proves.C C_proves.H H_proves.Ref)
  have beta_F:
      "\<Gamma> \<turnstile>\<^sub>CEV
        (App ?P F \<longleftrightarrow>\<^sub>o Eq \<tau> ?A ?A)"
  proof -
    have target_type: "\<Gamma> \<turnstile> Eq \<tau> ?A ?A : Prop"
      using A_type by auto
    have step:
        "compatible_step beta_contract
          (App ?P F) (Eq \<tau> ?A ?A)"
    proof -
      have root:
          "compatible_step beta_contract
            (App ?P F)
            (subst0 F
              (Eq \<tau>
                (App (shift F) (shift M))
                (App (Var 0) (shift M))))"
        by (intro compatible_step.root beta_contract.beta)
      then show ?thesis
        by (simp add: subst0_def)
    qed
    show ?thesis
      using app_PF_type target_type step by (rule CEV_beta_step)
  qed
  have app_PF: "\<Gamma> \<turnstile>\<^sub>CEV App ?P F"
  proof -
    have bridge:
        "\<Gamma> \<turnstile>\<^sub>CEV Imp (Eq \<tau> ?A ?A) (App ?P F)"
      using app_PF_type CEV_proves_formula[OF ref_A] beta_F
      by (rule CEV_beta_right_imp)
    show ?thesis
      using ref_A bridge by (rule CEV_proves.MP)
  qed
  have ll:
      "\<Gamma> \<turnstile>\<^sub>CEV
        Imp (Eq ?rho F G) (Imp (App ?P F) (App ?P G))"
    using F_type G_type P_type
    by (intro CEV_proves.CE CE_proves.C C_proves.H H_proves.LL)
  have local_PG: "CEV_from \<Gamma> (Eq ?rho F G) (App ?P G)"
  proof -
    have eq_type: "\<Gamma> \<turnstile> Eq ?rho F G : Prop"
      using F_type G_type by auto
    have local_eq: "CEV_from \<Gamma> (Eq ?rho F G) (Eq ?rho F G)"
      by (intro CEV_from.Assumption eq_type)
    have local_ll:
        "CEV_from \<Gamma> (Eq ?rho F G)
          (Imp (Eq ?rho F G) (Imp (App ?P F) (App ?P G)))"
      by (intro CEV_from.Theorem ll)
    have local_imp:
        "CEV_from \<Gamma> (Eq ?rho F G) (Imp (App ?P F) (App ?P G))"
      using local_eq local_ll by (rule CEV_from.MP)
    have local_PF: "CEV_from \<Gamma> (Eq ?rho F G) (App ?P F)"
      by (intro CEV_from.Theorem app_PF)
    show ?thesis
      using local_PF local_imp by (rule CEV_from.MP)
  qed
  have beta_G:
      "\<Gamma> \<turnstile>\<^sub>CEV
        (App ?P G \<longleftrightarrow>\<^sub>o Eq \<tau> ?A ?B)"
  proof -
    have target_type: "\<Gamma> \<turnstile> Eq \<tau> ?A ?B : Prop"
      using A_type B_type by auto
    have step:
        "compatible_step beta_contract
          (App ?P G) (Eq \<tau> ?A ?B)"
    proof -
      have root:
          "compatible_step beta_contract
            (App ?P G)
            (subst0 G
              (Eq \<tau>
                (App (shift F) (shift M))
                (App (Var 0) (shift M))))"
        by (intro compatible_step.root beta_contract.beta)
      then show ?thesis
        by (simp add: subst0_def)
    qed
    show ?thesis
      using app_PG_type target_type step by (rule CEV_beta_step)
  qed
  have local_target:
      "CEV_from \<Gamma> (Eq ?rho F G) (Eq \<tau> ?A ?B)"
  proof -
    have bridge:
        "\<Gamma> \<turnstile>\<^sub>CEV Imp (App ?P G) (Eq \<tau> ?A ?B)"
      using app_PG_type A_type B_type beta_G
      by (auto intro: CEV_beta_left_imp)
    have local_bridge:
        "CEV_from \<Gamma> (Eq ?rho F G)
          (Imp (App ?P G) (Eq \<tau> ?A ?B))"
      by (intro CEV_from.Theorem bridge)
    show ?thesis
      using local_PG local_bridge by (rule CEV_from.MP)
  qed
  have eq_type: "\<Gamma> \<turnstile> Eq ?rho F G : Prop"
    using F_type G_type by auto
  show ?thesis
    using local_target eq_type by (rule CEV_from_deduction)
qed

lemma CEV_set_conj_intro:
  assumes dA: "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s A"
    and dB: "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s B"
  shows "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Conj A B"
proof -
  have A_type: "\<Gamma> \<turnstile> A : Prop"
    using dA by (rule CEV_set_derivable_formula)
  have B_type: "\<Gamma> \<turnstile> B : Prop"
    using dB by (rule CEV_set_derivable_formula)
  have taut: "prop_tautology \<Gamma> (Imp A (Imp B (Conj A B)))"
    using A_type B_type by (rule prop_tautology_conj_intro)
  have d_taut:
      "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Imp A (Imp B (Conj A B))"
    using CEV_prop_tautology[OF taut]
    by (rule CEV_set_derivable.Theorem)
  have second: "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Imp B (Conj A B)"
    using dA d_taut by (rule CEV_set_derivable.Derive_MP)
  show ?thesis
    using dB second by (rule CEV_set_derivable.Derive_MP)
qed

lemma CEV_set_eq_sym_from:
  assumes M_type: "\<Gamma> \<turnstile> M : \<sigma>"
    and N_type: "\<Gamma> \<turnstile> N : \<sigma>"
    and d_eq: "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Eq \<sigma> M N"
  shows "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Eq \<sigma> N M"
proof -
  have bridge:
      "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s
        Imp (Eq \<sigma> M N) (Eq \<sigma> N M)"
    using CEV_eq_sym[OF M_type N_type]
    by (rule CEV_set_derivable.Theorem)
  show ?thesis
    using d_eq bridge by (rule CEV_set_derivable.Derive_MP)
qed

lemma CEV_set_eq_trans_from:
  assumes M_type: "\<Gamma> \<turnstile> M : \<sigma>"
    and N_type: "\<Gamma> \<turnstile> N : \<sigma>"
    and P_type: "\<Gamma> \<turnstile> P : \<sigma>"
    and d_MN: "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Eq \<sigma> M N"
    and d_NP: "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Eq \<sigma> N P"
  shows "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Eq \<sigma> M P"
proof -
  have bridge:
      "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s
        Imp (Eq \<sigma> M N)
          (Imp (Eq \<sigma> N P) (Eq \<sigma> M P))"
    using CEV_eq_trans[OF M_type N_type P_type]
    by (rule CEV_set_derivable.Theorem)
  have second:
      "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s
        Imp (Eq \<sigma> N P) (Eq \<sigma> M P)"
    using d_MN bridge by (rule CEV_set_derivable.Derive_MP)
  show ?thesis
    using d_NP second by (rule CEV_set_derivable.Derive_MP)
qed

lemma CEV_set_eq_app_cong_from:
  assumes F_type: "\<Gamma> \<turnstile> F : \<sigma> \<rightarrow>\<^sub>o \<tau>"
    and G_type: "\<Gamma> \<turnstile> G : \<sigma> \<rightarrow>\<^sub>o \<tau>"
    and M_type: "\<Gamma> \<turnstile> M : \<sigma>"
    and d_eq:
      "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Eq (\<sigma> \<rightarrow>\<^sub>o \<tau>) F G"
  shows "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s
    Eq \<tau> (App F M) (App G M)"
proof -
  have bridge:
      "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s
        Imp
          (Eq (\<sigma> \<rightarrow>\<^sub>o \<tau>) F G)
          (Eq \<tau> (App F M) (App G M))"
    using CEV_eq_app_cong[OF F_type G_type M_type]
    by (rule CEV_set_derivable.Theorem)
  show ?thesis
    using d_eq bridge by (rule CEV_set_derivable.Derive_MP)
qed

lemma CEV_set_prop_tautology:
  assumes "prop_tautology \<Gamma> A"
  shows "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s A"
  using CEV_prop_tautology[OF assms]
  by (rule CEV_set_derivable.Theorem)

lemma CEV_set_modus_tollens:
  assumes dA: "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s A"
    and d_imp: "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Imp B (Neg A)"
  shows "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Neg B"
proof -
  have A_type: "\<Gamma> \<turnstile> A : Prop"
    using dA by (rule CEV_set_derivable_formula)
  have B_type: "\<Gamma> \<turnstile> B : Prop"
    using d_imp by (auto dest: CEV_set_derivable_formula elim: has_type.cases)
  have taut:
      "prop_tautology \<Gamma> (Imp A (Imp (Imp B (Neg A)) (Neg B)))"
    unfolding prop_tautology_def
    using A_type B_type by auto
  have d_taut:
      "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s
        Imp A (Imp (Imp B (Neg A)) (Neg B))"
    using taut by (rule CEV_set_prop_tautology)
  have second:
      "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Imp (Imp B (Neg A)) (Neg B)"
    using dA d_taut by (rule CEV_set_derivable.Derive_MP)
  show ?thesis
    using d_imp second by (rule CEV_set_derivable.Derive_MP)
qed

lemma CEV_set_modus_tollens_neg:
  assumes d_not_A: "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Neg A"
    and d_imp: "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Imp B A"
  shows "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Neg B"
proof -
  have A_type: "\<Gamma> \<turnstile> A : Prop"
    using d_not_A by (auto dest: CEV_set_derivable_formula elim: has_type.cases)
  have B_type: "\<Gamma> \<turnstile> B : Prop"
    using d_imp by (auto dest: CEV_set_derivable_formula elim: has_type.cases)
  have taut:
      "prop_tautology \<Gamma> (Imp (Neg A) (Imp (Imp B A) (Neg B)))"
    unfolding prop_tautology_def
    using A_type B_type by auto
  have d_taut:
      "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s
        Imp (Neg A) (Imp (Imp B A) (Neg B))"
    using taut by (rule CEV_set_prop_tautology)
  have second: "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s Imp (Imp B A) (Neg B)"
    using d_not_A d_taut by (rule CEV_set_derivable.Derive_MP)
  show ?thesis
    using d_imp second by (rule CEV_set_derivable.Derive_MP)
qed

lemma pp_full_QLN_derives_F_builder_pure:
  "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_pure
      (pp_F_builder_type \<rightarrow>\<^sub>o (Prop \<rightarrow>\<^sub>o Prop))
      pp_F_builder"
proof -
  have membership:
      "pp_pure
        (pp_F_builder_type \<rightarrow>\<^sub>o (Prop \<rightarrow>\<^sub>o Prop))
        pp_F_builder
      \<in> pp_full_QLN_axioms"
    using pp_F_builder_purity_in_schema
    by (simp add: pp_full_QLN_axioms_def pp_core_axioms_def)
  show ?thesis
    using membership
      pp_purity_schema_typed[OF pp_F_builder_purity_in_schema]
    by (rule CEV_set_derivable.Assumption)
qed

lemma pp_full_QLN_derives_target_PP:
  "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s pp_target_PP"
  using pp_target_PP_in_full_QLN typed_pp_target_PP
  by (rule CEV_set_derivable.Assumption)

definition pp_F_application_purity_instance :: oterm where
  "pp_F_application_purity_instance =
    Imp
      (Conj
        (pp_pure
          (pp_F_builder_type \<rightarrow>\<^sub>o (Prop \<rightarrow>\<^sub>o Prop))
          pp_F_builder)
        pp_target_PP)
      (pp_pure (Prop \<rightarrow>\<^sub>o Prop)
        (App pp_F_builder (pp_Pure (Prop \<rightarrow>\<^sub>o Prop))))"

lemma pp_full_QLN_derives_application_instance:
  "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_F_application_purity_instance"
proof -
  let ?T = "Prop \<rightarrow>\<^sub>o Prop"
  let ?S = "pp_F_builder_type"
  have closure_member:
      "pp_application_closure ?S ?T \<in> pp_full_QLN_axioms"
    unfolding pp_full_QLN_axioms_def pp_core_axioms_def
      pp_application_closure_schema_def
    by blast
  have closure:
      "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s
        pp_application_closure ?S ?T"
    using closure_member typed_pp_application_closure
    by (rule CEV_set_derivable.Assumption)
  have first_raw:
      "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s
        subst0 pp_F_builder
          (Forall ?S
            (Imp
              (Conj
                (pp_pure (?S \<rightarrow>\<^sub>o ?T) (Var 1))
                (pp_pure ?S (Var 0)))
              (pp_pure ?T (App (Var 1) (Var 0)))))"
    using closure typed_pp_F_builder
    unfolding pp_application_closure_def
    by (rule CEV_set_forall_elim)
  have first:
      "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s
        Forall ?S
          (Imp
            (Conj
              (pp_pure (?S \<rightarrow>\<^sub>o ?T) (rename Suc pp_F_builder))
              (pp_pure ?S (Var 0)))
            (pp_pure ?T (App (rename Suc pp_F_builder) (Var 0))))"
    using first_raw
    by (simp add: subst0_def pp_pure_def pp_Pure_def)
  have second_raw:
      "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s
        subst0 (pp_Pure ?T)
          (Imp
            (Conj
              (pp_pure (?S \<rightarrow>\<^sub>o ?T) (rename Suc pp_F_builder))
              (pp_pure ?S (Var 0)))
            (pp_pure ?T (App (rename Suc pp_F_builder) (Var 0))))"
    using first typed_pp_Pure
    unfolding pp_F_builder_type_def
    by (rule CEV_set_forall_elim)
  show ?thesis
    using second_raw
    by (simp add: pp_F_application_purity_instance_def
        subst0_def pp_target_PP_def pp_purity_of_pure_def
        pp_F_builder_type_def pp_F_builder_def pp_K_def
        pp_pure_def pp_Pure_def shift_def subst_lift_shift)
qed

lemma pp_full_QLN_derives_pure_F_application:
  "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_pure (Prop \<rightarrow>\<^sub>o Prop)
      (App pp_F_builder (pp_Pure (Prop \<rightarrow>\<^sub>o Prop)))"
proof -
  have conjunction:
      "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s
        Conj
          (pp_pure
            (pp_F_builder_type \<rightarrow>\<^sub>o (Prop \<rightarrow>\<^sub>o Prop))
            pp_F_builder)
          pp_target_PP"
    using pp_full_QLN_derives_F_builder_pure pp_full_QLN_derives_target_PP
    by (rule CEV_set_conj_intro)
  show ?thesis
    using conjunction pp_full_QLN_derives_application_instance
    unfolding pp_F_application_purity_instance_def
    by (rule CEV_set_derivable.Derive_MP)
qed

lemma CEV_pure_F_application_imp_pure_F:
  "[] \<turnstile>\<^sub>CEV
    Imp
      (pp_pure (Prop \<rightarrow>\<^sub>o Prop)
        (App pp_F_builder (pp_Pure (Prop \<rightarrow>\<^sub>o Prop))))
      (pp_pure (Prop \<rightarrow>\<^sub>o Prop) pp_F)"
proof -
  let ?T = "Prop \<rightarrow>\<^sub>o Prop"
  let ?A = "pp_pure ?T (App pp_F_builder (pp_Pure ?T))"
  let ?B = "pp_pure ?T pp_F"
  have A_type: "[] \<turnstile> ?A : Prop"
    using typed_pp_F_builder typed_pp_Pure
    unfolding pp_F_builder_type_def
    by (intro typed_pp_pure has_type.App)
  have B_type: "[] \<turnstile> ?B : Prop"
    using typed_pp_F by (rule typed_pp_pure)
  have inner_step:
      "compatible_step beta_contract
        (App pp_F_builder (pp_Pure ?T))
        pp_F"
  proof -
    have root:
        "compatible_step beta_contract
          (App pp_F_builder (pp_Pure ?T))
          (subst0 (pp_Pure ?T)
            (Lam Prop
              (Neg
                (App (Var 1) (pp_K (Var 0))))))"
      unfolding pp_F_builder_def
      by (intro compatible_step.root beta_contract.beta)
    then show ?thesis
      by (simp add: pp_F_def pp_K_def pp_pure_def subst0_def
          pp_Pure_def subst_lift_shift)
  qed
  have outer_step: "compatible_step beta_contract ?A ?B"
    unfolding pp_pure_def
    using inner_step by (rule compatible_step.App_right)
  have equivalence: "[] \<turnstile>\<^sub>CEV (?A \<longleftrightarrow>\<^sub>o ?B)"
    using A_type B_type outer_step by (rule CEV_beta_step)
  show ?thesis
    using A_type B_type equivalence by (rule CEV_beta_left_imp)
qed

theorem pp_full_QLN_derives_pure_F:
  "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_pure (Prop \<rightarrow>\<^sub>o Prop) pp_F"
proof -
  have local_bridge:
      "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s
        Imp
          (pp_pure (Prop \<rightarrow>\<^sub>o Prop)
            (App pp_F_builder (pp_Pure (Prop \<rightarrow>\<^sub>o Prop))))
          (pp_pure (Prop \<rightarrow>\<^sub>o Prop) pp_F)"
    using CEV_pure_F_application_imp_pure_F
    by (rule CEV_set_derivable.Theorem)
  show ?thesis
    using pp_full_QLN_derives_pure_F_application local_bridge
    by (rule CEV_set_derivable.Derive_MP)
qed

lemma pp_full_QLN_derives_pure_K_true:
  "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K ObjTrue)"
proof -
  have membership:
      "pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K ObjTrue)
        \<in> pp_full_QLN_axioms"
    using pp_pure_K_ObjTrue_in_schema
    by (simp add: pp_full_QLN_axioms_def pp_core_axioms_def)
  show ?thesis
    using membership
      pp_purity_schema_typed[OF pp_pure_K_ObjTrue_in_schema]
    by (rule CEV_set_derivable.Assumption)
qed

