lemma pp_named_r_derives_not_box_F:
  "[] ; pp_full_QLN_named_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    Neg (\<box>\<^sub>o (App pp_F pp_r))"
proof -
  have pure_and_fun:
      "[] ; pp_full_QLN_named_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        Conj
          (pp_pure (Prop \<rightarrow>\<^sub>o Prop) pp_F)
          (pp_fun Prop pp_r)"
    using pp_named_r_derives_pure_F pp_named_r_derives_fun_r
    by (rule CEV_set_conj_intro)
  have box_imp_universal:
      "[] ; pp_full_QLN_named_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        Imp (\<box>\<^sub>o (App pp_F pp_r)) pp_F_universal"
    using pure_and_fun pp_named_r_derives_F_recombination_instance
    unfolding pp_F_r_recombination_instance_def
    by (rule CEV_set_derivable.Derive_MP)
  show ?thesis
    using pp_named_r_derives_not_F_universal box_imp_universal
    by (rule CEV_set_modus_tollens_neg)
qed

theorem pp_named_r_derives_F_r:
  "[] ; pp_full_QLN_named_r_axioms \<turnstile>\<^sub>CEV\<^sub>s App pp_F pp_r"
  using pp_unary_recombination_r_derives_F_r
    pp_unary_recombination_r_subset_named_r
  by (rule CEV_set_derivable_mono)

