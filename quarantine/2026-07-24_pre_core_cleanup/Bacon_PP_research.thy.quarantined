lemma pp_full_QLN_derives_pure_prop_id:
  "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_pure (Prop \<rightarrow>\<^sub>o Prop) prop_id"
proof -
  have membership:
      "pp_pure (Prop \<rightarrow>\<^sub>o Prop) prop_id
        \<in> pp_full_QLN_axioms"
    using pp_pure_prop_id_in_schema
    by (simp add: pp_full_QLN_axioms_def pp_core_axioms_def)
