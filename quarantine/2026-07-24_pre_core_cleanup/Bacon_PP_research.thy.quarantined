  "pp_logical_vocabulary prop_id"
  by (simp add: pp_logical_vocabulary_def prop_id_def)

lemma pp_pure_prop_id_in_schema:
  "pp_pure (Prop \<rightarrow>\<^sub>o Prop) prop_id \<in> pp_purity_schema"
  unfolding pp_purity_schema_def
  using typed_prop_id pp_prop_id_has_pure_vocabulary
