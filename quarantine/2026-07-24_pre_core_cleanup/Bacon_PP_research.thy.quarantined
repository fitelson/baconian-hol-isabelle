  by (simp add: pp_logical_vocabulary_def pp_singleton_fun_role_def
      ObjTrue_def shift_def)

lemma pp_pure_singleton_true_role_in_schema:
  "pp_pure (Prop \<rightarrow>\<^sub>o Prop)
      (pp_singleton_fun_role ObjTrue) \<in> pp_purity_schema"
  unfolding pp_purity_schema_def
  using typed_pp_singleton_fun_role[OF typed_ObjTrue, of "[]"]
    pp_singleton_true_role_has_pure_vocabulary
