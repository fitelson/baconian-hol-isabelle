theory Bacon_PP
  imports Bacon_Canonical
begin

section \<open>Purity of Pure and the single-fundamental conjecture\<close>

text \<open>
  This theory adds the object-language vocabulary needed for the Purity of Pure
  consistency question.  The same constant name may be used at different
  object-language types because an object constant is the pair of its name and
  its type.  Logical operations remain constructors of \<open>oterm\<close>; the expanded
  pure vocabulary therefore contains just the type-indexed \<open>Pure\<close> constants.
  The primitive \<open>Fun\<close> constants are deliberately not part of that vocabulary.
\<close>

definition pp_pure_name :: string where
  "pp_pure_name = ''Pure''"

definition pp_fun_name :: string where
  "pp_fun_name = ''Fun''"

definition pp_r_name :: string where
  "pp_r_name = ''r''"

definition pp_r :: oterm where
  "pp_r = Const pp_r_name Prop"

definition pp_Pure :: "otype \<Rightarrow> oterm" where
  "pp_Pure \<sigma> = Const pp_pure_name (\<sigma> \<rightarrow>\<^sub>o Prop)"

definition pp_Fun :: "otype \<Rightarrow> oterm" where
  "pp_Fun \<sigma> = Const pp_fun_name (\<sigma> \<rightarrow>\<^sub>o Prop)"

definition pp_pure :: "otype \<Rightarrow> oterm \<Rightarrow> oterm" where
  "pp_pure \<sigma> M = App (pp_Pure \<sigma>) M"

definition pp_fun :: "otype \<Rightarrow> oterm \<Rightarrow> oterm" where
  "pp_fun \<sigma> M = App (pp_Fun \<sigma>) M"

lemma typed_pp_Pure:
  "\<Gamma> \<turnstile> pp_Pure \<sigma> : \<sigma> \<rightarrow>\<^sub>o Prop"
  unfolding pp_Pure_def
  by (rule has_type.Const)

lemma typed_pp_Fun:
  "\<Gamma> \<turnstile> pp_Fun \<sigma> : \<sigma> \<rightarrow>\<^sub>o Prop"
  unfolding pp_Fun_def
  by (rule has_type.Const)

lemma typed_pp_r:
  "\<Gamma> \<turnstile> pp_r : Prop"
  unfolding pp_r_def
  by (rule has_type.Const)

lemma typed_pp_pure:
  assumes "\<Gamma> \<turnstile> M : \<sigma>"
  shows "\<Gamma> \<turnstile> pp_pure \<sigma> M : Prop"
  unfolding pp_pure_def
  using typed_pp_Pure assms
  by (rule has_type.App)

lemma typed_pp_fun:
  assumes "\<Gamma> \<turnstile> M : \<sigma>"
  shows "\<Gamma> \<turnstile> pp_fun \<sigma> M : Prop"
  unfolding pp_fun_def
  using typed_pp_Fun assms
  by (rule has_type.App)

subsection \<open>Named principles\<close>

definition pp_purity_of_pure :: "otype \<Rightarrow> oterm" where
  "pp_purity_of_pure \<sigma> = pp_pure (\<sigma> \<rightarrow>\<^sub>o Prop) (pp_Pure \<sigma>)"

definition pp_purity_of_fun :: "otype \<Rightarrow> oterm" where
  "pp_purity_of_fun \<sigma> = pp_pure (\<sigma> \<rightarrow>\<^sub>o Prop) (pp_Fun \<sigma>)"

definition pp_application_closure :: "otype \<Rightarrow> otype \<Rightarrow> oterm" where
  "pp_application_closure \<sigma> \<tau> =
    Forall (\<sigma> \<rightarrow>\<^sub>o \<tau>)
      (Forall \<sigma>
        (Imp
          (Conj
            (pp_pure (\<sigma> \<rightarrow>\<^sub>o \<tau>) (Var 1))
            (pp_pure \<sigma> (Var 0)))
          (pp_pure \<tau> (App (Var 1) (Var 0)))))"

definition pp_persistence :: "otype \<Rightarrow> oterm" where
  "pp_persistence \<sigma> =
    Forall \<sigma>
      (Imp (pp_pure \<sigma> (Var 0)) (\<box>\<^sub>o (pp_pure \<sigma> (Var 0))))"

definition pp_unique_fundamental :: "otype \<Rightarrow> oterm" where
  "pp_unique_fundamental \<sigma> =
    Exists \<sigma>
      (Conj
        (pp_fun \<sigma> (Var 0))
        (Forall \<sigma>
          (Imp (pp_fun \<sigma> (Var 0)) (Eq \<sigma> (Var 0) (Var 1)))))"

definition pp_no_fundamentals :: "otype \<Rightarrow> oterm" where
  "pp_no_fundamentals \<sigma> =
    Forall \<sigma> (Neg (pp_fun \<sigma> (Var 0)))"

text \<open>
  With exactly one fundamental proposition, the only nonzero arity instance of
  QLN needed below is the unary propositional instance.  The zero-ary instance
  is recorded separately because its Exhaustion direction is the boxing step
  used in Bacon's printed QSS argument.
\<close>

definition pp_zeroary_recombination :: oterm where
  "pp_zeroary_recombination =
    Forall Prop
      (Imp (pp_pure Prop (Var 0))
        (Imp (\<box>\<^sub>o (Var 0)) (Var 0)))"

definition pp_zeroary_exhaustion :: oterm where
  "pp_zeroary_exhaustion =
    Forall Prop
      (Imp (pp_pure Prop (Var 0))
        (Imp (Var 0) (\<box>\<^sub>o (Var 0))))"

definition pp_zeroary_QLN :: oterm where
  "pp_zeroary_QLN =
    Forall Prop
      (Imp (pp_pure Prop (Var 0))
        ((\<box>\<^sub>o (Var 0)) \<longleftrightarrow>\<^sub>o Var 0))"

definition pp_unary_recombination :: oterm where
  "pp_unary_recombination =
    Forall (Prop \<rightarrow>\<^sub>o Prop)
      (Forall Prop
        (Imp
          (Conj
            (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (Var 1))
            (pp_fun Prop (Var 0)))
          (Imp
            (\<box>\<^sub>o (App (Var 1) (Var 0)))
            (Forall Prop (App (Var 2) (Var 0))))))"

definition pp_unary_exhaustion :: oterm where
  "pp_unary_exhaustion =
    Forall (Prop \<rightarrow>\<^sub>o Prop)
      (Forall Prop
        (Imp
          (Conj
            (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (Var 1))
            (pp_fun Prop (Var 0)))
          (Imp
            (Forall Prop (App (Var 2) (Var 0)))
            (\<box>\<^sub>o (App (Var 1) (Var 0))))))"

definition pp_unary_QLN :: oterm where
  "pp_unary_QLN =
    Forall (Prop \<rightarrow>\<^sub>o Prop)
      (Forall Prop
        (Imp
          (Conj
            (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (Var 1))
            (pp_fun Prop (Var 0)))
          ((\<box>\<^sub>o (App (Var 1) (Var 0))) \<longleftrightarrow>\<^sub>o
            Forall Prop (App (Var 2) (Var 0)))))"

definition pp_QSS :: oterm where
  "pp_QSS =
    Forall (Prop \<rightarrow>\<^sub>o Prop)
      (Forall (Prop \<rightarrow>\<^sub>o Prop)
        (Forall Prop
          (Imp
            (Conj
              (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (Var 2))
              (Conj
                (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (Var 1))
                (pp_fun Prop (Var 0))))
            (Imp
              (Eq Prop (App (Var 2) (Var 0)) (App (Var 1) (Var 0)))
              (Eq (Prop \<rightarrow>\<^sub>o Prop) (Var 2) (Var 1))))))"

definition pp_QSS_instance :: "oterm \<Rightarrow> oterm \<Rightarrow> oterm \<Rightarrow> oterm" where
  "pp_QSS_instance X Y R =
    Imp
      (Conj
        (pp_pure (Prop \<rightarrow>\<^sub>o Prop) X)
        (Conj
          (pp_pure (Prop \<rightarrow>\<^sub>o Prop) Y)
          (pp_fun Prop R)))
      (Imp
        (Eq Prop (App X R) (App Y R))
        (Eq (Prop \<rightarrow>\<^sub>o Prop) X Y))"

definition pp_unary_recombination_instance ::
    "oterm \<Rightarrow> oterm \<Rightarrow> oterm" where
  "pp_unary_recombination_instance X R =
    Imp
      (Conj
        (pp_pure (Prop \<rightarrow>\<^sub>o Prop) X)
        (pp_fun Prop R))
      (Imp
        (\<box>\<^sub>o (App X R))
        (Forall Prop (App X (Var 0))))"

lemma typed_pp_purity_of_pure:
  "[] \<turnstile> pp_purity_of_pure \<sigma> : Prop"
  unfolding pp_purity_of_pure_def
  using typed_pp_Pure
  by (rule typed_pp_pure)

lemma typed_pp_purity_of_fun:
  "[] \<turnstile> pp_purity_of_fun \<sigma> : Prop"
  unfolding pp_purity_of_fun_def
  using typed_pp_Fun
  by (rule typed_pp_pure)

lemma typed_pp_application_closure:
  "[] \<turnstile> pp_application_closure \<sigma> \<tau> : Prop"
  by (rule infer_type_sound)
    (simp add: pp_application_closure_def pp_pure_def pp_Pure_def lookup_def)

lemma typed_pp_persistence:
  "[] \<turnstile> pp_persistence \<sigma> : Prop"
  by (rule infer_type_sound)
    (simp add: pp_persistence_def pp_pure_def pp_Pure_def
      ObjBox_def ObjTrue_def lookup_def)

lemma typed_pp_unique_fundamental:
  "[] \<turnstile> pp_unique_fundamental \<sigma> : Prop"
  by (rule infer_type_sound)
    (simp add: pp_unique_fundamental_def pp_fun_def pp_Fun_def lookup_def)

lemma typed_pp_no_fundamentals:
  "[] \<turnstile> pp_no_fundamentals \<sigma> : Prop"
  by (rule infer_type_sound)
    (simp add: pp_no_fundamentals_def pp_fun_def pp_Fun_def lookup_def)

lemma typed_pp_zeroary_recombination:
  "[] \<turnstile> pp_zeroary_recombination : Prop"
  by (rule infer_type_sound)
    (simp add: pp_zeroary_recombination_def pp_pure_def pp_Pure_def
      ObjBox_def ObjTrue_def lookup_def)

lemma typed_pp_zeroary_exhaustion:
  "[] \<turnstile> pp_zeroary_exhaustion : Prop"
  by (rule infer_type_sound)
    (simp add: pp_zeroary_exhaustion_def pp_pure_def pp_Pure_def
      ObjBox_def ObjTrue_def lookup_def)

lemma typed_pp_zeroary_QLN:
  "[] \<turnstile> pp_zeroary_QLN : Prop"
  by (rule infer_type_sound)
    (simp add: pp_zeroary_QLN_def pp_pure_def pp_Pure_def
      ObjBox_def ObjTrue_def lookup_def)

lemma typed_pp_unary_recombination:
  "[] \<turnstile> pp_unary_recombination : Prop"
  by (rule infer_type_sound)
    (simp add: pp_unary_recombination_def pp_pure_def pp_Pure_def
      pp_fun_def pp_Fun_def ObjBox_def ObjTrue_def lookup_def)

lemma typed_pp_unary_exhaustion:
  "[] \<turnstile> pp_unary_exhaustion : Prop"
  by (rule infer_type_sound)
    (simp add: pp_unary_exhaustion_def pp_pure_def pp_Pure_def
      pp_fun_def pp_Fun_def ObjBox_def ObjTrue_def lookup_def)

lemma typed_pp_unary_QLN:
  "[] \<turnstile> pp_unary_QLN : Prop"
  by (rule infer_type_sound)
    (simp add: pp_unary_QLN_def pp_pure_def pp_Pure_def
      pp_fun_def pp_Fun_def ObjBox_def ObjTrue_def lookup_def)

lemma typed_pp_QSS:
  "[] \<turnstile> pp_QSS : Prop"
  by (rule infer_type_sound)
    (simp add: pp_QSS_def pp_pure_def pp_Pure_def
      pp_fun_def pp_Fun_def lookup_def)

lemma typed_pp_unary_recombination_instance:
  assumes X_type: "[] \<turnstile> X : Prop \<rightarrow>\<^sub>o Prop"
    and R_type: "[] \<turnstile> R : Prop"
    and X_closed: "rename Suc X = X"
  shows "[] \<turnstile> pp_unary_recombination_instance X R : Prop"
proof -
  have X_ext: "[Prop] \<turnstile> X : Prop \<rightarrow>\<^sub>o Prop"
    using weakening_front[OF X_type, of Prop] X_closed
    unfolding shift_def by simp
  have app_type: "[] \<turnstile> App X R : Prop"
    using X_type R_type by (rule has_type.App)
  have box_type: "[] \<turnstile> \<box>\<^sub>o (App X R) : Prop"
    using app_type by (rule typed_ObjBox)
  have var_type: "[Prop] \<turnstile> Var 0 : Prop"
    by auto
  have body_type: "[Prop] \<turnstile> App X (Var 0) : Prop"
    using X_ext var_type by (rule has_type.App)
  have forall_type: "[] \<turnstile> Forall Prop (App X (Var 0)) : Prop"
    using body_type by (rule has_type.Forall)
  show ?thesis
    unfolding pp_unary_recombination_instance_def
    using typed_pp_pure[OF X_type] typed_pp_fun[OF R_type]
      box_type forall_type
    by auto
qed

lemma typed_pp_QSS_instance:
  assumes "[] \<turnstile> X : Prop \<rightarrow>\<^sub>o Prop"
    and "[] \<turnstile> Y : Prop \<rightarrow>\<^sub>o Prop"
    and "[] \<turnstile> R : Prop"
  shows "[] \<turnstile> pp_QSS_instance X Y R : Prop"
proof -
  have pure_X: "[] \<turnstile> pp_pure (Prop \<rightarrow>\<^sub>o Prop) X : Prop"
    using assms(1) by (rule typed_pp_pure)
  have pure_Y: "[] \<turnstile> pp_pure (Prop \<rightarrow>\<^sub>o Prop) Y : Prop"
    using assms(2) by (rule typed_pp_pure)
  have fun_R: "[] \<turnstile> pp_fun Prop R : Prop"
    using assms(3) by (rule typed_pp_fun)
  show ?thesis
    unfolding pp_QSS_instance_def
    using assms pure_X pure_Y fun_R by auto
qed

subsection \<open>Axiom sets and the consistency question\<close>

definition pp_logical_vocabulary :: "oterm \<Rightarrow> bool" where
  "pp_logical_vocabulary M \<longleftrightarrow> consts_of M = {}"

definition pp_expanded_pure_vocabulary :: "oterm \<Rightarrow> bool" where
  "pp_expanded_pure_vocabulary M \<longleftrightarrow>
    consts_of M \<subseteq> {pp_pure_name}"

subsection \<open>Intensional invariance of pure representatives\<close>

text \<open>
  A term typable in the empty context is closed.  If, in addition, all of its
  object constants are instances of \<open>Pure\<close>, it is an \<open>r\<close>-free closed term
  of the expanded pure vocabulary.

  The following definitions separate two questions that can otherwise be
  conflated in the syntactic-action construction.  Once substitution
  intensions have been assigned, equality of those intensions is an
  equivalence relation, and the property of having an \<open>r\<close>-free representative
  is invariant under it.  This elementary quotient fact does not itself
  construct an assignment of intensions when the interpretation of \<open>Pure\<close>
  is defined simultaneously from the resulting equality classes.
\<close>

definition pp_r_free_closed_pure_term :: "oterm \<Rightarrow> bool" where
  "pp_r_free_closed_pure_term M \<longleftrightarrow>
    (\<exists>\<sigma>. [] \<turnstile> M : \<sigma>) \<and> pp_expanded_pure_vocabulary M"

definition pp_same_substitution_intension ::
    "('w \<Rightarrow> oterm \<Rightarrow> 'v) \<Rightarrow> oterm \<Rightarrow> oterm \<Rightarrow> bool" where
  "pp_same_substitution_intension view A B \<longleftrightarrow>
    (\<forall>w. view w A = view w B)"

definition pp_has_r_free_pure_representative ::
    "('w \<Rightarrow> oterm \<Rightarrow> 'v) \<Rightarrow> oterm \<Rightarrow> bool" where
  "pp_has_r_free_pure_representative view A \<longleftrightarrow>
    (\<exists>N. pp_r_free_closed_pure_term N \<and>
      pp_same_substitution_intension view A N)"

lemma pp_same_substitution_intension_refl:
  "pp_same_substitution_intension view A A"
  by (simp add: pp_same_substitution_intension_def)

lemma pp_same_substitution_intension_sym:
  assumes "pp_same_substitution_intension view A B"
  shows "pp_same_substitution_intension view B A"
  using assms by (simp add: pp_same_substitution_intension_def)

lemma pp_same_substitution_intension_trans:
  assumes "pp_same_substitution_intension view A B"
    and "pp_same_substitution_intension view B C"
  shows "pp_same_substitution_intension view A C"
  using assms by (auto simp: pp_same_substitution_intension_def)

theorem pp_r_free_representative_invariant_under_intensional_identity:
  assumes "pp_same_substitution_intension view A B"
  shows
    "pp_has_r_free_pure_representative view A \<longleftrightarrow>
      pp_has_r_free_pure_representative view B"
proof
  assume "pp_has_r_free_pure_representative view A"
  then obtain N where
      pure_N: "pp_r_free_closed_pure_term N"
    and A_N: "pp_same_substitution_intension view A N"
    unfolding pp_has_r_free_pure_representative_def by blast
  have B_A: "pp_same_substitution_intension view B A"
    using assms by (rule pp_same_substitution_intension_sym)
  have B_N: "pp_same_substitution_intension view B N"
    using B_A A_N by (rule pp_same_substitution_intension_trans)
  show "pp_has_r_free_pure_representative view B"
    unfolding pp_has_r_free_pure_representative_def
    using pure_N B_N by blast
next
  assume "pp_has_r_free_pure_representative view B"
  then obtain N where
      pure_N: "pp_r_free_closed_pure_term N"
    and B_N: "pp_same_substitution_intension view B N"
    unfolding pp_has_r_free_pure_representative_def by blast
  have A_N: "pp_same_substitution_intension view A N"
    using assms B_N by (rule pp_same_substitution_intension_trans)
  show "pp_has_r_free_pure_representative view A"
    unfolding pp_has_r_free_pure_representative_def
    using pure_N A_N by blast
qed

definition pp_substitution_intension_class ::
    "('w \<Rightarrow> oterm \<Rightarrow> 'v) \<Rightarrow> oterm \<Rightarrow> oterm set" where
  "pp_substitution_intension_class view A =
    {B. pp_same_substitution_intension view A B}"

definition pp_substitution_intension_quotient ::
    "('w \<Rightarrow> oterm \<Rightarrow> 'v) \<Rightarrow> oterm set set" where
  "pp_substitution_intension_quotient view =
    range (pp_substitution_intension_class view)"

definition pp_quotient_Pure ::
    "('w \<Rightarrow> oterm \<Rightarrow> 'v) \<Rightarrow> oterm set \<Rightarrow> bool" where
  "pp_quotient_Pure view Q \<longleftrightarrow>
    (\<exists>A. Q = pp_substitution_intension_class view A \<and>
      pp_has_r_free_pure_representative view A)"

lemma pp_term_in_own_substitution_intension_class:
  "A \<in> pp_substitution_intension_class view A"
  by (simp add: pp_substitution_intension_class_def
      pp_same_substitution_intension_refl)

lemma pp_equal_substitution_intension_classes_imply_same_intension:
  assumes
    "pp_substitution_intension_class view A =
      pp_substitution_intension_class view B"
  shows "pp_same_substitution_intension view A B"
proof -
  have "B \<in> pp_substitution_intension_class view B"
    by (rule pp_term_in_own_substitution_intension_class)
  then have "B \<in> pp_substitution_intension_class view A"
    using assms by simp
  then show ?thesis
    unfolding pp_substitution_intension_class_def by simp
qed

theorem pp_quotient_Pure_class_iff:
  "pp_quotient_Pure view (pp_substitution_intension_class view A)
    \<longleftrightarrow> pp_has_r_free_pure_representative view A"
proof
  assume
    "pp_quotient_Pure view (pp_substitution_intension_class view A)"
  then obtain B where classes:
      "pp_substitution_intension_class view A =
        pp_substitution_intension_class view B"
    and pure_B: "pp_has_r_free_pure_representative view B"
    unfolding pp_quotient_Pure_def by blast
  have same: "pp_same_substitution_intension view A B"
    using classes
    by (rule pp_equal_substitution_intension_classes_imply_same_intension)
  show "pp_has_r_free_pure_representative view A"
    using pp_r_free_representative_invariant_under_intensional_identity[OF same]
      pure_B by blast
next
  assume pure_A: "pp_has_r_free_pure_representative view A"
  show
    "pp_quotient_Pure view (pp_substitution_intension_class view A)"
    unfolding pp_quotient_Pure_def using pure_A by blast
qed

theorem pp_intensional_quotient_and_Pure_exist:
  "\<exists>Q PureQ.
    Q = pp_substitution_intension_quotient view \<and>
    PureQ = pp_quotient_Pure view \<and>
    (\<forall>A. PureQ (pp_substitution_intension_class view A)
      \<longleftrightarrow> pp_has_r_free_pure_representative view A)"
  using pp_quotient_Pure_class_iff by blast

definition pp_has_r_free_representative_modulo ::
    "(oterm \<Rightarrow> oterm \<Rightarrow> bool) \<Rightarrow> oterm \<Rightarrow> bool" where
  "pp_has_r_free_representative_modulo E A \<longleftrightarrow>
    (\<exists>N. pp_r_free_closed_pure_term N \<and> E A N)"

definition pp_intensional_reflection ::
    "(oterm \<Rightarrow> oterm \<Rightarrow> bool) \<Rightarrow>
      ('w \<Rightarrow> oterm \<Rightarrow> 'v) \<Rightarrow> bool" where
  "pp_intensional_reflection E view \<longleftrightarrow>
    (\<forall>A N. pp_r_free_closed_pure_term N \<longrightarrow>
      pp_same_substitution_intension view A N \<longrightarrow>
      pp_has_r_free_representative_modulo E A)"

theorem pp_semantic_and_proof_purity_coincide:
  assumes sound:
      "\<And>A B. E A B \<Longrightarrow>
        pp_same_substitution_intension view A B"
    and reflection: "pp_intensional_reflection E view"
  shows
    "pp_has_r_free_pure_representative view A \<longleftrightarrow>
      pp_has_r_free_representative_modulo E A"
proof
  assume semantic:
      "pp_has_r_free_pure_representative view A"
  then obtain N where
      pure_N: "pp_r_free_closed_pure_term N"
    and same: "pp_same_substitution_intension view A N"
    unfolding pp_has_r_free_pure_representative_def by blast
  show "pp_has_r_free_representative_modulo E A"
    using reflection pure_N same
    unfolding pp_intensional_reflection_def by blast
next
  assume proof_pure:
      "pp_has_r_free_representative_modulo E A"
  then obtain N where
      pure_N: "pp_r_free_closed_pure_term N"
    and E_A_N: "E A N"
    unfolding pp_has_r_free_representative_modulo_def by blast
  have same: "pp_same_substitution_intension view A N"
    using E_A_N by (rule sound)
  show "pp_has_r_free_pure_representative view A"
    unfolding pp_has_r_free_pure_representative_def
    using pure_N same by blast
qed

theorem pp_intensional_reflection_iff_no_cross_boundary_collision:
  "pp_intensional_reflection E view \<longleftrightarrow>
    (\<forall>A. pp_has_r_free_pure_representative view A \<longrightarrow>
      pp_has_r_free_representative_modulo E A)"
proof
  assume reflection: "pp_intensional_reflection E view"
  show
    "\<forall>A. pp_has_r_free_pure_representative view A \<longrightarrow>
      pp_has_r_free_representative_modulo E A"
  proof (intro allI impI)
    fix A
    assume "pp_has_r_free_pure_representative view A"
    then obtain N where
        pure_N: "pp_r_free_closed_pure_term N"
      and same: "pp_same_substitution_intension view A N"
      unfolding pp_has_r_free_pure_representative_def by blast
    show "pp_has_r_free_representative_modulo E A"
      using reflection pure_N same
      unfolding pp_intensional_reflection_def by blast
  qed
next
  assume boundary:
      "\<forall>A. pp_has_r_free_pure_representative view A \<longrightarrow>
        pp_has_r_free_representative_modulo E A"
  show "pp_intensional_reflection E view"
    unfolding pp_intensional_reflection_def
  proof (intro allI impI)
    fix A N
    assume pure_N: "pp_r_free_closed_pure_term N"
      and same: "pp_same_substitution_intension view A N"
    have "pp_has_r_free_pure_representative view A"
      unfolding pp_has_r_free_pure_representative_def
      using pure_N same by blast
    then show "pp_has_r_free_representative_modulo E A"
      using boundary by blast
  qed
qed

subsection \<open>Typed reflection and the universal Henkin view\<close>

definition pp_r_free_closed_pure_term_at ::
    "otype \<Rightarrow> oterm \<Rightarrow> bool" where
  "pp_r_free_closed_pure_term_at \<sigma> M \<longleftrightarrow>
    [] \<turnstile> M : \<sigma> \<and> pp_expanded_pure_vocabulary M"

definition pp_has_r_free_pure_representative_at ::
    "otype \<Rightarrow> ('w \<Rightarrow> oterm \<Rightarrow> 'v) \<Rightarrow> oterm \<Rightarrow> bool" where
  "pp_has_r_free_pure_representative_at \<sigma> view A \<longleftrightarrow>
    [] \<turnstile> A : \<sigma> \<and>
    (\<exists>N. pp_r_free_closed_pure_term_at \<sigma> N \<and>
      pp_same_substitution_intension view A N)"

definition pp_has_r_free_representative_modulo_at ::
    "otype \<Rightarrow> (oterm \<Rightarrow> oterm \<Rightarrow> bool) \<Rightarrow>
      oterm \<Rightarrow> bool" where
  "pp_has_r_free_representative_modulo_at \<sigma> E A \<longleftrightarrow>
    [] \<turnstile> A : \<sigma> \<and>
    (\<exists>N. pp_r_free_closed_pure_term_at \<sigma> N \<and> E A N)"

definition pp_intensional_reflection_at ::
    "otype \<Rightarrow> (oterm \<Rightarrow> oterm \<Rightarrow> bool) \<Rightarrow>
      ('w \<Rightarrow> oterm \<Rightarrow> 'v) \<Rightarrow> bool" where
  "pp_intensional_reflection_at \<sigma> E view \<longleftrightarrow>
    (\<forall>A N.
      [] \<turnstile> A : \<sigma> \<longrightarrow>
      pp_r_free_closed_pure_term_at \<sigma> N \<longrightarrow>
      pp_same_substitution_intension view A N \<longrightarrow>
      pp_has_r_free_representative_modulo_at \<sigma> E A)"

theorem pp_typed_semantic_and_proof_purity_coincide:
  assumes sound:
      "\<And>A B. [] \<turnstile> A : \<sigma> \<Longrightarrow> [] \<turnstile> B : \<sigma> \<Longrightarrow>
        E A B \<Longrightarrow> pp_same_substitution_intension view A B"
    and reflection: "pp_intensional_reflection_at \<sigma> E view"
  shows
    "pp_has_r_free_pure_representative_at \<sigma> view A \<longleftrightarrow>
      pp_has_r_free_representative_modulo_at \<sigma> E A"
proof
  assume semantic:
      "pp_has_r_free_pure_representative_at \<sigma> view A"
  then obtain N where
      A_type: "[] \<turnstile> A : \<sigma>"
    and pure_N: "pp_r_free_closed_pure_term_at \<sigma> N"
    and same: "pp_same_substitution_intension view A N"
    unfolding pp_has_r_free_pure_representative_at_def by blast
  show "pp_has_r_free_representative_modulo_at \<sigma> E A"
    using reflection A_type pure_N same
    unfolding pp_intensional_reflection_at_def by blast
next
  assume proof_pure:
      "pp_has_r_free_representative_modulo_at \<sigma> E A"
  then obtain N where
      A_type: "[] \<turnstile> A : \<sigma>"
    and pure_N: "pp_r_free_closed_pure_term_at \<sigma> N"
    and E_A_N: "E A N"
    unfolding pp_has_r_free_representative_modulo_at_def by blast
  have N_type: "[] \<turnstile> N : \<sigma>"
    using pure_N unfolding pp_r_free_closed_pure_term_at_def by blast
  have same: "pp_same_substitution_intension view A N"
    using A_type N_type E_A_N by (rule sound)
  show "pp_has_r_free_pure_representative_at \<sigma> view A"
    unfolding pp_has_r_free_pure_representative_at_def
    using A_type pure_N same by blast
qed

definition pp_C_universal_Henkin_view ::
    "oterm set \<Rightarrow> oterm \<Rightarrow> bool" where
  "pp_C_universal_Henkin_view T A \<longleftrightarrow>
    C_Henkin_theory [] T \<and> A \<in> T"

theorem pp_C_universal_Henkin_same_intension_iff:
  assumes A_type: "[] \<turnstile> A : Prop"
    and B_type: "[] \<turnstile> B : Prop"
  shows
    "pp_same_substitution_intension pp_C_universal_Henkin_view A B
      \<longleftrightarrow> [] \<turnstile>\<^sub>C (A \<longleftrightarrow>\<^sub>o B)"
proof
  assume same:
      "pp_same_substitution_intension pp_C_universal_Henkin_view A B"
  have valid: "C_Henkin_valid_in_context [] (A \<longleftrightarrow>\<^sub>o B)"
  proof (unfold C_Henkin_valid_in_context_def, intro conjI allI impI)
    show "[] \<turnstile> (A \<longleftrightarrow>\<^sub>o B) : Prop"
      using A_type B_type by auto
  next
    fix T
    assume henkin: "C_Henkin_theory [] T"
    have membership: "A \<in> T \<longleftrightarrow> B \<in> T"
      using same henkin
      unfolding pp_same_substitution_intension_def
        pp_C_universal_Henkin_view_def by blast
    have AB_type: "[] \<turnstile> Imp A B : Prop"
      using A_type B_type by auto
    have BA_type: "[] \<turnstile> Imp B A : Prop"
      using A_type B_type by auto
    have AB_in: "Imp A B \<in> T"
      using C_Henkin_imp_mem_iff[OF henkin A_type B_type] membership
      by blast
    have BA_in: "Imp B A \<in> T"
      using C_Henkin_imp_mem_iff[OF henkin B_type A_type] membership
      by blast
    show "(A \<longleftrightarrow>\<^sub>o B) \<in> T"
      using C_Henkin_conj_mem_iff[OF henkin AB_type BA_type] AB_in BA_in
      by blast
  qed
  show "[] \<turnstile>\<^sub>C (A \<longleftrightarrow>\<^sub>o B)"
    using valid C_Henkin_valid_in_context_iff_proves by blast
next
  assume bicond_theorem: "[] \<turnstile>\<^sub>C (A \<longleftrightarrow>\<^sub>o B)"
  have valid: "C_Henkin_valid_in_context [] (A \<longleftrightarrow>\<^sub>o B)"
    using bicond_theorem C_Henkin_valid_in_context_iff_proves by blast
  show "pp_same_substitution_intension pp_C_universal_Henkin_view A B"
    unfolding pp_same_substitution_intension_def
  proof (intro allI)
    fix T
    show
      "pp_C_universal_Henkin_view T A =
        pp_C_universal_Henkin_view T B"
    proof (cases "C_Henkin_theory [] T")
      case False
      then show ?thesis
        by (simp add: pp_C_universal_Henkin_view_def)
    next
      case True
      have bicond_in: "(A \<longleftrightarrow>\<^sub>o B) \<in> T"
        using valid True unfolding C_Henkin_valid_in_context_def by blast
      have AB_type: "[] \<turnstile> Imp A B : Prop"
        using A_type B_type by auto
      have BA_type: "[] \<turnstile> Imp B A : Prop"
        using A_type B_type by auto
      have AB_in: "Imp A B \<in> T"
        using C_Henkin_conj_mem_iff[OF True AB_type BA_type] bicond_in
        by blast
      have BA_in: "Imp B A \<in> T"
        using C_Henkin_conj_mem_iff[OF True AB_type BA_type] bicond_in
        by blast
      have membership: "A \<in> T \<longleftrightarrow> B \<in> T"
        using C_Henkin_imp_mem_iff[OF True A_type B_type]
          C_Henkin_imp_mem_iff[OF True B_type A_type] AB_in BA_in
        by blast
      show ?thesis
        using True membership
        by (simp add: pp_C_universal_Henkin_view_def)
    qed
  qed
qed

definition pp_C_propositional_equivalence ::
    "oterm \<Rightarrow> oterm \<Rightarrow> bool" where
  "pp_C_propositional_equivalence A B \<longleftrightarrow>
    [] \<turnstile>\<^sub>C (A \<longleftrightarrow>\<^sub>o B)"

theorem pp_C_universal_Henkin_reflects_propositional_purity:
  "pp_intensional_reflection_at Prop pp_C_propositional_equivalence
    pp_C_universal_Henkin_view"
  unfolding pp_intensional_reflection_at_def
proof (intro allI impI)
  fix A N
  assume A_type: "[] \<turnstile> A : Prop"
    and pure_N: "pp_r_free_closed_pure_term_at Prop N"
    and same:
      "pp_same_substitution_intension pp_C_universal_Henkin_view A N"
  have N_type: "[] \<turnstile> N : Prop"
    using pure_N unfolding pp_r_free_closed_pure_term_at_def by blast
  have equiv: "pp_C_propositional_equivalence A N"
    using pp_C_universal_Henkin_same_intension_iff[OF A_type N_type] same
    unfolding pp_C_propositional_equivalence_def by blast
  show
    "pp_has_r_free_representative_modulo_at
      Prop pp_C_propositional_equivalence A"
    unfolding pp_has_r_free_representative_modulo_at_def
    using A_type pure_N equiv by blast
qed

theorem pp_C_universal_Henkin_semantic_purity_iff:
  assumes A_type: "[] \<turnstile> A : Prop"
  shows
    "pp_has_r_free_pure_representative_at
        Prop pp_C_universal_Henkin_view A
      \<longleftrightarrow>
      pp_has_r_free_representative_modulo_at
        Prop pp_C_propositional_equivalence A"
proof (rule pp_typed_semantic_and_proof_purity_coincide)
  fix M N
  assume M_type: "[] \<turnstile> M : Prop"
    and N_type: "[] \<turnstile> N : Prop"
    and equiv: "pp_C_propositional_equivalence M N"
  show
    "pp_same_substitution_intension pp_C_universal_Henkin_view M N"
    using pp_C_universal_Henkin_same_intension_iff[OF M_type N_type] equiv
    unfolding pp_C_propositional_equivalence_def by blast
next
  show
    "pp_intensional_reflection_at Prop pp_C_propositional_equivalence
      pp_C_universal_Henkin_view"
    by (rule pp_C_universal_Henkin_reflects_propositional_purity)
qed

definition pp_C_generic_Henkin_view ::
    "(oterm set \<times> oterm) \<Rightarrow> oterm \<Rightarrow> bool" where
  "pp_C_generic_Henkin_view w A \<longleftrightarrow>
    C_Henkin_theory [] (fst w) \<and>
    [] \<turnstile> snd w : Prop \<and>
    subst_const pp_r_name Prop (snd w) A \<in> fst w"

theorem pp_C_generic_Henkin_same_intension_iff:
  assumes A_type: "[] \<turnstile> A : Prop"
    and B_type: "[] \<turnstile> B : Prop"
  shows
    "pp_same_substitution_intension pp_C_generic_Henkin_view A B
      \<longleftrightarrow> [] \<turnstile>\<^sub>C (A \<longleftrightarrow>\<^sub>o B)"
proof
  assume same:
      "pp_same_substitution_intension pp_C_generic_Henkin_view A B"
  have universal_same:
      "pp_same_substitution_intension pp_C_universal_Henkin_view A B"
    unfolding pp_same_substitution_intension_def
  proof (intro allI)
    fix T
    have view_instance:
        "pp_C_generic_Henkin_view (T, pp_r) A =
          pp_C_generic_Henkin_view (T, pp_r) B"
      using same unfolding pp_same_substitution_intension_def by blast
    show
      "pp_C_universal_Henkin_view T A =
        pp_C_universal_Henkin_view T B"
      using view_instance typed_pp_r
      by (simp add: pp_C_generic_Henkin_view_def
          pp_C_universal_Henkin_view_def pp_r_def)
  qed
  show "[] \<turnstile>\<^sub>C (A \<longleftrightarrow>\<^sub>o B)"
    using pp_C_universal_Henkin_same_intension_iff[OF A_type B_type]
      universal_same by blast
next
  assume bicond_theorem: "[] \<turnstile>\<^sub>C (A \<longleftrightarrow>\<^sub>o B)"
  show "pp_same_substitution_intension pp_C_generic_Henkin_view A B"
    unfolding pp_same_substitution_intension_def
  proof (intro allI)
    fix w :: "oterm set \<times> oterm"
    obtain T N where w_def: "w = (T, N)"
      by (cases w) blast
    show
      "pp_C_generic_Henkin_view w A =
        pp_C_generic_Henkin_view w B"
    proof (cases "C_Henkin_theory [] T \<and> [] \<turnstile> N : Prop")
      case False
      then show ?thesis
        by (auto simp: w_def pp_C_generic_Henkin_view_def)
    next
      case True
      then have henkin: "C_Henkin_theory [] T"
        and N_type: "[] \<turnstile> N : Prop"
        by auto
      let ?A = "subst_const pp_r_name Prop N A"
      let ?B = "subst_const pp_r_name Prop N B"
      have A_sub_type: "[] \<turnstile> ?A : Prop"
        using A_type N_type by (rule subst_const_preserves_typing)
      have B_sub_type: "[] \<turnstile> ?B : Prop"
        using B_type N_type by (rule subst_const_preserves_typing)
      have substituted_bicond:
          "[] \<turnstile>\<^sub>C (?A \<longleftrightarrow>\<^sub>o ?B)"
        using C_proves_subst_const[OF bicond_theorem N_type] by simp
      have sub_same:
          "pp_same_substitution_intension
            pp_C_universal_Henkin_view ?A ?B"
        using pp_C_universal_Henkin_same_intension_iff[
          OF A_sub_type B_sub_type] substituted_bicond by blast
      have membership: "?A \<in> T \<longleftrightarrow> ?B \<in> T"
        using sub_same henkin
        unfolding pp_same_substitution_intension_def
          pp_C_universal_Henkin_view_def by blast
      show ?thesis
        using henkin N_type membership
        unfolding w_def pp_C_generic_Henkin_view_def by simp
    qed
  qed
qed

theorem pp_C_generic_Henkin_reflects_propositional_purity:
  "pp_intensional_reflection_at Prop pp_C_propositional_equivalence
    pp_C_generic_Henkin_view"
  unfolding pp_intensional_reflection_at_def
proof (intro allI impI)
  fix A N
  assume A_type: "[] \<turnstile> A : Prop"
    and pure_N: "pp_r_free_closed_pure_term_at Prop N"
    and same:
      "pp_same_substitution_intension pp_C_generic_Henkin_view A N"
  have N_type: "[] \<turnstile> N : Prop"
    using pure_N unfolding pp_r_free_closed_pure_term_at_def by blast
  have equiv: "pp_C_propositional_equivalence A N"
    using pp_C_generic_Henkin_same_intension_iff[OF A_type N_type] same
    unfolding pp_C_propositional_equivalence_def by blast
  show
    "pp_has_r_free_representative_modulo_at
      Prop pp_C_propositional_equivalence A"
    unfolding pp_has_r_free_representative_modulo_at_def
    using A_type pure_N equiv by blast
qed

theorem pp_C_generic_Henkin_semantic_purity_iff:
  assumes A_type: "[] \<turnstile> A : Prop"
  shows
    "pp_has_r_free_pure_representative_at
        Prop pp_C_generic_Henkin_view A
      \<longleftrightarrow>
      pp_has_r_free_representative_modulo_at
        Prop pp_C_propositional_equivalence A"
proof (rule pp_typed_semantic_and_proof_purity_coincide)
  fix M N
  assume M_type: "[] \<turnstile> M : Prop"
    and N_type: "[] \<turnstile> N : Prop"
    and equiv: "pp_C_propositional_equivalence M N"
  show
    "pp_same_substitution_intension pp_C_generic_Henkin_view M N"
    using pp_C_generic_Henkin_same_intension_iff[OF M_type N_type] equiv
    unfolding pp_C_propositional_equivalence_def by blast
next
  show
    "pp_intensional_reflection_at Prop pp_C_propositional_equivalence
      pp_C_generic_Henkin_view"
    by (rule pp_C_generic_Henkin_reflects_propositional_purity)
qed

subsection \<open>The simultaneous coherence target\<close>

text \<open>
  The quotient results above assume that a view of every term has already been
  assigned.  To make the interpretation of \<open>Pure\<close> part of that same
  assignment, we isolate a typed observational relation.  At propositions it
  is theorem-level biconditional equivalence.  At individuals it is
  theorem-level identity.  At function types it is pointwise observational
  equivalence on all closed arguments.  This gives a clean, non-contextual
  quotient candidate.  A full applicative model additionally requires a
  congruence theorem for application; no such theorem is assumed here.
\<close>

fun pp_C_observational_equivalence ::
    "otype \<Rightarrow> oterm \<Rightarrow> oterm \<Rightarrow> bool" where
  "pp_C_observational_equivalence Prop A B \<longleftrightarrow>
    [] \<turnstile> A : Prop \<and> [] \<turnstile> B : Prop \<and>
    [] \<turnstile>\<^sub>C (A \<longleftrightarrow>\<^sub>o B)"
| "pp_C_observational_equivalence Ind A B \<longleftrightarrow>
    [] \<turnstile> A : Ind \<and> [] \<turnstile> B : Ind \<and>
    [] \<turnstile>\<^sub>C Eq Ind A B"
| "pp_C_observational_equivalence (\<sigma> \<rightarrow>\<^sub>o \<tau>) F G \<longleftrightarrow>
    [] \<turnstile> F : \<sigma> \<rightarrow>\<^sub>o \<tau> \<and>
    [] \<turnstile> G : \<sigma> \<rightarrow>\<^sub>o \<tau> \<and>
    (\<forall>X. [] \<turnstile> X : \<sigma> \<longrightarrow>
      pp_C_observational_equivalence \<tau> (App F X) (App G X))"

definition pp_C_observationally_pure ::
    "otype \<Rightarrow> oterm \<Rightarrow> bool" where
  "pp_C_observationally_pure \<sigma> A \<longleftrightarrow>
    (\<exists>N. pp_r_free_closed_pure_term_at \<sigma> N \<and>
      pp_C_observational_equivalence \<sigma> A N)"

definition pp_C_purity_coherence_literal ::
    "otype \<Rightarrow> oterm \<Rightarrow> oterm" where
  "pp_C_purity_coherence_literal \<sigma> A =
    (if pp_C_observationally_pure \<sigma> A
      then pp_pure \<sigma> A
      else Neg (pp_pure \<sigma> A))"

definition pp_project_vocabulary :: "oterm \<Rightarrow> bool" where
  "pp_project_vocabulary A \<longleftrightarrow>
    consts_of A \<subseteq> {pp_pure_name, pp_fun_name, pp_r_name}"

definition pp_C_purity_coherence_diagram :: "oterm set" where
  "pp_C_purity_coherence_diagram =
    {L. \<exists>\<sigma> A. [] \<turnstile> A : \<sigma> \<and>
      pp_project_vocabulary A \<and>
      L = pp_C_purity_coherence_literal \<sigma> A}"

definition pp_C_purity_coherence_consistent :: bool where
  "pp_C_purity_coherence_consistent \<longleftrightarrow>
    C_consistent [] pp_C_purity_coherence_diagram"

definition pp_CEV_purity_coherence_consistent :: bool where
  "pp_CEV_purity_coherence_consistent \<longleftrightarrow>
    CEV_consistent [] pp_C_purity_coherence_diagram"

lemma pp_C_observational_equivalence_refl:
  assumes "[] \<turnstile> A : \<sigma>"
  shows "pp_C_observational_equivalence \<sigma> A A"
  using assms
  by (induction \<sigma> arbitrary: A rule: otype.induct)
    (auto intro: C_proves.H H_bicond_refl H_proves.Ref)

fun pp_propositional_simple_type :: "otype \<Rightarrow> bool" where
  "pp_propositional_simple_type Ind = False"
| "pp_propositional_simple_type Prop = True"
| "pp_propositional_simple_type (\<sigma> \<rightarrow>\<^sub>o \<tau>) =
    (pp_propositional_simple_type \<sigma> \<and>
      pp_propositional_simple_type \<tau>)"

lemma pp_C_bicond_sym:
  assumes A_type: "[] \<turnstile> A : Prop"
    and B_type: "[] \<turnstile> B : Prop"
    and AB: "[] \<turnstile>\<^sub>C (A \<longleftrightarrow>\<^sub>o B)"
  shows "[] \<turnstile>\<^sub>C (B \<longleftrightarrow>\<^sub>o A)"
proof -
  have taut:
      "prop_tautology []
        (Imp (A \<longleftrightarrow>\<^sub>o B) (B \<longleftrightarrow>\<^sub>o A))"
    using A_type B_type by (rule prop_tautology_bicond_sym)
  have implication:
      "[] \<turnstile>\<^sub>C
        Imp (A \<longleftrightarrow>\<^sub>o B) (B \<longleftrightarrow>\<^sub>o A)"
    using taut by (intro C_proves.H H_proves.PC)
  show ?thesis
    using AB implication by (rule C_proves.MP)
qed

lemma pp_C_bicond_trans:
  assumes A_type: "[] \<turnstile> A : Prop"
    and B_type: "[] \<turnstile> B : Prop"
    and C_type: "[] \<turnstile> C : Prop"
    and AB: "[] \<turnstile>\<^sub>C (A \<longleftrightarrow>\<^sub>o B)"
    and BC: "[] \<turnstile>\<^sub>C (B \<longleftrightarrow>\<^sub>o C)"
  shows "[] \<turnstile>\<^sub>C (A \<longleftrightarrow>\<^sub>o C)"
proof -
  have taut:
      "prop_tautology []
        (Imp (A \<longleftrightarrow>\<^sub>o B)
          (Imp (B \<longleftrightarrow>\<^sub>o C) (A \<longleftrightarrow>\<^sub>o C)))"
    using A_type B_type C_type by (rule prop_tautology_bicond_trans)
  have first:
      "[] \<turnstile>\<^sub>C
        Imp (A \<longleftrightarrow>\<^sub>o B)
          (Imp (B \<longleftrightarrow>\<^sub>o C) (A \<longleftrightarrow>\<^sub>o C))"
    using taut by (intro C_proves.H H_proves.PC)
  have second:
      "[] \<turnstile>\<^sub>C
        Imp (B \<longleftrightarrow>\<^sub>o C) (A \<longleftrightarrow>\<^sub>o C)"
    using AB first by (rule C_proves.MP)
  show ?thesis
    using BC second by (rule C_proves.MP)
qed

lemma pp_C_observational_equivalence_sym:
  assumes propositional: "pp_propositional_simple_type \<sigma>"
    and AB: "pp_C_observational_equivalence \<sigma> A B"
  shows "pp_C_observational_equivalence \<sigma> B A"
  using assms
proof (induction \<sigma> arbitrary: A B rule: otype.induct)
  case Ind
  then show ?case by simp
next
  case Prop
  then show ?case
    by (auto intro: pp_C_bicond_sym)
next
  case (Arr \<sigma> \<tau>)
  then show ?case
    by auto
qed

lemma pp_C_observational_equivalence_trans:
  assumes propositional: "pp_propositional_simple_type \<sigma>"
    and AB: "pp_C_observational_equivalence \<sigma> A B"
    and BC: "pp_C_observational_equivalence \<sigma> B C"
  shows "pp_C_observational_equivalence \<sigma> A C"
  using assms
proof (induction \<sigma> arbitrary: A B C rule: otype.induct)
  case Ind
  then show ?case by simp
next
  case Prop
  then show ?case
    by (auto intro: pp_C_bicond_trans)
next
  case (Arr \<sigma> \<tau>)
  then show ?case
    by auto
qed

definition pp_C_observational_class ::
    "otype \<Rightarrow> oterm \<Rightarrow> oterm set" where
  "pp_C_observational_class \<sigma> A =
    {B. pp_C_observational_equivalence \<sigma> A B}"

definition pp_C_observational_quotient ::
    "otype \<Rightarrow> oterm set set" where
  "pp_C_observational_quotient \<sigma> =
    range (pp_C_observational_class \<sigma>)"

definition pp_C_observational_quotient_Pure ::
    "otype \<Rightarrow> oterm set \<Rightarrow> bool" where
  "pp_C_observational_quotient_Pure \<sigma> Q \<longleftrightarrow>
    (\<exists>A. Q = pp_C_observational_class \<sigma> A \<and>
      pp_C_observationally_pure \<sigma> A)"

lemma pp_C_observational_purity_invariant:
  assumes propositional: "pp_propositional_simple_type \<sigma>"
    and AB: "pp_C_observational_equivalence \<sigma> A B"
  shows
    "pp_C_observationally_pure \<sigma> A
      \<longleftrightarrow> pp_C_observationally_pure \<sigma> B"
proof
  assume pure_A: "pp_C_observationally_pure \<sigma> A"
  then obtain N where N_pure: "pp_r_free_closed_pure_term_at \<sigma> N"
    and AN: "pp_C_observational_equivalence \<sigma> A N"
    unfolding pp_C_observationally_pure_def by blast
  have BA: "pp_C_observational_equivalence \<sigma> B A"
    using propositional AB by (rule pp_C_observational_equivalence_sym)
  have BN: "pp_C_observational_equivalence \<sigma> B N"
    using propositional BA AN by (rule pp_C_observational_equivalence_trans)
  show "pp_C_observationally_pure \<sigma> B"
    unfolding pp_C_observationally_pure_def using N_pure BN by blast
next
  assume pure_B: "pp_C_observationally_pure \<sigma> B"
  then obtain N where N_pure: "pp_r_free_closed_pure_term_at \<sigma> N"
    and BN: "pp_C_observational_equivalence \<sigma> B N"
    unfolding pp_C_observationally_pure_def by blast
  have AN: "pp_C_observational_equivalence \<sigma> A N"
    using propositional AB BN by (rule pp_C_observational_equivalence_trans)
  show "pp_C_observationally_pure \<sigma> A"
    unfolding pp_C_observationally_pure_def using N_pure AN by blast
qed

theorem pp_C_observational_quotient_Pure_class_iff:
  assumes propositional: "pp_propositional_simple_type \<sigma>"
    and A_type: "[] \<turnstile> A : \<sigma>"
  shows
    "pp_C_observational_quotient_Pure \<sigma>
        (pp_C_observational_class \<sigma> A)
      \<longleftrightarrow> pp_C_observationally_pure \<sigma> A"
proof
  assume quotient_pure:
      "pp_C_observational_quotient_Pure \<sigma>
        (pp_C_observational_class \<sigma> A)"
  then obtain B where classes:
      "pp_C_observational_class \<sigma> A =
        pp_C_observational_class \<sigma> B"
    and pure_B: "pp_C_observationally_pure \<sigma> B"
    unfolding pp_C_observational_quotient_Pure_def by blast
  have B_type: "[] \<turnstile> B : \<sigma>"
    using pure_B unfolding pp_C_observationally_pure_def
    by (cases \<sigma>) auto
  have BB: "pp_C_observational_equivalence \<sigma> B B"
    using B_type by (rule pp_C_observational_equivalence_refl)
  have AB: "pp_C_observational_equivalence \<sigma> A B"
    using classes BB unfolding pp_C_observational_class_def by blast
  show "pp_C_observationally_pure \<sigma> A"
    using pp_C_observational_purity_invariant[OF propositional AB] pure_B
    by blast
next
  assume pure_A: "pp_C_observationally_pure \<sigma> A"
  show
    "pp_C_observational_quotient_Pure \<sigma>
      (pp_C_observational_class \<sigma> A)"
    unfolding pp_C_observational_quotient_Pure_def
    using pure_A by blast
qed

lemma pp_r_free_term_is_C_observationally_pure:
  assumes "pp_r_free_closed_pure_term_at \<sigma> N"
  shows "pp_C_observationally_pure \<sigma> N"
proof -
  have N_type: "[] \<turnstile> N : \<sigma>"
    using assms unfolding pp_r_free_closed_pure_term_at_def by blast
  have obs: "pp_C_observational_equivalence \<sigma> N N"
    using N_type by (rule pp_C_observational_equivalence_refl)
  show ?thesis
    unfolding pp_C_observationally_pure_def
    using assms obs by blast
qed

lemma pp_target_Pure_classifier_is_C_observationally_pure:
  "pp_C_observationally_pure
    ((Prop \<rightarrow>\<^sub>o Prop) \<rightarrow>\<^sub>o Prop)
    (pp_Pure (Prop \<rightarrow>\<^sub>o Prop))"
proof (rule pp_r_free_term_is_C_observationally_pure)
  show
    "pp_r_free_closed_pure_term_at
      ((Prop \<rightarrow>\<^sub>o Prop) \<rightarrow>\<^sub>o Prop)
      (pp_Pure (Prop \<rightarrow>\<^sub>o Prop))"
    unfolding pp_r_free_closed_pure_term_at_def
      pp_expanded_pure_vocabulary_def pp_Pure_def
    by (intro conjI has_type.Const) simp
qed

lemma typed_pp_C_purity_coherence_literal:
  assumes "[] \<turnstile> A : \<sigma>"
  shows "[] \<turnstile> pp_C_purity_coherence_literal \<sigma> A : Prop"
  unfolding pp_C_purity_coherence_literal_def
  using typed_pp_pure[OF assms] by auto

lemma typed_pp_C_purity_coherence_diagram:
  "typed_theory [] pp_C_purity_coherence_diagram"
  unfolding typed_theory_def pp_C_purity_coherence_diagram_def
  using typed_pp_C_purity_coherence_literal by blast

lemma pp_C_purity_coherence_literal_in_diagram:
  assumes "[] \<turnstile> A : \<sigma>"
    and "pp_project_vocabulary A"
  shows
    "pp_C_purity_coherence_literal \<sigma> A
      \<in> pp_C_purity_coherence_diagram"
  unfolding pp_C_purity_coherence_diagram_def
  using assms by blast

lemma pp_C_purity_coherence_positive_iff:
  assumes A_type: "[] \<turnstile> A : \<sigma>"
    and vocabulary: "pp_project_vocabulary A"
    and pure: "pp_C_observationally_pure \<sigma> A"
  shows "pp_pure \<sigma> A \<in> pp_C_purity_coherence_diagram"
  using pp_C_purity_coherence_literal_in_diagram[OF A_type vocabulary] pure
  unfolding pp_C_purity_coherence_literal_def by simp

lemma pp_C_purity_coherence_negative_iff:
  assumes A_type: "[] \<turnstile> A : \<sigma>"
    and vocabulary: "pp_project_vocabulary A"
    and impure: "\<not> pp_C_observationally_pure \<sigma> A"
  shows "Neg (pp_pure \<sigma> A) \<in> pp_C_purity_coherence_diagram"
  using pp_C_purity_coherence_literal_in_diagram[OF A_type vocabulary] impure
  unfolding pp_C_purity_coherence_literal_def by simp

theorem pp_C_purity_coherence_diagram_decides_Pure:
  assumes A_type: "[] \<turnstile> A : \<sigma>"
    and vocabulary: "pp_project_vocabulary A"
  shows
    "(pp_C_observationally_pure \<sigma> A \<and>
        pp_pure \<sigma> A \<in> pp_C_purity_coherence_diagram) \<or>
      (\<not> pp_C_observationally_pure \<sigma> A \<and>
        Neg (pp_pure \<sigma> A) \<in> pp_C_purity_coherence_diagram)"
  using pp_C_purity_coherence_positive_iff[OF A_type vocabulary]
    pp_C_purity_coherence_negative_iff[OF A_type vocabulary]
  by blast

lemma CEV_set_transfers_pp_pure_across_theorem_identity:
  assumes A_type: "[] \<turnstile> A : \<sigma>"
    and B_type: "[] \<turnstile> B : \<sigma>"
    and eq_AB: "[] \<turnstile>\<^sub>CEV Eq \<sigma> A B"
    and d_pure_A: "[] ; T \<turnstile>\<^sub>CEV\<^sub>s pp_pure \<sigma> A"
  shows "[] ; T \<turnstile>\<^sub>CEV\<^sub>s pp_pure \<sigma> B"
proof -
  have ll:
      "[] \<turnstile>\<^sub>CEV
        Imp (Eq \<sigma> A B)
          (Imp (pp_pure \<sigma> A) (pp_pure \<sigma> B))"
    unfolding pp_pure_def
    using A_type B_type typed_pp_Pure
    by (intro CEV_proves.CE CE_proves.C C_proves.H H_proves.LL)
  have d_eq: "[] ; T \<turnstile>\<^sub>CEV\<^sub>s Eq \<sigma> A B"
    using eq_AB by (rule CEV_set_Theorem)
  have d_ll:
      "[] ; T \<turnstile>\<^sub>CEV\<^sub>s
        Imp (Eq \<sigma> A B)
          (Imp (pp_pure \<sigma> A) (pp_pure \<sigma> B))"
    using ll by (rule CEV_set_Theorem)
  have d_imp:
      "[] ; T \<turnstile>\<^sub>CEV\<^sub>s
        Imp (pp_pure \<sigma> A) (pp_pure \<sigma> B)"
    using d_eq d_ll by (rule CEV_set_MP)
  show ?thesis
    using d_pure_A d_imp by (rule CEV_set_MP)
qed

lemma pp_CEV_coherence_consistency_forces_identity_purity_imp:
  assumes consistent: "pp_CEV_purity_coherence_consistent"
    and A_type: "[] \<turnstile> A : \<sigma>"
    and B_type: "[] \<turnstile> B : \<sigma>"
    and A_vocabulary: "pp_project_vocabulary A"
    and B_vocabulary: "pp_project_vocabulary B"
    and eq_AB: "[] \<turnstile>\<^sub>CEV Eq \<sigma> A B"
    and pure_A: "pp_C_observationally_pure \<sigma> A"
  shows "pp_C_observationally_pure \<sigma> B"
proof (rule ccontr)
  assume impure_B: "\<not> pp_C_observationally_pure \<sigma> B"
  have pure_A_in:
      "pp_pure \<sigma> A \<in> pp_C_purity_coherence_diagram"
    using A_type A_vocabulary pure_A
    by (rule pp_C_purity_coherence_positive_iff)
  have neg_pure_B_in:
      "Neg (pp_pure \<sigma> B) \<in> pp_C_purity_coherence_diagram"
    using B_type B_vocabulary impure_B
    by (rule pp_C_purity_coherence_negative_iff)
  have d_pure_A:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s
        pp_pure \<sigma> A"
    using pure_A_in typed_pp_pure[OF A_type]
    by (intro CEV_set_derivable.Assumption) auto
  have d_pure_B:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s
        pp_pure \<sigma> B"
    using A_type B_type eq_AB d_pure_A
    by (rule CEV_set_transfers_pp_pure_across_theorem_identity)
  have d_neg_pure_B:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s
        Neg (pp_pure \<sigma> B)"
    using neg_pure_B_in typed_pp_pure[OF B_type]
    by (intro CEV_set_derivable.Assumption) auto
  have d_false:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s ObjFalse"
    using d_pure_B d_neg_pure_B
    by (rule CEV_set_derives_ObjFalse_of_formula_and_neg_derivable)
  show False
    using consistent d_false
    unfolding pp_CEV_purity_coherence_consistent_def CEV_consistent_def
    by blast
qed

theorem pp_CEV_coherence_consistency_forces_identity_purity_invariance:
  assumes consistent: "pp_CEV_purity_coherence_consistent"
    and A_type: "[] \<turnstile> A : \<sigma>"
    and B_type: "[] \<turnstile> B : \<sigma>"
    and A_vocabulary: "pp_project_vocabulary A"
    and B_vocabulary: "pp_project_vocabulary B"
    and eq_AB: "[] \<turnstile>\<^sub>CEV Eq \<sigma> A B"
  shows
    "pp_C_observationally_pure \<sigma> A
      \<longleftrightarrow> pp_C_observationally_pure \<sigma> B"
proof
  assume pure_A: "pp_C_observationally_pure \<sigma> A"
  show "pp_C_observationally_pure \<sigma> B"
    using consistent A_type B_type A_vocabulary B_vocabulary eq_AB pure_A
    by (rule pp_CEV_coherence_consistency_forces_identity_purity_imp)
next
  assume pure_B: "pp_C_observationally_pure \<sigma> B"
  have eq_BA: "[] \<turnstile>\<^sub>CEV Eq \<sigma> B A"
  proof -
    have symmetry:
        "[] \<turnstile>\<^sub>CEV Imp (Eq \<sigma> A B) (Eq \<sigma> B A)"
      using A_type B_type by (rule CEV_eq_sym)
    show ?thesis
      using eq_AB symmetry by (rule CEV_proves.MP)
  qed
  show "pp_C_observationally_pure \<sigma> A"
    using consistent B_type A_type B_vocabulary A_vocabulary eq_BA pure_B
    by (rule pp_CEV_coherence_consistency_forces_identity_purity_imp)
qed

theorem pp_CEV_coherence_consistency_forces_theorem_purity:
  assumes consistent: "pp_CEV_purity_coherence_consistent"
    and theorem_A: "[] \<turnstile>\<^sub>CEV A"
    and vocabulary: "pp_project_vocabulary A"
  shows "pp_C_observationally_pure Prop A"
proof (rule ccontr)
  have A_type: "[] \<turnstile> A : Prop"
    using theorem_A by (rule CEV_proves_formula)
  assume impure: "\<not> pp_C_observationally_pure Prop A"
  have neg_pure_A_in:
      "Neg (pp_pure Prop A) \<in> pp_C_purity_coherence_diagram"
    using A_type vocabulary impure
    by (rule pp_C_purity_coherence_negative_iff)
  have d_neg_pure_A:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s
        Neg (pp_pure Prop A)"
    using neg_pure_A_in typed_pp_pure[OF A_type]
    by (intro CEV_set_derivable.Assumption) auto

  have true_r_free:
      "pp_r_free_closed_pure_term_at Prop ObjTrue"
    unfolding pp_r_free_closed_pure_term_at_def
      pp_expanded_pure_vocabulary_def
    by (intro conjI typed_ObjTrue) (simp add: ObjTrue_def)
  have true_observationally_pure:
      "pp_C_observationally_pure Prop ObjTrue"
    using true_r_free by (rule pp_r_free_term_is_C_observationally_pure)
  have true_vocabulary: "pp_project_vocabulary ObjTrue"
    unfolding pp_project_vocabulary_def by (simp add: ObjTrue_def)
  have pure_true_in:
      "pp_pure Prop ObjTrue \<in> pp_C_purity_coherence_diagram"
    using typed_ObjTrue true_vocabulary true_observationally_pure
    by (rule pp_C_purity_coherence_positive_iff)
  have d_pure_true:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s
        pp_pure Prop ObjTrue"
    using pure_true_in typed_pp_pure[OF typed_ObjTrue]
    by (intro CEV_set_derivable.Assumption) auto

  have bicond_true: "[] \<turnstile>\<^sub>CEV (A \<longleftrightarrow>\<^sub>o ObjTrue)"
    using theorem_A by (rule CEV_theorem_equiv_ObjTrue)
  have eq_A_true: "[] \<turnstile>\<^sub>CEV Eq Prop A ObjTrue"
    using A_type typed_ObjTrue bicond_true
    by (rule CEV_zeroary_equivalence)
  have eq_sym:
      "[] \<turnstile>\<^sub>CEV Imp (Eq Prop A ObjTrue) (Eq Prop ObjTrue A)"
    using A_type typed_ObjTrue by (rule CEV_eq_sym)
  have eq_true_A: "[] \<turnstile>\<^sub>CEV Eq Prop ObjTrue A"
    using eq_A_true eq_sym by (rule CEV_proves.MP)
  have ll:
      "[] \<turnstile>\<^sub>CEV
        Imp (Eq Prop ObjTrue A)
          (Imp (pp_pure Prop ObjTrue) (pp_pure Prop A))"
    unfolding pp_pure_def
    using typed_ObjTrue A_type typed_pp_Pure
    by (intro CEV_proves.CE CE_proves.C C_proves.H H_proves.LL)
  have d_eq_true_A:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s
        Eq Prop ObjTrue A"
    using eq_true_A by (rule CEV_set_Theorem)
  have d_ll:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s
        Imp (Eq Prop ObjTrue A)
          (Imp (pp_pure Prop ObjTrue) (pp_pure Prop A))"
    using ll by (rule CEV_set_Theorem)
  have d_imp:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s
        Imp (pp_pure Prop ObjTrue) (pp_pure Prop A)"
    using d_eq_true_A d_ll by (rule CEV_set_MP)
  have d_pure_A:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s
        pp_pure Prop A"
    using d_pure_true d_imp by (rule CEV_set_MP)
  have d_false:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s ObjFalse"
    using d_pure_A d_neg_pure_A
    by (rule CEV_set_derives_ObjFalse_of_formula_and_neg_derivable)
  show False
    using consistent d_false
    unfolding pp_CEV_purity_coherence_consistent_def CEV_consistent_def
    by blast
qed

corollary pp_CEV_impure_theorem_refutes_coherence_consistency:
  assumes theorem_A: "[] \<turnstile>\<^sub>CEV A"
    and vocabulary: "pp_project_vocabulary A"
    and impure: "\<not> pp_C_observationally_pure Prop A"
  shows "\<not> pp_CEV_purity_coherence_consistent"
  using pp_CEV_coherence_consistency_forces_theorem_purity[
      OF _ theorem_A vocabulary]
    impure by blast

corollary pp_CEV_identity_purity_mismatch_refutes_coherence_consistency:
  assumes A_type: "[] \<turnstile> A : \<sigma>"
    and B_type: "[] \<turnstile> B : \<sigma>"
    and A_vocabulary: "pp_project_vocabulary A"
    and B_vocabulary: "pp_project_vocabulary B"
    and eq_AB: "[] \<turnstile>\<^sub>CEV Eq \<sigma> A B"
    and mismatch:
      "pp_C_observationally_pure \<sigma> A
        \<noteq> pp_C_observationally_pure \<sigma> B"
  shows "\<not> pp_CEV_purity_coherence_consistent"
  using pp_CEV_coherence_consistency_forces_identity_purity_invariance[
      OF _ A_type B_type A_vocabulary B_vocabulary eq_AB]
    mismatch by blast

text \<open>
  The coherence target is false for the current CEV calculus.  At the empty
  vector, ContextVectorEquivalence internalizes theorem-level equivalence as
  the conditional schema \<open>(A \<longleftrightarrow>\<^sub>o B) \<longrightarrow> A = B\<close>.  Leibniz's law
  therefore makes every predicate on propositions, including \<open>Pure\<close>,
  insensitive to distinctions between materially equivalent propositions.
  Since \<open>ObjTrue\<close> and \<open>ObjFalse\<close> are both classified pure, CEV forces every
  proposition to be pure.  If the generic proposition \<open>pp_r\<close> is classified
  impure, its negative diagram literal then yields a contradiction; if it is
  classified pure, substituting truth and falsity for \<open>pp_r\<close> already makes C
  prove falsity.
\<close>

lemma CEV_contextual_propositional_equivalence:
  assumes A_type: "\<Gamma> \<turnstile> A : Prop"
    and B_type: "\<Gamma> \<turnstile> B : Prop"
  shows
    "\<Gamma> \<turnstile>\<^sub>CEV
      Imp (A \<longleftrightarrow>\<^sub>o B) (Eq Prop A B)"
proof -
  have bicond_type: "\<Gamma> \<turnstile> (A \<longleftrightarrow>\<^sub>o B) : Prop"
    using A_type B_type by auto
  have body:
      "\<Gamma> \<turnstile>\<^sub>CEV
        Imp (A \<longleftrightarrow>\<^sub>o B) (A \<longleftrightarrow>\<^sub>o B)"
    using bicond_type
    by (intro CEV_prop_tautology prop_tautology_imp_self)
  have premise:
      "[] @ \<Gamma> \<turnstile>\<^sub>CEV
        Imp (shift_by (length ([] :: otype list))
          (A \<longleftrightarrow>\<^sub>o B))
          (zeta_body [] A B)"
    using body by (simp add: zeta_body_def fresh_vars_def)
  have
      "\<Gamma> \<turnstile>\<^sub>CEV
        Imp (A \<longleftrightarrow>\<^sub>o B)
          (Eq (arrow_type [] Prop) A B)"
    by (rule CEV_proves.ContextVectorEquivalence[
          where \<sigma>s = "[]" and A = "A \<longleftrightarrow>\<^sub>o B"
            and F = A and G = B])
      (use A_type B_type bicond_type premise in simp_all)
  then show ?thesis
    by simp
qed

lemma pp_r_not_C_observationally_pure_if_CEV_coherence_consistent:
  assumes consistent: "pp_CEV_purity_coherence_consistent"
  shows "\<not> pp_C_observationally_pure Prop pp_r"
proof
  assume pure_r: "pp_C_observationally_pure Prop pp_r"
  then obtain N where
      N_pure: "pp_r_free_closed_pure_term_at Prop N"
    and r_N: "pp_C_observational_equivalence Prop pp_r N"
    unfolding pp_C_observationally_pure_def by blast
  have N_type: "[] \<turnstile> N : Prop"
    using N_pure unfolding pp_r_free_closed_pure_term_at_def by blast
  have r_fresh: "pp_r_name \<notin> consts_of N"
    using N_pure
    unfolding pp_r_free_closed_pure_term_at_def
      pp_expanded_pure_vocabulary_def pp_r_name_def pp_pure_name_def
    by auto
  have bicond: "[] \<turnstile>\<^sub>C (pp_r \<longleftrightarrow>\<^sub>o N)"
    using r_N by simp
  have true_bicond:
      "[] \<turnstile>\<^sub>C (ObjTrue \<longleftrightarrow>\<^sub>o N)"
    using C_proves_subst_const[
      OF bicond, where c = pp_r_name and \<sigma> = Prop and N = ObjTrue]
      typed_ObjTrue r_fresh
    by (simp add: pp_r_def)
  have false_bicond:
      "[] \<turnstile>\<^sub>C (ObjFalse \<longleftrightarrow>\<^sub>o N)"
    using C_proves_subst_const[
      OF bicond, where c = pp_r_name and \<sigma> = Prop and N = ObjFalse]
      typed_ObjFalse r_fresh
    by (simp add: pp_r_def)
  have collapse:
      "prop_tautology []
        (Imp (ObjTrue \<longleftrightarrow>\<^sub>o N)
          (Imp (ObjFalse \<longleftrightarrow>\<^sub>o N) ObjFalse))"
  proof -
    have true_bicond_type:
        "[] \<turnstile> (ObjTrue \<longleftrightarrow>\<^sub>o N) : Prop"
      using typed_ObjTrue N_type by auto
    have false_bicond_type:
        "[] \<turnstile> (ObjFalse \<longleftrightarrow>\<^sub>o N) : Prop"
      using typed_ObjFalse N_type by auto
    have formula_type:
        "[] \<turnstile>
          Imp (ObjTrue \<longleftrightarrow>\<^sub>o N)
            (Imp (ObjFalse \<longleftrightarrow>\<^sub>o N) ObjFalse) : Prop"
      using true_bicond_type false_bicond_type typed_ObjFalse
      by (intro has_type.Imp)
    have eval:
        "\<forall>v.
          prop_eval v
            (Imp (ObjTrue \<longleftrightarrow>\<^sub>o N)
              (Imp (ObjFalse \<longleftrightarrow>\<^sub>o N) ObjFalse))"
    proof
      fix v
      show
        "prop_eval v
          (Imp (ObjTrue \<longleftrightarrow>\<^sub>o N)
            (Imp (ObjFalse \<longleftrightarrow>\<^sub>o N) ObjFalse))"
        unfolding ObjFalse_def
        apply (simp only: prop_eval.simps)
        by blast
    qed
    show ?thesis
      unfolding prop_tautology_def using formula_type eval by blast
  qed
  have collapse_theorem:
      "[] \<turnstile>\<^sub>C
        Imp (ObjTrue \<longleftrightarrow>\<^sub>o N)
          (Imp (ObjFalse \<longleftrightarrow>\<^sub>o N) ObjFalse)"
    using collapse by (intro C_proves.H H_proves.PC)
  have second:
      "[] \<turnstile>\<^sub>C
        Imp (ObjFalse \<longleftrightarrow>\<^sub>o N) ObjFalse"
    using true_bicond collapse_theorem by (rule C_proves.MP)
  have c_false: "[] \<turnstile>\<^sub>C ObjFalse"
    using false_bicond second by (rule C_proves.MP)
  have cev_false: "[] \<turnstile>\<^sub>CEV ObjFalse"
    using c_false by (intro CEV_proves.CE CE_proves.C)
  have d_false:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s
        ObjFalse"
    using cev_false by (rule CEV_set_Theorem)
  show False
    using consistent d_false
    unfolding pp_CEV_purity_coherence_consistent_def CEV_consistent_def
    by blast
qed

theorem pp_CEV_purity_coherence_inconsistent:
  "\<not> pp_CEV_purity_coherence_consistent"
proof
  assume consistent: "pp_CEV_purity_coherence_consistent"
  let ?PT = "pp_pure Prop ObjTrue"
  let ?PF = "pp_pure Prop ObjFalse"
  let ?PR = "pp_pure Prop pp_r"
  let ?ET = "ObjTrue \<longleftrightarrow>\<^sub>o pp_r"
  let ?EF = "ObjFalse \<longleftrightarrow>\<^sub>o pp_r"
  let ?eqT = "Eq Prop ObjTrue pp_r"
  let ?eqF = "Eq Prop ObjFalse pp_r"

  have true_r_free:
      "pp_r_free_closed_pure_term_at Prop ObjTrue"
    unfolding pp_r_free_closed_pure_term_at_def
      pp_expanded_pure_vocabulary_def
    by (intro conjI typed_ObjTrue) (simp add: ObjTrue_def)
  have false_r_free:
      "pp_r_free_closed_pure_term_at Prop ObjFalse"
    unfolding pp_r_free_closed_pure_term_at_def
      pp_expanded_pure_vocabulary_def
    by (intro conjI typed_ObjFalse)
      (simp add: ObjFalse_def ObjTrue_def)
  have true_pure: "pp_C_observationally_pure Prop ObjTrue"
    using true_r_free by (rule pp_r_free_term_is_C_observationally_pure)
  have false_pure: "pp_C_observationally_pure Prop ObjFalse"
    using false_r_free by (rule pp_r_free_term_is_C_observationally_pure)
  have r_impure: "\<not> pp_C_observationally_pure Prop pp_r"
    using consistent
    by (rule pp_r_not_C_observationally_pure_if_CEV_coherence_consistent)

  have true_vocabulary: "pp_project_vocabulary ObjTrue"
    unfolding pp_project_vocabulary_def by (simp add: ObjTrue_def)
  have false_vocabulary: "pp_project_vocabulary ObjFalse"
    unfolding pp_project_vocabulary_def
    by (simp add: ObjFalse_def ObjTrue_def)
  have r_vocabulary: "pp_project_vocabulary pp_r"
    unfolding pp_project_vocabulary_def pp_r_def by simp
  have PT_in: "?PT \<in> pp_C_purity_coherence_diagram"
    using typed_ObjTrue true_vocabulary true_pure
    by (rule pp_C_purity_coherence_positive_iff)
  have PF_in: "?PF \<in> pp_C_purity_coherence_diagram"
    using typed_ObjFalse false_vocabulary false_pure
    by (rule pp_C_purity_coherence_positive_iff)
  have not_PR_in:
      "Neg ?PR \<in> pp_C_purity_coherence_diagram"
    using typed_pp_r r_vocabulary r_impure
    by (rule pp_C_purity_coherence_negative_iff)
  have d_PT:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s ?PT"
    using PT_in typed_pp_pure[OF typed_ObjTrue]
    by (intro CEV_set_derivable.Assumption) auto
  have d_PF:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s ?PF"
    using PF_in typed_pp_pure[OF typed_ObjFalse]
    by (intro CEV_set_derivable.Assumption) auto
  have d_not_PR:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s Neg ?PR"
    using not_PR_in typed_pp_pure[OF typed_pp_r]
    by (intro CEV_set_derivable.Assumption) auto

  have ET_eq:
      "[] \<turnstile>\<^sub>CEV Imp ?ET ?eqT"
    using typed_ObjTrue typed_pp_r
    by (rule CEV_contextual_propositional_equivalence)
  have EF_eq:
      "[] \<turnstile>\<^sub>CEV Imp ?EF ?eqF"
    using typed_ObjFalse typed_pp_r
    by (rule CEV_contextual_propositional_equivalence)
  have eqT_pure:
      "[] \<turnstile>\<^sub>CEV Imp ?eqT (Imp ?PT ?PR)"
    unfolding pp_pure_def
    using typed_ObjTrue typed_pp_r typed_pp_Pure
    by (intro CEV_proves.CE CE_proves.C C_proves.H H_proves.LL)
  have eqF_pure:
      "[] \<turnstile>\<^sub>CEV Imp ?eqF (Imp ?PF ?PR)"
    unfolding pp_pure_def
    using typed_ObjFalse typed_pp_r typed_pp_Pure
    by (intro CEV_proves.CE CE_proves.C C_proves.H H_proves.LL)
  have cases_taut:
      "prop_tautology []
        (Imp (Imp ?ET ?eqT)
          (Imp (Imp ?EF ?eqF)
            (Imp (Imp ?eqT (Imp ?PT ?PR))
              (Imp (Imp ?eqF (Imp ?PF ?PR))
                (Imp ?PT (Imp ?PF ?PR))))))"
  proof -
    have ET_type: "[] \<turnstile> ?ET : Prop"
      using typed_ObjTrue typed_pp_r by auto
    have EF_type: "[] \<turnstile> ?EF : Prop"
      using typed_ObjFalse typed_pp_r by auto
    have eqT_type: "[] \<turnstile> ?eqT : Prop"
      using typed_ObjTrue typed_pp_r by auto
    have eqF_type: "[] \<turnstile> ?eqF : Prop"
      using typed_ObjFalse typed_pp_r by auto
    have PT_type: "[] \<turnstile> ?PT : Prop"
      using typed_ObjTrue by (rule typed_pp_pure)
    have PF_type: "[] \<turnstile> ?PF : Prop"
      using typed_ObjFalse by (rule typed_pp_pure)
    have PR_type: "[] \<turnstile> ?PR : Prop"
      using typed_pp_r by (rule typed_pp_pure)
    have formula_type:
        "[] \<turnstile>
          Imp (Imp ?ET ?eqT)
            (Imp (Imp ?EF ?eqF)
              (Imp (Imp ?eqT (Imp ?PT ?PR))
                (Imp (Imp ?eqF (Imp ?PF ?PR))
                  (Imp ?PT (Imp ?PF ?PR))))) : Prop"
      using ET_type EF_type eqT_type eqF_type PT_type PF_type PR_type
      by (intro has_type.Imp)
    have eval:
        "\<forall>v.
          prop_eval v
            (Imp (Imp ?ET ?eqT)
              (Imp (Imp ?EF ?eqF)
                (Imp (Imp ?eqT (Imp ?PT ?PR))
                  (Imp (Imp ?eqF (Imp ?PF ?PR))
                    (Imp ?PT (Imp ?PF ?PR))))))"
    proof
      fix v
      show
        "prop_eval v
          (Imp (Imp ?ET ?eqT)
            (Imp (Imp ?EF ?eqF)
              (Imp (Imp ?eqT (Imp ?PT ?PR))
                (Imp (Imp ?eqF (Imp ?PF ?PR))
                  (Imp ?PT (Imp ?PF ?PR))))))"
        unfolding ObjFalse_def
        apply (simp only: prop_eval.simps)
        by blast
    qed
    show ?thesis
      unfolding prop_tautology_def using formula_type eval by blast
  qed
  have cases:
      "[] \<turnstile>\<^sub>CEV
        Imp (Imp ?ET ?eqT)
          (Imp (Imp ?EF ?eqF)
            (Imp (Imp ?eqT (Imp ?PT ?PR))
              (Imp (Imp ?eqF (Imp ?PF ?PR))
                (Imp ?PT (Imp ?PF ?PR)))))"
    using cases_taut by (rule CEV_prop_tautology)
  have step1:
      "[] \<turnstile>\<^sub>CEV
        Imp (Imp ?EF ?eqF)
          (Imp (Imp ?eqT (Imp ?PT ?PR))
            (Imp (Imp ?eqF (Imp ?PF ?PR))
              (Imp ?PT (Imp ?PF ?PR))))"
    using ET_eq cases by (rule CEV_proves.MP)
  have step2:
      "[] \<turnstile>\<^sub>CEV
        Imp (Imp ?eqT (Imp ?PT ?PR))
          (Imp (Imp ?eqF (Imp ?PF ?PR))
            (Imp ?PT (Imp ?PF ?PR)))"
    using EF_eq step1 by (rule CEV_proves.MP)
  have step3:
      "[] \<turnstile>\<^sub>CEV
        Imp (Imp ?eqF (Imp ?PF ?PR))
          (Imp ?PT (Imp ?PF ?PR))"
    using eqT_pure step2 by (rule CEV_proves.MP)
  have pure_bridge:
      "[] \<turnstile>\<^sub>CEV Imp ?PT (Imp ?PF ?PR)"
    using eqF_pure step3 by (rule CEV_proves.MP)
  have d_bridge:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s
        Imp ?PT (Imp ?PF ?PR)"
    using pure_bridge by (rule CEV_set_Theorem)
  have d_second:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s
        Imp ?PF ?PR"
    using d_PT d_bridge by (rule CEV_set_MP)
  have d_PR:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s ?PR"
    using d_PF d_second by (rule CEV_set_MP)
  have d_false:
      "[] ; pp_C_purity_coherence_diagram \<turnstile>\<^sub>CEV\<^sub>s ObjFalse"
    using d_PR d_not_PR
    by (rule CEV_set_derives_ObjFalse_of_formula_and_neg_derivable)
  show False
    using consistent d_false
    unfolding pp_CEV_purity_coherence_consistent_def CEV_consistent_def
    by blast
qed

lemma pp_C_purity_coherence_diagram_finite_constants:
  "finite (consts_of_set pp_C_purity_coherence_diagram)"
proof (rule finite_subset[where B =
    "{pp_pure_name, pp_fun_name, pp_r_name}"])
  show
    "consts_of_set pp_C_purity_coherence_diagram
      \<subseteq> {pp_pure_name, pp_fun_name, pp_r_name}"
    unfolding consts_of_set_def pp_C_purity_coherence_diagram_def
      pp_C_purity_coherence_literal_def pp_project_vocabulary_def
      pp_pure_def pp_Pure_def
    by auto
  show "finite {pp_pure_name, pp_fun_name, pp_r_name}"
    by simp
qed

definition pp_CEV_purity_coherent_Henkin_theory ::
    "oterm set \<Rightarrow> bool" where
  "pp_CEV_purity_coherent_Henkin_theory T \<longleftrightarrow>
    CEV_Henkin_theory [] T \<and>
    pp_C_purity_coherence_diagram \<subseteq> T"

theorem pp_CEV_purity_coherent_Henkin_exists_iff:
  "(\<exists>T. pp_CEV_purity_coherent_Henkin_theory T)
    \<longleftrightarrow> pp_CEV_purity_coherence_consistent"
proof
  assume "\<exists>T. pp_CEV_purity_coherent_Henkin_theory T"
  then obtain T where henkin: "CEV_Henkin_theory [] T"
    and diagram: "pp_C_purity_coherence_diagram \<subseteq> T"
    unfolding pp_CEV_purity_coherent_Henkin_theory_def by blast
  have "CEV_consistent [] T"
    using henkin by (rule CEV_Henkin_CEV_consistent)
  then have "CEV_consistent [] pp_C_purity_coherence_diagram"
    using diagram by (rule CEV_consistent_mono)
  then show "pp_CEV_purity_coherence_consistent"
    unfolding pp_CEV_purity_coherence_consistent_def .
next
  assume consistent: "pp_CEV_purity_coherence_consistent"
  have consistent':
    "CEV_consistent [] pp_C_purity_coherence_diagram"
    using consistent unfolding pp_CEV_purity_coherence_consistent_def .
  then obtain T where
      diagram: "pp_C_purity_coherence_diagram \<subseteq> T"
    and henkin: "CEV_Henkin_theory [] T"
    using CEV_Henkin_extension_exists[
      OF typed_pp_C_purity_coherence_diagram consistent'
        pp_C_purity_coherence_diagram_finite_constants]
    by blast
  show "\<exists>T. pp_CEV_purity_coherent_Henkin_theory T"
    unfolding pp_CEV_purity_coherent_Henkin_theory_def
    using diagram henkin by blast
qed

corollary pp_no_CEV_purity_coherent_Henkin_theory:
  "\<not> (\<exists>T. pp_CEV_purity_coherent_Henkin_theory T)"
  using pp_CEV_purity_coherent_Henkin_exists_iff
    pp_CEV_purity_coherence_inconsistent
  by blast

theorem pp_CEV_purity_coherent_Henkin_interprets_Pure:
  assumes coherent: "pp_CEV_purity_coherent_Henkin_theory T"
    and A_type: "[] \<turnstile> A : \<sigma>"
    and vocabulary: "pp_project_vocabulary A"
  shows
    "pp_pure \<sigma> A \<in> T
      \<longleftrightarrow> pp_C_observationally_pure \<sigma> A"
proof
  assume pure_in: "pp_pure \<sigma> A \<in> T"
  show "pp_C_observationally_pure \<sigma> A"
  proof (rule ccontr)
    assume impure: "\<not> pp_C_observationally_pure \<sigma> A"
    have neg_in:
        "Neg (pp_pure \<sigma> A) \<in> T"
      using pp_C_purity_coherence_negative_iff[
          OF A_type vocabulary impure]
        coherent
      unfolding pp_CEV_purity_coherent_Henkin_theory_def by blast
    have c_henkin: "C_Henkin_theory [] T"
      using coherent unfolding pp_CEV_purity_coherent_Henkin_theory_def
      by (blast intro: CEV_Henkin_C_Henkin)
    have pure_type: "[] \<turnstile> pp_pure \<sigma> A : Prop"
      using A_type by (rule typed_pp_pure)
    have "pp_pure \<sigma> A \<notin> T"
      using C_Henkin_neg_mem_iff[OF c_henkin pure_type] neg_in by blast
    then show False
      using pure_in by blast
  qed
next
  assume pure: "pp_C_observationally_pure \<sigma> A"
  have
    "pp_pure \<sigma> A \<in> pp_C_purity_coherence_diagram"
    using A_type vocabulary pure
    by (rule pp_C_purity_coherence_positive_iff)
  then show "pp_pure \<sigma> A \<in> T"
    using coherent unfolding pp_CEV_purity_coherent_Henkin_theory_def
    by blast
qed

theorem pp_CEV_coherent_Pure_matches_observational_quotient:
  assumes coherent: "pp_CEV_purity_coherent_Henkin_theory T"
    and propositional: "pp_propositional_simple_type \<sigma>"
    and A_type: "[] \<turnstile> A : \<sigma>"
    and vocabulary: "pp_project_vocabulary A"
  shows
    "pp_pure \<sigma> A \<in> T
      \<longleftrightarrow>
      pp_C_observational_quotient_Pure \<sigma>
        (pp_C_observational_class \<sigma> A)"
  using pp_CEV_purity_coherent_Henkin_interprets_Pure[
      OF coherent A_type vocabulary]
    pp_C_observational_quotient_Pure_class_iff[
      OF propositional A_type]
  by blast

theorem pp_target_PP_formula_in_C_purity_coherence_diagram:
  "pp_pure ((Prop \<rightarrow>\<^sub>o Prop) \<rightarrow>\<^sub>o Prop)
      (pp_Pure (Prop \<rightarrow>\<^sub>o Prop))
    \<in> pp_C_purity_coherence_diagram"
proof -
  have classifier_type:
      "[] \<turnstile> pp_Pure (Prop \<rightarrow>\<^sub>o Prop) :
        (Prop \<rightarrow>\<^sub>o Prop) \<rightarrow>\<^sub>o Prop"
    by (rule typed_pp_Pure)
  have classifier_vocabulary:
      "pp_project_vocabulary (pp_Pure (Prop \<rightarrow>\<^sub>o Prop))"
    unfolding pp_project_vocabulary_def pp_Pure_def by simp
  have
    "pp_pure ((Prop \<rightarrow>\<^sub>o Prop) \<rightarrow>\<^sub>o Prop)
      (pp_Pure (Prop \<rightarrow>\<^sub>o Prop))
      \<in> pp_C_purity_coherence_diagram"
    using classifier_type classifier_vocabulary
      pp_target_Pure_classifier_is_C_observationally_pure
    by (rule pp_C_purity_coherence_positive_iff)
  then show ?thesis .
qed

definition pp_purity_schema :: "oterm set" where
  "pp_purity_schema =
    {A. \<exists>\<sigma> M. [] \<turnstile> M : \<sigma> \<and> pp_logical_vocabulary M \<and>
      A = pp_pure \<sigma> M}"

definition pp_all_PP_schema :: "oterm set" where
  "pp_all_PP_schema = {A. \<exists>\<sigma>. A = pp_purity_of_pure \<sigma>}"

definition pp_target_PP :: oterm where
  "pp_target_PP = pp_purity_of_pure (Prop \<rightarrow>\<^sub>o Prop)"

theorem pp_target_PP_in_C_purity_coherence_diagram:
  "pp_target_PP \<in> pp_C_purity_coherence_diagram"
  using pp_target_PP_formula_in_C_purity_coherence_diagram
  by (simp add: pp_target_PP_def pp_purity_of_pure_def)

theorem pp_CEV_purity_coherent_Henkin_contains_target_PP:
  assumes "pp_CEV_purity_coherent_Henkin_theory T"
  shows "pp_target_PP \<in> T"
  using assms pp_target_PP_in_C_purity_coherence_diagram
  unfolding pp_CEV_purity_coherent_Henkin_theory_def by blast

theorem pp_CEV_coherence_consistency_yields_quotient_and_Pure:
  assumes "pp_CEV_purity_coherence_consistent"
  obtains T where
    "pp_CEV_purity_coherent_Henkin_theory T"
    "pp_target_PP \<in> T"
    "\<And>\<sigma> A.
      pp_propositional_simple_type \<sigma> \<Longrightarrow>
      [] \<turnstile> A : \<sigma> \<Longrightarrow>
      pp_project_vocabulary A \<Longrightarrow>
      (pp_pure \<sigma> A \<in> T \<longleftrightarrow>
        pp_C_observational_quotient_Pure \<sigma>
          (pp_C_observational_class \<sigma> A))"
proof -
  obtain T where coherent: "pp_CEV_purity_coherent_Henkin_theory T"
    using assms pp_CEV_purity_coherent_Henkin_exists_iff by blast
  have target: "pp_target_PP \<in> T"
    using coherent by (rule pp_CEV_purity_coherent_Henkin_contains_target_PP)
  have quotient:
      "\<And>\<sigma> A.
        pp_propositional_simple_type \<sigma> \<Longrightarrow>
        [] \<turnstile> A : \<sigma> \<Longrightarrow>
        pp_project_vocabulary A \<Longrightarrow>
        (pp_pure \<sigma> A \<in> T \<longleftrightarrow>
          pp_C_observational_quotient_Pure \<sigma>
            (pp_C_observational_class \<sigma> A))"
  proof -
    fix \<sigma> A
    assume propositional: "pp_propositional_simple_type \<sigma>"
      and A_type: "[] \<turnstile> A : \<sigma>"
      and vocabulary: "pp_project_vocabulary A"
    show
      "pp_pure \<sigma> A \<in> T \<longleftrightarrow>
        pp_C_observational_quotient_Pure \<sigma>
          (pp_C_observational_class \<sigma> A)"
      using coherent propositional A_type vocabulary
      by (rule pp_CEV_coherent_Pure_matches_observational_quotient)
  qed
  show ?thesis
    using that coherent target quotient by blast
qed

text \<open>
  Thus consistency of the finite-vocabulary coherence diagram is exactly the
  remaining existence premise for a Henkin theory whose root interpretation of
  \<open>Pure\<close> agrees with the observational quotient and contains the target PP
  instance.  This does not yet prove that observational equivalence is a
  congruence for application.  That additional result is required before the
  quotient can serve as the carrier of a full typed applicative model.
\<close>

definition pp_application_closure_schema :: "oterm set" where
  "pp_application_closure_schema =
    {A. \<exists>\<sigma> \<tau>. A = pp_application_closure \<sigma> \<tau>}"

definition pp_no_other_fundamentals_schema :: "oterm set" where
  "pp_no_other_fundamentals_schema =
    {A. \<exists>\<sigma>. \<sigma> \<noteq> Prop \<and> A = pp_no_fundamentals \<sigma>}"

definition pp_persistence_schema :: "oterm set" where
  "pp_persistence_schema = {A. \<exists>\<sigma>. A = pp_persistence \<sigma>}"

definition pp_core_axioms :: "oterm set" where
  "pp_core_axioms =
    pp_purity_schema \<union>
    pp_application_closure_schema \<union>
    {pp_target_PP} \<union>
    {pp_unique_fundamental Prop} \<union>
    pp_no_other_fundamentals_schema"

definition pp_core_all_PP_axioms :: "oterm set" where
  "pp_core_all_PP_axioms =
    pp_purity_schema \<union>
    pp_application_closure_schema \<union>
    pp_all_PP_schema \<union>
    {pp_unique_fundamental Prop} \<union>
    pp_no_other_fundamentals_schema"

definition pp_recombination_axioms :: "oterm set" where
  "pp_recombination_axioms =
    pp_core_axioms \<union>
    {pp_zeroary_recombination, pp_unary_recombination}"

definition pp_full_QLN_axioms :: "oterm set" where
  "pp_full_QLN_axioms =
    pp_core_axioms \<union> {pp_zeroary_QLN, pp_unary_QLN}"

definition pp_full_QLN_persistence_axioms :: "oterm set" where
  "pp_full_QLN_persistence_axioms =
    pp_full_QLN_axioms \<union> pp_persistence_schema"

text \<open>
  The named-witness package also records the unary Recombination direction
  explicitly.  It is the package used to audit the proposed direct argument;
  deriving that direction from the biconditional QLN formulation is a
  separate, purely proof-theoretic bridge.
\<close>

definition pp_full_QLN_named_r_axioms :: "oterm set" where
  "pp_full_QLN_named_r_axioms =
    pp_full_QLN_axioms \<union>
    {pp_fun Prop pp_r, pp_unary_recombination}"

definition pp_unary_recombination_r_axioms :: "oterm set" where
  "pp_unary_recombination_r_axioms =
    pp_core_axioms \<union> {pp_fun Prop pp_r, pp_unary_recombination}"

definition pp_full_QLN_r_axioms :: "oterm set" where
  "pp_full_QLN_r_axioms =
    pp_full_QLN_axioms \<union> {pp_fun Prop pp_r}"

definition pp_full_QLN_QSS_r_axioms :: "oterm set" where
  "pp_full_QLN_QSS_r_axioms =
    pp_full_QLN_r_axioms \<union> {pp_QSS}"

definition pp_consistency_question :: bool where
  "pp_consistency_question \<longleftrightarrow> CEV_consistent [] pp_full_QLN_axioms"

definition pp_consistency_question_with_persistence :: bool where
  "pp_consistency_question_with_persistence \<longleftrightarrow>
    CEV_consistent [] pp_full_QLN_persistence_axioms"

theorem pp_negative_answer_iff_derives_contradiction:
  "\<not> pp_consistency_question \<longleftrightarrow>
    [] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s ObjFalse"
  unfolding pp_consistency_question_def CEV_consistent_def
  by blast

theorem pp_negative_answer_iff_finite_inconsistent_core:
  "\<not> pp_consistency_question \<longleftrightarrow>
    (\<exists>U. finite U \<and> U \<subseteq> pp_full_QLN_axioms \<and>
      [] ; U \<turnstile>\<^sub>CEV\<^sub>s ObjFalse)"
proof
  assume negative: "\<not> pp_consistency_question"
  have d_false:
      "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s ObjFalse"
    using negative pp_negative_answer_iff_derives_contradiction by blast
  obtain U where finite_U: "finite U"
    and U_sub: "U \<subseteq> pp_full_QLN_axioms"
    and d_U: "[] ; U \<turnstile>\<^sub>CEV\<^sub>s ObjFalse"
    using d_false by (rule CEV_set_derivable_finite_support)
  show "\<exists>U. finite U \<and> U \<subseteq> pp_full_QLN_axioms \<and>
      [] ; U \<turnstile>\<^sub>CEV\<^sub>s ObjFalse"
    using finite_U U_sub d_U by blast
next
  assume core:
      "\<exists>U. finite U \<and> U \<subseteq> pp_full_QLN_axioms \<and>
        [] ; U \<turnstile>\<^sub>CEV\<^sub>s ObjFalse"
  obtain U where U_sub: "U \<subseteq> pp_full_QLN_axioms"
    and d_U: "[] ; U \<turnstile>\<^sub>CEV\<^sub>s ObjFalse"
    using core by blast
  have "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s ObjFalse"
    using d_U U_sub by (rule CEV_set_derivable_mono)
  then show "\<not> pp_consistency_question"
    using pp_negative_answer_iff_derives_contradiction by blast
qed

theorem pp_negative_answer_with_persistence_iff_derives_contradiction:
  "\<not> pp_consistency_question_with_persistence \<longleftrightarrow>
    [] ; pp_full_QLN_persistence_axioms \<turnstile>\<^sub>CEV\<^sub>s ObjFalse"
  unfolding pp_consistency_question_with_persistence_def CEV_consistent_def
  by blast

lemma pp_purity_of_pure_in_all_PP_schema:
  "pp_purity_of_pure \<sigma> \<in> pp_all_PP_schema"
  unfolding pp_all_PP_schema_def by blast

lemma pp_target_PP_in_core:
  "pp_target_PP \<in> pp_core_axioms"
  by (simp add: pp_core_axioms_def)

lemma pp_target_PP_in_full_QLN:
  "pp_target_PP \<in> pp_full_QLN_axioms"
  using pp_target_PP_in_core
  by (simp add: pp_full_QLN_axioms_def)

lemma typed_pp_target_PP:
  "[] \<turnstile> pp_target_PP : Prop"
  unfolding pp_target_PP_def
  by (rule typed_pp_purity_of_pure)

lemma pp_purity_of_fun_not_in_purity_schema:
  "pp_purity_of_fun \<sigma> \<notin> pp_purity_schema"
proof
  assume "pp_purity_of_fun \<sigma> \<in> pp_purity_schema"
  then obtain \<tau> M where
    vocabulary: "pp_logical_vocabulary M" and
    equation: "pp_purity_of_fun \<sigma> = pp_pure \<tau> M"
    unfolding pp_purity_schema_def by blast
  have arguments:
      "Const pp_pure_name ((\<sigma> \<rightarrow>\<^sub>o Prop) \<rightarrow>\<^sub>o Prop) =
        Const pp_pure_name (\<tau> \<rightarrow>\<^sub>o Prop) \<and>
       Const pp_fun_name (\<sigma> \<rightarrow>\<^sub>o Prop) = M"
    using equation
    unfolding pp_purity_of_fun_def pp_pure_def pp_Pure_def pp_Fun_def
    by (simp only: oterm.inject)
  have term_eq: "pp_Fun \<sigma> = M"
    using arguments
    unfolding pp_Fun_def by blast
  then have "pp_logical_vocabulary (pp_Fun \<sigma>)"
    using vocabulary by metis
  then show False
    unfolding pp_logical_vocabulary_def pp_Fun_def
    by simp
qed

lemma pp_purity_of_fun_not_in_core:
  "pp_purity_of_fun \<sigma> \<notin> pp_core_axioms"
proof
  assume membership: "pp_purity_of_fun \<sigma> \<in> pp_core_axioms"
  then consider
      (schema) "pp_purity_of_fun \<sigma> \<in> pp_purity_schema"
    | (application) "pp_purity_of_fun \<sigma> \<in> pp_application_closure_schema"
    | (PP) "pp_purity_of_fun \<sigma> = pp_target_PP"
    | (unique) "pp_purity_of_fun \<sigma> = pp_unique_fundamental Prop"
    | (other) "pp_purity_of_fun \<sigma> \<in> pp_no_other_fundamentals_schema"
    unfolding pp_core_axioms_def by blast
  then show False
  proof cases
    case schema
    then show False
      using pp_purity_of_fun_not_in_purity_schema by blast
  next
    case application
    then obtain \<rho> \<tau> where
      "pp_purity_of_fun \<sigma> = pp_application_closure \<rho> \<tau>"
      unfolding pp_application_closure_schema_def by blast
    then show False
      unfolding pp_purity_of_fun_def pp_application_closure_def pp_pure_def
      by simp
  next
    case PP
    then show False
      unfolding pp_purity_of_fun_def pp_target_PP_def
        pp_purity_of_pure_def pp_pure_def pp_Fun_def pp_Pure_def
        pp_fun_name_def pp_pure_name_def
      by simp
  next
    case unique
    then show False
      unfolding pp_purity_of_fun_def pp_unique_fundamental_def pp_pure_def
      by simp
  next
    case other
    then obtain \<rho> where
      "pp_purity_of_fun \<sigma> = pp_no_fundamentals \<rho>"
      unfolding pp_no_other_fundamentals_schema_def by blast
    then show False
      unfolding pp_purity_of_fun_def pp_no_fundamentals_def pp_pure_def
      by simp
  qed
qed

lemma pp_purity_of_fun_not_in_full_QLN:
  "pp_purity_of_fun \<sigma> \<notin> pp_full_QLN_axioms"
proof
  assume membership: "pp_purity_of_fun \<sigma> \<in> pp_full_QLN_axioms"
  then consider
      (core) "pp_purity_of_fun \<sigma> \<in> pp_core_axioms"
    | (zeroary) "pp_purity_of_fun \<sigma> = pp_zeroary_QLN"
    | (unary) "pp_purity_of_fun \<sigma> = pp_unary_QLN"
    unfolding pp_full_QLN_axioms_def by blast
  then show False
  proof cases
    case core
    then show False
      using pp_purity_of_fun_not_in_core by blast
  next
    case zeroary
    then show False
      unfolding pp_purity_of_fun_def pp_zeroary_QLN_def pp_pure_def
      by simp
  next
    case unary
    then show False
      unfolding pp_purity_of_fun_def pp_unary_QLN_def pp_pure_def
      by simp
  qed
qed

