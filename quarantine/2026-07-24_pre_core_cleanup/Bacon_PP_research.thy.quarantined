  using pp_purity_schema_typed pp_application_closure_schema_typed
    pp_no_other_fundamentals_schema_typed typed_pp_unique_fundamental
    typed_pp_target_PP
  by blast

lemma pp_recombination_axioms_typed:
  "typed_theory [] pp_recombination_axioms"
  unfolding typed_theory_def pp_recombination_axioms_def
  using pp_core_axioms_typed typed_pp_zeroary_recombination
    typed_pp_unary_recombination typed_theoryD
  by blast

lemma pp_full_QLN_axioms_typed:
  "typed_theory [] pp_full_QLN_axioms"
  unfolding typed_theory_def pp_full_QLN_axioms_def
  using pp_core_axioms_typed typed_pp_zeroary_QLN typed_pp_unary_QLN
    typed_theoryD
  by blast

lemma pp_full_QLN_axioms_const_support:
  "consts_of_set pp_full_QLN_axioms \<subseteq>
    {pp_pure_name, pp_fun_name}"
  unfolding consts_of_set_def pp_full_QLN_axioms_def pp_core_axioms_def
    pp_purity_schema_def pp_application_closure_schema_def
    pp_no_other_fundamentals_schema_def pp_logical_vocabulary_def
    pp_target_PP_def pp_purity_of_pure_def pp_application_closure_def
    pp_unique_fundamental_def pp_no_fundamentals_def
    pp_zeroary_QLN_def pp_unary_QLN_def
    pp_pure_def pp_Pure_def pp_fun_def pp_Fun_def
    ObjBox_def ObjTrue_def
  by auto

lemma pp_full_QLN_axioms_finite_const_support:
  "finite (consts_of_set pp_full_QLN_axioms)"
  using pp_full_QLN_axioms_const_support
  by (rule finite_subset) simp

definition pp_Henkin_model_exists :: bool where
  "pp_Henkin_model_exists \<longleftrightarrow>
    (\<exists>U. pp_full_QLN_axioms \<subseteq> U \<and> CEV_Henkin_theory [] U)"

definition pp_finitely_consistent :: bool where
  "pp_finitely_consistent \<longleftrightarrow>
    (\<forall>U. finite U \<longrightarrow> U \<subseteq> pp_full_QLN_axioms \<longrightarrow>
      CEV_consistent [] U)"

definition pp_chosen_Henkin_model :: "oterm set" where
  "pp_chosen_Henkin_model =
    (SOME U.
      pp_full_QLN_axioms \<subseteq> U \<and> CEV_Henkin_theory [] U)"

theorem pp_consistency_iff_Henkin_model_exists:
  "pp_consistency_question \<longleftrightarrow> pp_Henkin_model_exists"
proof
  assume consistent: "pp_consistency_question"
  have cev_consistent: "CEV_consistent [] pp_full_QLN_axioms"
    using consistent unfolding pp_consistency_question_def .
  have extension:
      "\<exists>U. pp_full_QLN_axioms \<subseteq> U \<and> CEV_Henkin_theory [] U"
    using pp_full_QLN_axioms_typed cev_consistent
      pp_full_QLN_axioms_finite_const_support
    by (rule CEV_Henkin_extension_exists)
  obtain U where sub: "pp_full_QLN_axioms \<subseteq> U"
    and henkin: "CEV_Henkin_theory [] U"
    using extension by blast
  show "pp_Henkin_model_exists"
    unfolding pp_Henkin_model_exists_def
    using sub henkin by blast
next
  assume model: "pp_Henkin_model_exists"
  obtain U where sub: "pp_full_QLN_axioms \<subseteq> U"
    and henkin: "CEV_Henkin_theory [] U"
    using model unfolding pp_Henkin_model_exists_def by blast
  have U_consistent: "CEV_consistent [] U"
    using henkin by (rule CEV_Henkin_CEV_consistent)
  have "CEV_consistent [] pp_full_QLN_axioms"
    using U_consistent sub by (rule CEV_consistent_mono)
  then show "pp_consistency_question"
    unfolding pp_consistency_question_def .
qed

theorem pp_negative_answer_iff_no_Henkin_model:
  "\<not> pp_consistency_question \<longleftrightarrow> \<not> pp_Henkin_model_exists"
  using pp_consistency_iff_Henkin_model_exists by blast

theorem pp_consistency_iff_finitely_consistent:
  "pp_consistency_question \<longleftrightarrow> pp_finitely_consistent"
proof
  assume consistent: "pp_consistency_question"
  have full_consistent: "CEV_consistent [] pp_full_QLN_axioms"
    using consistent unfolding pp_consistency_question_def .
  show "pp_finitely_consistent"
    unfolding pp_finitely_consistent_def
  proof (intro allI impI)
    fix U
    assume "finite U" and U_sub: "U \<subseteq> pp_full_QLN_axioms"
    show "CEV_consistent [] U"
      using full_consistent U_sub by (rule CEV_consistent_mono)
  qed
next
  assume finite_consistent: "pp_finitely_consistent"
  show "pp_consistency_question"
  proof (rule ccontr)
    assume negative: "\<not> pp_consistency_question"
    obtain U where finite_U: "finite U"
      and U_sub: "U \<subseteq> pp_full_QLN_axioms"
      and d_false: "[] ; U \<turnstile>\<^sub>CEV\<^sub>s ObjFalse"
      using negative pp_negative_answer_iff_finite_inconsistent_core
      by blast
    have U_consistent: "CEV_consistent [] U"
      using finite_consistent finite_U U_sub
      unfolding pp_finitely_consistent_def by blast
    show False
      using U_consistent d_false unfolding CEV_consistent_def by blast
  qed
qed

theorem pp_Henkin_model_exists_iff_finitely_consistent:
  "pp_Henkin_model_exists \<longleftrightarrow> pp_finitely_consistent"
  using pp_consistency_iff_Henkin_model_exists
    pp_consistency_iff_finitely_consistent
  by blast

theorem pp_finite_fragments_construct_chosen_Henkin_model:
  assumes "pp_finitely_consistent"
  shows "pp_full_QLN_axioms \<subseteq> pp_chosen_Henkin_model"
    and "CEV_Henkin_theory [] pp_chosen_Henkin_model"
proof -
  have model_exists: "pp_Henkin_model_exists"
    using assms pp_Henkin_model_exists_iff_finitely_consistent by blast
  have witness:
      "\<exists>U. pp_full_QLN_axioms \<subseteq> U \<and>
        CEV_Henkin_theory [] U"
    using model_exists unfolding pp_Henkin_model_exists_def .
  have chosen:
      "pp_full_QLN_axioms \<subseteq> pp_chosen_Henkin_model \<and>
        CEV_Henkin_theory [] pp_chosen_Henkin_model"
    unfolding pp_chosen_Henkin_model_def
    using witness by (rule someI_ex)
  show "pp_full_QLN_axioms \<subseteq> pp_chosen_Henkin_model"
    using chosen by blast
  show "CEV_Henkin_theory [] pp_chosen_Henkin_model"
    using chosen by blast
qed

theorem pp_finite_fragments_construct_term_model:
  assumes finite_consistent: "pp_finitely_consistent"
  shows
    "\<forall>A \<in> pp_full_QLN_axioms.
      term_model_holds pp_chosen_Henkin_model
        (term_model_eval Var A)"
    and
    "\<not> term_model_holds pp_chosen_Henkin_model
      (term_model_eval Var ObjFalse)"
proof -
  have target_sub:
      "pp_full_QLN_axioms \<subseteq> pp_chosen_Henkin_model"
    using finite_consistent
    by (rule pp_finite_fragments_construct_chosen_Henkin_model(1))
  have henkin:
      "CEV_Henkin_theory [] pp_chosen_Henkin_model"
    using finite_consistent
    by (rule pp_finite_fragments_construct_chosen_Henkin_model(2))
  have consistent:
      "CEV_consistent [] pp_chosen_Henkin_model"
    using henkin by (rule CEV_Henkin_CEV_consistent)
  show
      "\<forall>A \<in> pp_full_QLN_axioms.
        term_model_holds pp_chosen_Henkin_model
          (term_model_eval Var A)"
    using target_sub by (auto simp: term_model_holds_Var_iff)
  show
      "\<not> term_model_holds pp_chosen_Henkin_model
        (term_model_eval Var ObjFalse)"
    using consistent
    unfolding CEV_consistent_def
    by (auto simp: term_model_holds_Var_iff
        intro: CEV_set_derivable.Assumption typed_ObjFalse)
qed

subsection \<open>Direct model criterion\<close>

text \<open>
  Bacon's general-model and modal-model constructions establish consistency by
  soundness: exhibit one model of the axioms in which falsity is not valid.
  The following result packages that route for the exact PP/QLN target.  It is
  deliberately stated inside the semantic locale required by CEV, so a concrete
  substitution/action model need only discharge the target-axiom validity
  obligations.
\<close>

context vector_equivalence_structure
begin

lemma CEV_set_derivable_sound:
  assumes derivation: "\<Gamma> ; T \<turnstile>\<^sub>CEV\<^sub>s A"
  shows "(\<forall>B \<in> T. valid_in_context \<Gamma> B) \<Longrightarrow>
    valid_in_context \<Gamma> A"
  using derivation
proof (induction)
  case (Assumption A T \<Gamma>)
  then show ?case
    by blast
next
  case (Theorem \<Gamma> A T)
  from Theorem.hyps show ?case
    by (rule CEV_soundness)
next
  case (Derive_MP \<Gamma> T A B)
  then show ?case
    by (meson valid_MP)
qed

lemma ObjFalse_not_valid:
  "\<not> valid_in_context [] ObjFalse"
proof
  assume false_valid: "valid_in_context [] ObjFalse"
  have empty_env: "env_typed [] (\<lambda>_. truth_den False)"
    unfolding env_typed_def by (simp add: lookup_def)
  have "holds (eval (\<lambda>_. truth_den False) ObjFalse)"
    using false_valid empty_env by (rule valid_holds)
  then show False
    by (simp add: ObjFalse_def ObjTrue_def)
qed

theorem pp_consistency_from_concrete_model:
  assumes target_valid:
    "\<And>A. A \<in> pp_full_QLN_axioms \<Longrightarrow> valid_in_context [] A"
  shows "pp_consistency_question"
proof (unfold pp_consistency_question_def CEV_consistent_def, intro notI)
  assume derives_false:
    "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s ObjFalse"
  have all_target_valid:
      "\<forall>A \<in> pp_full_QLN_axioms. valid_in_context [] A"
    using target_valid by blast
  have "valid_in_context [] ObjFalse"
    using derives_false all_target_valid by (rule CEV_set_derivable_sound)
  then show False
    using ObjFalse_not_valid by blast
qed

end

