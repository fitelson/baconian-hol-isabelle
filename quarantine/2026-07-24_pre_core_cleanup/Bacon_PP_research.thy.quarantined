lemma pp_QSS_r_derives_fun_r:
  "[] ; pp_full_QLN_QSS_r_axioms \<turnstile>\<^sub>CEV\<^sub>s pp_fun Prop pp_r"
  using typed_pp_fun[OF typed_pp_r]
  by (intro CEV_set_derivable.Assumption)
    (auto simp: pp_full_QLN_QSS_r_axioms_def pp_full_QLN_r_axioms_def)

lemma pp_QSS_r_derives_id_KTrue_instance:
  "[] ; pp_full_QLN_QSS_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_QSS_instance prop_id (pp_K ObjTrue) pp_r"
proof (rule pp_QSS_r_derives_instance)
  show "[] \<turnstile> prop_id : Prop \<rightarrow>\<^sub>o Prop"
    by (rule typed_prop_id)
  show "[] \<turnstile> pp_K ObjTrue : Prop \<rightarrow>\<^sub>o Prop"
    using typed_ObjTrue by (rule typed_pp_K)
  show "[] \<turnstile> pp_r : Prop"
    by (rule typed_pp_r)
  show "rename Suc prop_id = prop_id"
    by (simp add: prop_id_def)
  show "rename Suc (pp_K ObjTrue) = pp_K ObjTrue"
    by (simp add: pp_K_def ObjTrue_def shift_def)
qed

lemma pp_QSS_r_derives_Kr_id_instance:
  "[] ; pp_full_QLN_QSS_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_QSS_instance (pp_K pp_r) prop_id pp_r"
proof (rule pp_QSS_r_derives_instance)
  show "[] \<turnstile> pp_K pp_r : Prop \<rightarrow>\<^sub>o Prop"
    using typed_pp_r by (rule typed_pp_K)
  show "[] \<turnstile> prop_id : Prop \<rightarrow>\<^sub>o Prop"
    by (rule typed_prop_id)
  show "[] \<turnstile> pp_r : Prop"
    by (rule typed_pp_r)
  show "rename Suc (pp_K pp_r) = pp_K pp_r"
    by (simp add: pp_K_def pp_r_def shift_def)
  show "rename Suc prop_id = prop_id"
    by (simp add: prop_id_def)
qed

theorem pp_QSS_r_derives_not_eq_r_true:
  "[] ; pp_full_QLN_QSS_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    Neg (Eq Prop pp_r ObjTrue)"
proof -
  let ?T = "pp_full_QLN_QSS_r_axioms"
  let ?E = "Eq Prop pp_r ObjTrue"
  have E_type: "[] \<turnstile> ?E : Prop"
    using typed_pp_r typed_ObjTrue by auto
  have d_false: "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s ObjFalse"
  proof -
    have d_E: "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s ?E"
      using E_type by (intro CEV_set_derivable.Assumption) simp
    have d_pure_id:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          pp_pure (Prop \<rightarrow>\<^sub>o Prop) prop_id"
      using pp_QSS_r_derives_pure_prop_id
      by (rule CEV_set_derivable_mono) blast
    have d_pure_K_true:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K ObjTrue)"
      using pp_QSS_r_derives_pure_K_true
      by (rule CEV_set_derivable_mono) blast
    have d_fun_r:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s pp_fun Prop pp_r"
      using pp_QSS_r_derives_fun_r
      by (rule CEV_set_derivable_mono) blast
    have d_inner:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Conj
            (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K ObjTrue))
            (pp_fun Prop pp_r)"
      using d_pure_K_true d_fun_r by (rule CEV_set_conj_intro)
    have d_antecedent:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Conj
            (pp_pure (Prop \<rightarrow>\<^sub>o Prop) prop_id)
            (Conj
              (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K ObjTrue))
              (pp_fun Prop pp_r))"
      using d_pure_id d_inner by (rule CEV_set_conj_intro)
    have d_instance:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          pp_QSS_instance prop_id (pp_K ObjTrue) pp_r"
      using pp_QSS_r_derives_id_KTrue_instance
      by (rule CEV_set_derivable_mono) blast
    have d_qss:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Imp
            (Eq Prop
              (App prop_id pp_r)
              (App (pp_K ObjTrue) pp_r))
            (Eq (Prop \<rightarrow>\<^sub>o Prop) prop_id (pp_K ObjTrue))"
      using d_antecedent d_instance
      unfolding pp_QSS_instance_def
      by (rule CEV_set_derivable.Derive_MP)
    have d_id_r:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop (App prop_id pp_r) pp_r"
      using CEV_prop_id_apply_eq[OF typed_pp_r]
      by (rule CEV_set_derivable.Theorem)
    have d_K_true_r:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop (App (pp_K ObjTrue) pp_r) ObjTrue"
      using CEV_pp_K_apply_eq[OF typed_ObjTrue typed_pp_r]
      by (rule CEV_set_derivable.Theorem)
    have d_id_r_true:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop (App prop_id pp_r) ObjTrue"
      using typed_prop_id typed_pp_r typed_ObjTrue d_id_r d_E
      by (auto intro: CEV_set_eq_trans_from)
    have d_true_K_true_r:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop ObjTrue (App (pp_K ObjTrue) pp_r)"
      using typed_ObjTrue typed_pp_r d_K_true_r
      by (auto intro: typed_pp_K CEV_set_eq_sym_from)
    have id_r_type: "[] \<turnstile> App prop_id pp_r : Prop"
      using typed_prop_id typed_pp_r by auto
    have K_true_r_type:
        "[] \<turnstile> App (pp_K ObjTrue) pp_r : Prop"
      using typed_pp_K[OF typed_ObjTrue] typed_pp_r by auto
    have d_at_r:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop
            (App prop_id pp_r)
            (App (pp_K ObjTrue) pp_r)"
      using id_r_type typed_ObjTrue K_true_r_type
        d_id_r_true d_true_K_true_r
      by (rule CEV_set_eq_trans_from)
    have d_functions:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq (Prop \<rightarrow>\<^sub>o Prop) prop_id (pp_K ObjTrue)"
      using d_at_r d_qss by (rule CEV_set_derivable.Derive_MP)
    have d_at_false:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop
            (App prop_id ObjFalse)
            (App (pp_K ObjTrue) ObjFalse)"
      using typed_prop_id typed_pp_K[OF typed_ObjTrue] typed_ObjFalse
        d_functions
      by (rule CEV_set_eq_app_cong_from)
    have d_id_false:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop (App prop_id ObjFalse) ObjFalse"
      using CEV_prop_id_apply_eq[OF typed_ObjFalse]
      by (rule CEV_set_derivable.Theorem)
    have d_false_id_false:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop ObjFalse (App prop_id ObjFalse)"
      using typed_ObjFalse typed_prop_id d_id_false
      by (auto intro: CEV_set_eq_sym_from)
    have d_K_true_false:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop (App (pp_K ObjTrue) ObjFalse) ObjTrue"
      using CEV_pp_K_apply_eq[OF typed_ObjTrue typed_ObjFalse]
      by (rule CEV_set_derivable.Theorem)
    have id_false_type: "[] \<turnstile> App prop_id ObjFalse : Prop"
      using typed_prop_id typed_ObjFalse by auto
    have K_true_false_type:
        "[] \<turnstile> App (pp_K ObjTrue) ObjFalse : Prop"
      using typed_pp_K[OF typed_ObjTrue] typed_ObjFalse by auto
    have d_false_K_true_false:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop ObjFalse (App (pp_K ObjTrue) ObjFalse)"
      using typed_ObjFalse id_false_type K_true_false_type
        d_false_id_false d_at_false
      by (rule CEV_set_eq_trans_from)
    have d_false_true:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop ObjFalse ObjTrue"
      using typed_ObjFalse K_true_false_type typed_ObjTrue
        d_false_K_true_false d_K_true_false
      by (rule CEV_set_eq_trans_from)
    have d_true_false:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop ObjTrue ObjFalse"
      using typed_ObjFalse typed_ObjTrue d_false_true
      by (rule CEV_set_eq_sym_from)
    have ll:
        "[] \<turnstile>\<^sub>CEV
          Imp
            (Eq Prop ObjTrue ObjFalse)
            (Imp
              (App prop_id ObjTrue)
              (App prop_id ObjFalse))"
      using typed_ObjTrue typed_ObjFalse typed_prop_id
      by (intro CEV_proves.CE CE_proves.C C_proves.H H_proves.LL)
    have d_ll:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Imp
            (Eq Prop ObjTrue ObjFalse)
            (Imp
              (App prop_id ObjTrue)
              (App prop_id ObjFalse))"
      using ll by (rule CEV_set_derivable.Theorem)
    have d_app_imp:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Imp (App prop_id ObjTrue) (App prop_id ObjFalse)"
      using d_true_false d_ll by (rule CEV_set_derivable.Derive_MP)
    have d_id_true:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s App prop_id ObjTrue"
      using CEV_prop_id_ObjTrue by (rule CEV_set_derivable.Theorem)
    have d_id_false_formula:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s App prop_id ObjFalse"
      using d_id_true d_app_imp by (rule CEV_set_derivable.Derive_MP)
    have d_beta_false:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Imp (App prop_id ObjFalse) ObjFalse"
      using CEV_app_prop_id_imp[OF typed_ObjFalse]
      by (rule CEV_set_derivable.Theorem)
    show ?thesis
      using d_id_false_formula d_beta_false
      by (rule CEV_set_derivable.Derive_MP)
  qed
  have d_imp_false:
      "[] ; ?T \<turnstile>\<^sub>CEV\<^sub>s Imp ?E ObjFalse"
    using E_type d_false by (rule CEV_set_derivable_deduction)
  have d_bridge:
      "[] ; ?T \<turnstile>\<^sub>CEV\<^sub>s Imp (Imp ?E ObjFalse) (Neg ?E)"
    using CEV_proves_imp_false_to_neg[OF E_type]
    by (rule CEV_set_derivable.Theorem)
  show ?thesis
    using d_imp_false d_bridge by (rule CEV_set_derivable.Derive_MP)
qed

theorem pp_QSS_r_derives_F_r:
  "[] ; pp_full_QLN_QSS_r_axioms \<turnstile>\<^sub>CEV\<^sub>s App pp_F pp_r"
proof -
  let ?T = "pp_full_QLN_QSS_r_axioms"
  let ?P = "pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K pp_r)"
  let ?E = "Eq Prop pp_r ObjTrue"
  have P_type: "[] \<turnstile> ?P : Prop"
    using typed_pp_K[OF typed_pp_r] by (rule typed_pp_pure)
  have d_false: "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s ObjFalse"
  proof -
    have d_P: "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s ?P"
      using P_type by (intro CEV_set_derivable.Assumption) simp
    have d_pure_id:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          pp_pure (Prop \<rightarrow>\<^sub>o Prop) prop_id"
      using pp_QSS_r_derives_pure_prop_id
      by (rule CEV_set_derivable_mono) blast
    have d_fun_r:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s pp_fun Prop pp_r"
      using pp_QSS_r_derives_fun_r
      by (rule CEV_set_derivable_mono) blast
    have d_inner:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Conj
            (pp_pure (Prop \<rightarrow>\<^sub>o Prop) prop_id)
            (pp_fun Prop pp_r)"
      using d_pure_id d_fun_r by (rule CEV_set_conj_intro)
    have d_antecedent:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Conj
            (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K pp_r))
            (Conj
              (pp_pure (Prop \<rightarrow>\<^sub>o Prop) prop_id)
              (pp_fun Prop pp_r))"
      using d_P d_inner by (rule CEV_set_conj_intro)
    have d_instance:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          pp_QSS_instance (pp_K pp_r) prop_id pp_r"
      using pp_QSS_r_derives_Kr_id_instance
      by (rule CEV_set_derivable_mono) blast
    have d_qss:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Imp
            (Eq Prop
              (App (pp_K pp_r) pp_r)
              (App prop_id pp_r))
            (Eq (Prop \<rightarrow>\<^sub>o Prop) (pp_K pp_r) prop_id)"
      using d_antecedent d_instance
      unfolding pp_QSS_instance_def
      by (rule CEV_set_derivable.Derive_MP)
    have d_Kr_r:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop (App (pp_K pp_r) pp_r) pp_r"
      using CEV_pp_K_apply_eq[OF typed_pp_r typed_pp_r]
      by (rule CEV_set_derivable.Theorem)
    have d_id_r:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop (App prop_id pp_r) pp_r"
      using CEV_prop_id_apply_eq[OF typed_pp_r]
      by (rule CEV_set_derivable.Theorem)
    have d_r_id_r:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop pp_r (App prop_id pp_r)"
      using typed_pp_r typed_prop_id d_id_r
      by (auto intro: CEV_set_eq_sym_from)
    have Kr_r_type: "[] \<turnstile> App (pp_K pp_r) pp_r : Prop"
      using typed_pp_K[OF typed_pp_r] typed_pp_r by auto
    have id_r_type: "[] \<turnstile> App prop_id pp_r : Prop"
      using typed_prop_id typed_pp_r by auto
    have d_at_r:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop
            (App (pp_K pp_r) pp_r)
            (App prop_id pp_r)"
      using Kr_r_type typed_pp_r id_r_type d_Kr_r d_r_id_r
      by (rule CEV_set_eq_trans_from)
    have d_functions:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq (Prop \<rightarrow>\<^sub>o Prop) (pp_K pp_r) prop_id"
      using d_at_r d_qss by (rule CEV_set_derivable.Derive_MP)
    have d_at_true:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop
            (App (pp_K pp_r) ObjTrue)
            (App prop_id ObjTrue)"
      using typed_pp_K[OF typed_pp_r] typed_prop_id typed_ObjTrue
        d_functions
      by (rule CEV_set_eq_app_cong_from)
    have d_Kr_true:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop (App (pp_K pp_r) ObjTrue) pp_r"
      using CEV_pp_K_apply_eq[OF typed_pp_r typed_ObjTrue]
      by (rule CEV_set_derivable.Theorem)
    have d_r_Kr_true:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop pp_r (App (pp_K pp_r) ObjTrue)"
      using typed_pp_r typed_ObjTrue d_Kr_true
      by (auto intro: typed_pp_K CEV_set_eq_sym_from)
    have d_id_true:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop (App prop_id ObjTrue) ObjTrue"
      using CEV_prop_id_apply_eq[OF typed_ObjTrue]
      by (rule CEV_set_derivable.Theorem)
    have Kr_true_type:
        "[] \<turnstile> App (pp_K pp_r) ObjTrue : Prop"
      using typed_pp_K[OF typed_pp_r] typed_ObjTrue by auto
    have id_true_type: "[] \<turnstile> App prop_id ObjTrue : Prop"
      using typed_prop_id typed_ObjTrue by auto
    have d_r_id_true:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop pp_r (App prop_id ObjTrue)"
      using typed_pp_r Kr_true_type id_true_type d_r_Kr_true d_at_true
      by (rule CEV_set_eq_trans_from)
    have d_E: "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s ?E"
      using typed_pp_r id_true_type typed_ObjTrue d_r_id_true d_id_true
      by (rule CEV_set_eq_trans_from)
    have d_not_E: "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s Neg ?E"
      using pp_QSS_r_derives_not_eq_r_true
      by (rule CEV_set_derivable_mono) blast
    show ?thesis
      using d_E d_not_E
      by (rule CEV_set_derives_ObjFalse_of_formula_and_neg_derivable)
  qed
  have d_imp_false:
      "[] ; ?T \<turnstile>\<^sub>CEV\<^sub>s Imp ?P ObjFalse"
    using P_type d_false by (rule CEV_set_derivable_deduction)
  have d_neg_bridge:
      "[] ; ?T \<turnstile>\<^sub>CEV\<^sub>s
        Imp (Imp ?P ObjFalse) (Neg ?P)"
    using CEV_proves_imp_false_to_neg[OF P_type]
    by (rule CEV_set_derivable.Theorem)
  have d_not_P: "[] ; ?T \<turnstile>\<^sub>CEV\<^sub>s Neg ?P"
    using d_imp_false d_neg_bridge by (rule CEV_set_derivable.Derive_MP)
  have F_r_type: "[] \<turnstile> App pp_F pp_r : Prop"
    using typed_pp_F typed_pp_r by auto
  have not_P_type: "[] \<turnstile> Neg ?P : Prop"
    using P_type by auto
  have bridge:
      "[] \<turnstile>\<^sub>CEV Imp (Neg ?P) (App pp_F pp_r)"
    using F_r_type not_P_type CEV_pp_F_apply[OF typed_pp_r]
    by (rule CEV_beta_right_imp)
  have d_bridge:
      "[] ; ?T \<turnstile>\<^sub>CEV\<^sub>s
        Imp (Neg ?P) (App pp_F pp_r)"
    using bridge by (rule CEV_set_derivable.Theorem)
  show ?thesis
    using d_not_P d_bridge by (rule CEV_set_derivable.Derive_MP)
qed

lemma pp_unary_recombination_r_derives_pure_singleton_true_role:
  "[] ; pp_unary_recombination_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_pure (Prop \<rightarrow>\<^sub>o Prop)
      (pp_singleton_fun_role ObjTrue)"
proof -
  have membership:
      "pp_pure (Prop \<rightarrow>\<^sub>o Prop)
        (pp_singleton_fun_role ObjTrue)
        \<in> pp_unary_recombination_r_axioms"
    using pp_pure_singleton_true_role_in_schema
    by (simp add: pp_unary_recombination_r_axioms_def pp_core_axioms_def)
  show ?thesis
    using membership
      pp_purity_schema_typed[OF pp_pure_singleton_true_role_in_schema]
    by (rule CEV_set_derivable.Assumption)
qed

lemma pp_unary_recombination_r_derives_fun_r:
  "[] ; pp_unary_recombination_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_fun Prop pp_r"
  using typed_pp_fun[OF typed_pp_r]
  by (intro CEV_set_derivable.Assumption)
    (simp add: pp_unary_recombination_r_axioms_def)

lemma pp_unary_recombination_r_derives_singleton_true_instance:
  "[] ; pp_unary_recombination_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_unary_recombination_instance
      (pp_singleton_fun_role ObjTrue) pp_r"
proof (rule pp_derives_unary_recombination_instance)
  show "pp_unary_recombination \<in> pp_unary_recombination_r_axioms"
    by (simp add: pp_unary_recombination_r_axioms_def)
  show "[] \<turnstile> pp_singleton_fun_role ObjTrue : Prop \<rightarrow>\<^sub>o Prop"
    using typed_ObjTrue by (rule typed_pp_singleton_fun_role)
  show "[] \<turnstile> pp_r : Prop"
    by (rule typed_pp_r)
  show "rename Suc (pp_singleton_fun_role ObjTrue) =
      pp_singleton_fun_role ObjTrue"
    by (simp add: pp_singleton_fun_role_def ObjTrue_def shift_def)
qed

lemma pp_unary_recombination_r_derives_pure_agreement_builder:
  "[] ; pp_unary_recombination_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_pure
      ((Prop \<rightarrow>\<^sub>o Prop) \<rightarrow>\<^sub>o
        (Prop \<rightarrow>\<^sub>o Prop))
      pp_agreement_builder"
proof -
  have membership:
      "pp_pure
        ((Prop \<rightarrow>\<^sub>o Prop) \<rightarrow>\<^sub>o
          (Prop \<rightarrow>\<^sub>o Prop))
        pp_agreement_builder
        \<in> pp_unary_recombination_r_axioms"
    using pp_agreement_builder_purity_in_schema
    by (simp add: pp_unary_recombination_r_axioms_def pp_core_axioms_def)
  show ?thesis
    using membership
      pp_purity_schema_typed[OF pp_agreement_builder_purity_in_schema]
    by (rule CEV_set_derivable.Assumption)
qed

lemma pp_unary_recombination_r_derives_agreement_application_instance:
  "[] ; pp_unary_recombination_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_agreement_application_purity_instance"
proof -
  let ?U = "Prop \<rightarrow>\<^sub>o Prop"
  let ?T = "pp_unary_recombination_r_axioms"
  have closure_member:
      "pp_application_closure ?U ?U \<in> ?T"
    unfolding pp_unary_recombination_r_axioms_def pp_core_axioms_def
      pp_application_closure_schema_def
    by blast
  have closure:
      "[] ; ?T \<turnstile>\<^sub>CEV\<^sub>s pp_application_closure ?U ?U"
    using closure_member typed_pp_application_closure
    by (rule CEV_set_derivable.Assumption)
  have first_raw:
      "[] ; ?T \<turnstile>\<^sub>CEV\<^sub>s
        subst0 pp_agreement_builder
          (Forall ?U
            (Imp
              (Conj
                (pp_pure (?U \<rightarrow>\<^sub>o ?U) (Var 1))
                (pp_pure ?U (Var 0)))
              (pp_pure ?U (App (Var 1) (Var 0)))))"
    using closure typed_pp_agreement_builder
    unfolding pp_application_closure_def
    by (rule CEV_set_forall_elim)
  have first:
      "[] ; ?T \<turnstile>\<^sub>CEV\<^sub>s
        Forall ?U
          (Imp
            (Conj
              (pp_pure (?U \<rightarrow>\<^sub>o ?U) pp_agreement_builder)
              (pp_pure ?U (Var 0)))
            (pp_pure ?U (App pp_agreement_builder (Var 0))))"
    using first_raw
    by (simp add: subst0_def pp_agreement_builder_def
        pp_pure_def pp_Pure_def subst_lift_shift shift_def)
  have second_raw:
      "[] ; ?T \<turnstile>\<^sub>CEV\<^sub>s
        subst0 (pp_K pp_r)
          (Imp
            (Conj
              (pp_pure (?U \<rightarrow>\<^sub>o ?U) pp_agreement_builder)
              (pp_pure ?U (Var 0)))
            (pp_pure ?U (App pp_agreement_builder (Var 0))))"
    using first typed_pp_K[OF typed_pp_r]
    by (rule CEV_set_forall_elim)
  show ?thesis
    using second_raw
    by (simp add: pp_agreement_application_purity_instance_def
        pp_Kr_agreement_def pp_agreement_builder_def pp_K_def pp_r_def
        pp_pure_def pp_Pure_def subst0_def subst_lift_shift shift_def)
qed

lemma pp_unary_recombination_r_derives_Kr_agreement_instance:
  "[] ; pp_unary_recombination_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_unary_recombination_instance pp_Kr_agreement pp_r"
proof (rule pp_derives_unary_recombination_instance)
  show "pp_unary_recombination \<in> pp_unary_recombination_r_axioms"
    by (simp add: pp_unary_recombination_r_axioms_def)
  show "[] \<turnstile> pp_Kr_agreement : Prop \<rightarrow>\<^sub>o Prop"
    by (rule typed_pp_Kr_agreement)
  show "[] \<turnstile> pp_r : Prop"
    by (rule typed_pp_r)
  show "rename Suc pp_Kr_agreement = pp_Kr_agreement"
    by (simp add: pp_Kr_agreement_def pp_agreement_builder_def
        pp_K_def pp_r_def shift_def)
qed

theorem pp_unary_recombination_r_derives_not_eq_r_true:
  "[] ; pp_unary_recombination_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    Neg (Eq Prop pp_r ObjTrue)"
proof -
  let ?T = "pp_unary_recombination_r_axioms"
  let ?W = "pp_singleton_fun_role ObjTrue"
  let ?E = "Eq Prop pp_r ObjTrue"
  have W_type: "[] \<turnstile> ?W : Prop \<rightarrow>\<^sub>o Prop"
    using typed_ObjTrue by (rule typed_pp_singleton_fun_role)
  have E_type: "[] \<turnstile> ?E : Prop"
    using typed_pp_r typed_ObjTrue by auto
  have d_false: "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s ObjFalse"
  proof -
    have d_E: "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s ?E"
      using E_type by (intro CEV_set_derivable.Assumption) simp
    have d_rigidity:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Imp ?E (Eq Prop ?E ObjTrue)"
      using CEV_eq_truth_of_eq[OF typed_pp_r typed_ObjTrue]
      by (rule CEV_set_derivable.Theorem)
    have d_box_E:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s Eq Prop ?E ObjTrue"
      using d_E d_rigidity by (rule CEV_set_derivable.Derive_MP)
    have d_beta:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop (App ?W pp_r) ?E"
      using CEV_pp_singleton_fun_role_apply_eq[
        OF typed_ObjTrue typed_pp_r]
      by (rule CEV_set_derivable.Theorem)
    have W_r_type: "[] \<turnstile> App ?W pp_r : Prop"
      using W_type typed_pp_r by auto
    have d_box_W_r:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop (App ?W pp_r) ObjTrue"
      using W_r_type E_type typed_ObjTrue d_beta d_box_E
      by (rule CEV_set_eq_trans_from)
    have d_pure:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          pp_pure (Prop \<rightarrow>\<^sub>o Prop) ?W"
      using pp_unary_recombination_r_derives_pure_singleton_true_role
      by (rule CEV_set_derivable_mono) blast
    have d_fun:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s pp_fun Prop pp_r"
      using pp_unary_recombination_r_derives_fun_r
      by (rule CEV_set_derivable_mono) blast
    have d_antecedent:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Conj
            (pp_pure (Prop \<rightarrow>\<^sub>o Prop) ?W)
            (pp_fun Prop pp_r)"
      using d_pure d_fun by (rule CEV_set_conj_intro)
    have d_instance:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          pp_unary_recombination_instance ?W pp_r"
      using pp_unary_recombination_r_derives_singleton_true_instance
      by (rule CEV_set_derivable_mono) blast
    have d_box_imp_universal:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Imp
            (\<box>\<^sub>o (App ?W pp_r))
            (Forall Prop (App ?W (Var 0)))"
      using d_antecedent d_instance
      unfolding pp_unary_recombination_instance_def
      by (rule CEV_set_derivable.Derive_MP)
    have d_universal:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Forall Prop (App ?W (Var 0))"
      using d_box_W_r d_box_imp_universal
      unfolding ObjBox_def
      by (rule CEV_set_derivable.Derive_MP)
    have d_false_raw:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          subst0 ObjFalse (App ?W (Var 0))"
      using d_universal typed_ObjFalse by (rule CEV_set_forall_elim)
    have d_W_false:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s App ?W ObjFalse"
      using d_false_raw
      by (simp add: subst0_def pp_singleton_fun_role_def
          ObjTrue_def shift_def subst_lift_shift)
    have beta_imp:
        "[] \<turnstile>\<^sub>CEV
          Imp (App ?W ObjFalse) (Eq Prop ObjFalse ObjTrue)"
    proof -
      have left_type: "[] \<turnstile> App ?W ObjFalse : Prop"
        using W_type typed_ObjFalse by auto
      have right_type: "[] \<turnstile> Eq Prop ObjFalse ObjTrue : Prop"
        using typed_ObjFalse typed_ObjTrue by auto
      have bicond:
          "[] \<turnstile>\<^sub>CEV
            (App ?W ObjFalse \<longleftrightarrow>\<^sub>o
              Eq Prop ObjFalse ObjTrue)"
        using beta_eta_pp_singleton_fun_role_apply[
          OF typed_ObjTrue typed_ObjFalse]
        by (rule CEV_beta_eta_equiv)
      show ?thesis
        using left_type right_type bicond by (rule CEV_beta_left_imp)
    qed
    have d_beta_imp:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Imp (App ?W ObjFalse) (Eq Prop ObjFalse ObjTrue)"
      using beta_imp by (rule CEV_set_derivable.Theorem)
    have d_false_true:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Eq Prop ObjFalse ObjTrue"
      using d_W_false d_beta_imp by (rule CEV_set_derivable.Derive_MP)
    have modal_T:
        "[] \<turnstile>\<^sub>CEV Imp (Eq Prop ObjFalse ObjTrue) ObjFalse"
      using CEV_modal_T[OF typed_ObjFalse]
      by (simp add: modal_T_def ObjBox_def)
    have d_modal_T:
        "[] ; insert ?E ?T \<turnstile>\<^sub>CEV\<^sub>s
          Imp (Eq Prop ObjFalse ObjTrue) ObjFalse"
      using modal_T by (rule CEV_set_derivable.Theorem)
    show ?thesis
      using d_false_true d_modal_T by (rule CEV_set_derivable.Derive_MP)
  qed
  have d_imp_false:
      "[] ; ?T \<turnstile>\<^sub>CEV\<^sub>s Imp ?E ObjFalse"
    using E_type d_false by (rule CEV_set_derivable_deduction)
  have d_bridge:
      "[] ; ?T \<turnstile>\<^sub>CEV\<^sub>s Imp (Imp ?E ObjFalse) (Neg ?E)"
    using CEV_proves_imp_false_to_neg[OF E_type]
    by (rule CEV_set_derivable.Theorem)
  show ?thesis
    using d_imp_false d_bridge by (rule CEV_set_derivable.Derive_MP)
qed

theorem pp_unary_recombination_r_derives_not_pure_Kr:
  "[] ; pp_unary_recombination_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    Neg (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K pp_r))"
proof -
  let ?T = "pp_unary_recombination_r_axioms"
  let ?P = "pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K pp_r)"
  let ?G = "pp_Kr_agreement"
  let ?E = "Eq Prop pp_r ObjTrue"
  have P_type: "[] \<turnstile> ?P : Prop"
    using typed_pp_K[OF typed_pp_r] by (rule typed_pp_pure)
  have G_type: "[] \<turnstile> ?G : Prop \<rightarrow>\<^sub>o Prop"
    by (rule typed_pp_Kr_agreement)
  have d_false: "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s ObjFalse"
  proof -
    have d_P: "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s ?P"
      using P_type by (intro CEV_set_derivable.Assumption) simp
    have d_pure_builder:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          pp_pure
            ((Prop \<rightarrow>\<^sub>o Prop) \<rightarrow>\<^sub>o
              (Prop \<rightarrow>\<^sub>o Prop))
            pp_agreement_builder"
      using pp_unary_recombination_r_derives_pure_agreement_builder
      by (rule CEV_set_derivable_mono) blast
    have d_builder_and_Kr:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Conj
            (pp_pure
              ((Prop \<rightarrow>\<^sub>o Prop) \<rightarrow>\<^sub>o
                (Prop \<rightarrow>\<^sub>o Prop))
              pp_agreement_builder)
            ?P"
      using d_pure_builder d_P by (rule CEV_set_conj_intro)
    have d_application:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          pp_agreement_application_purity_instance"
      using pp_unary_recombination_r_derives_agreement_application_instance
      by (rule CEV_set_derivable_mono) blast
    have d_pure_G:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          pp_pure (Prop \<rightarrow>\<^sub>o Prop) ?G"
      using d_builder_and_Kr d_application
      unfolding pp_agreement_application_purity_instance_def
      by (rule CEV_set_derivable.Derive_MP)
    have d_fun:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s pp_fun Prop pp_r"
      using pp_unary_recombination_r_derives_fun_r
      by (rule CEV_set_derivable_mono) blast
    have d_antecedent:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Conj
            (pp_pure (Prop \<rightarrow>\<^sub>o Prop) ?G)
            (pp_fun Prop pp_r)"
      using d_pure_G d_fun by (rule CEV_set_conj_intro)
    have d_instance:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          pp_unary_recombination_instance ?G pp_r"
      using pp_unary_recombination_r_derives_Kr_agreement_instance
      by (rule CEV_set_derivable_mono) blast
    have d_box_imp_universal:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Imp
            (\<box>\<^sub>o (App ?G pp_r))
            (Forall Prop (App ?G (Var 0)))"
      using d_antecedent d_instance
      unfolding pp_unary_recombination_instance_def
      by (rule CEV_set_derivable.Derive_MP)
    let ?R = "Eq Prop pp_r pp_r"
    have R_type: "[] \<turnstile> ?R : Prop"
      using typed_pp_r by auto
    have d_R: "[] \<turnstile>\<^sub>CEV ?R"
      using typed_pp_r
      by (intro CEV_proves.CE CE_proves.C C_proves.H H_proves.Ref)
    have d_box_R: "[] \<turnstile>\<^sub>CEV \<box>\<^sub>o ?R"
      using d_R by (rule CEV_necessitation)
    have d_box_R_eq:
        "[] \<turnstile>\<^sub>CEV Eq Prop ?R ObjTrue"
      using d_box_R unfolding ObjBox_def .
    have G_r_type: "[] \<turnstile> App ?G pp_r : Prop"
      using G_type typed_pp_r by auto
    have beta_G_r:
        "[] \<turnstile>\<^sub>CEV
          (App ?G pp_r \<longleftrightarrow>\<^sub>o ?R)"
      using CEV_pp_Kr_agreement_apply[OF typed_pp_r] .
    have eq_G_r_R:
        "[] \<turnstile>\<^sub>CEV Eq Prop (App ?G pp_r) ?R"
      using G_r_type R_type beta_G_r by (rule CEV_zeroary_equivalence)
    have box_G_r:
        "[] \<turnstile>\<^sub>CEV \<box>\<^sub>o (App ?G pp_r)"
      unfolding ObjBox_def
      using G_r_type R_type typed_ObjTrue eq_G_r_R d_box_R_eq
      by (rule CEV_eq_trans_from)
    have d_box_G_r:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          \<box>\<^sub>o (App ?G pp_r)"
      using box_G_r by (rule CEV_set_derivable.Theorem)
    have d_universal:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Forall Prop (App ?G (Var 0))"
      using d_box_G_r d_box_imp_universal
      by (rule CEV_set_derivable.Derive_MP)
    have d_true_raw:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          subst0 ObjTrue (App ?G (Var 0))"
      using d_universal typed_ObjTrue by (rule CEV_set_forall_elim)
    have d_G_true:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s App ?G ObjTrue"
      using d_true_raw
      by (simp add: subst0_def pp_Kr_agreement_def
          pp_agreement_builder_def pp_K_def pp_r_def
          shift_def subst_lift_shift)
    have beta_imp:
        "[] \<turnstile>\<^sub>CEV
          Imp (App ?G ObjTrue) ?E"
    proof -
      have left_type: "[] \<turnstile> App ?G ObjTrue : Prop"
        using G_type typed_ObjTrue by auto
      have E_type: "[] \<turnstile> ?E : Prop"
        using typed_pp_r typed_ObjTrue by auto
      show ?thesis
        using left_type E_type
          CEV_pp_Kr_agreement_apply[OF typed_ObjTrue]
        by (rule CEV_beta_left_imp)
    qed
    have d_beta_imp:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s
          Imp (App ?G ObjTrue) ?E"
      using beta_imp by (rule CEV_set_derivable.Theorem)
    have d_E: "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s ?E"
      using d_G_true d_beta_imp by (rule CEV_set_derivable.Derive_MP)
    have d_not_E:
        "[] ; insert ?P ?T \<turnstile>\<^sub>CEV\<^sub>s Neg ?E"
      using pp_unary_recombination_r_derives_not_eq_r_true
      by (rule CEV_set_derivable_mono) blast
    show ?thesis
      using d_E d_not_E
      by (rule CEV_set_derives_ObjFalse_of_formula_and_neg_derivable)
  qed
  have d_imp_false:
      "[] ; ?T \<turnstile>\<^sub>CEV\<^sub>s Imp ?P ObjFalse"
    using P_type d_false by (rule CEV_set_derivable_deduction)
  have d_bridge:
      "[] ; ?T \<turnstile>\<^sub>CEV\<^sub>s Imp (Imp ?P ObjFalse) (Neg ?P)"
    using CEV_proves_imp_false_to_neg[OF P_type]
    by (rule CEV_set_derivable.Theorem)
  show ?thesis
    using d_imp_false d_bridge by (rule CEV_set_derivable.Derive_MP)
qed

theorem pp_unary_recombination_r_derives_F_r:
  "[] ; pp_unary_recombination_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    App pp_F pp_r"
proof -
  let ?P = "pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K pp_r)"
  have F_r_type: "[] \<turnstile> App pp_F pp_r : Prop"
    using typed_pp_F typed_pp_r by auto
  have not_P_type: "[] \<turnstile> Neg ?P : Prop"
    using typed_pp_K[OF typed_pp_r]
    by (intro has_type.Neg typed_pp_pure)
  have bridge:
      "[] \<turnstile>\<^sub>CEV Imp (Neg ?P) (App pp_F pp_r)"
    using F_r_type not_P_type CEV_pp_F_apply[OF typed_pp_r]
    by (rule CEV_beta_right_imp)
  have d_bridge:
      "[] ; pp_unary_recombination_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        Imp (Neg ?P) (App pp_F pp_r)"
    using bridge by (rule CEV_set_derivable.Theorem)
  show ?thesis
    using pp_unary_recombination_r_derives_not_pure_Kr d_bridge
    by (rule CEV_set_derivable.Derive_MP)
qed

lemma CEV_F_true_imp_not_pure_K_true:
  "[] \<turnstile>\<^sub>CEV
    Imp
      (App pp_F ObjTrue)
      (Neg (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K ObjTrue)))"
proof -
  have left_type: "[] \<turnstile> App pp_F ObjTrue : Prop"
    using typed_pp_F typed_ObjTrue by auto
  have right_type:
      "[] \<turnstile>
        Neg (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K ObjTrue)) : Prop"
    using typed_pp_K[OF typed_ObjTrue]
    by (intro has_type.Neg typed_pp_pure)
  show ?thesis
    using left_type right_type CEV_pp_F_apply[OF typed_ObjTrue]
    by (rule CEV_beta_left_imp)
qed

lemma pp_full_QLN_derives_not_F_true:
  "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s Neg (App pp_F ObjTrue)"
proof -
  have local_imp:
      "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s
        Imp
          (App pp_F ObjTrue)
          (Neg (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (pp_K ObjTrue)))"
    using CEV_F_true_imp_not_pure_K_true
    by (rule CEV_set_derivable.Theorem)
  show ?thesis
    using pp_full_QLN_derives_pure_K_true local_imp
    by (rule CEV_set_modus_tollens)
qed

definition pp_F_universal :: oterm where
  "pp_F_universal = Forall Prop (App pp_F (Var 0))"

lemma typed_pp_F_universal:
  "[] \<turnstile> pp_F_universal : Prop"
  by (rule infer_type_sound)
    (simp add: pp_F_universal_def pp_F_def pp_K_def pp_pure_def
      pp_Pure_def shift_def lookup_def)

lemma CEV_pp_F_universal_imp_F_true:
  "[] \<turnstile>\<^sub>CEV Imp pp_F_universal (App pp_F ObjTrue)"
proof -
  have body_type: "Prop # [] \<turnstile> App pp_F (Var 0) : Prop"
    by (rule infer_type_sound)
      (simp add: pp_F_def pp_K_def pp_pure_def pp_Pure_def
        shift_def lookup_def)
  have ui:
      "[] \<turnstile>\<^sub>CEV
        Imp (Forall Prop (App pp_F (Var 0)))
          (subst0 ObjTrue (App pp_F (Var 0)))"
    using body_type typed_ObjTrue
    by (intro CEV_proves.CE CE_proves.C C_proves.H H_proves.UI)
  show ?thesis
    using ui
    by (simp add: pp_F_universal_def subst0_def pp_F_def pp_K_def
        pp_pure_def pp_Pure_def subst_lift_shift)
qed

lemma pp_full_QLN_derives_not_F_universal:
  "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s Neg pp_F_universal"
proof -
  have local_imp:
      "[] ; pp_full_QLN_axioms \<turnstile>\<^sub>CEV\<^sub>s
        Imp pp_F_universal (App pp_F ObjTrue)"
    using CEV_pp_F_universal_imp_F_true
    by (rule CEV_set_derivable.Theorem)
  show ?thesis
    using pp_full_QLN_derives_not_F_true local_imp
    by (rule CEV_set_modus_tollens_neg)
qed

definition pp_F_r_QLN_instance :: oterm where
  "pp_F_r_QLN_instance =
    Imp
      (Conj
        (pp_pure (Prop \<rightarrow>\<^sub>o Prop) pp_F)
        (pp_fun Prop pp_r))
      ((\<box>\<^sub>o (App pp_F pp_r)) \<longleftrightarrow>\<^sub>o pp_F_universal)"

lemma typed_pp_F_r_QLN_instance:
  "[] \<turnstile> pp_F_r_QLN_instance : Prop"
  by (rule infer_type_sound)
    (simp add: pp_F_r_QLN_instance_def pp_F_universal_def
      pp_F_def pp_K_def pp_pure_def pp_Pure_def pp_fun_def pp_Fun_def
      pp_r_def ObjBox_def ObjTrue_def shift_def lookup_def)

lemma pp_QLN_r_derives_F_QLN_instance:
  "[] ; pp_full_QLN_r_axioms \<turnstile>\<^sub>CEV\<^sub>s pp_F_r_QLN_instance"
proof -
  have qln_member: "pp_unary_QLN \<in> pp_full_QLN_r_axioms"
    by (simp add: pp_full_QLN_r_axioms_def pp_full_QLN_axioms_def)
  have qln:
      "[] ; pp_full_QLN_r_axioms \<turnstile>\<^sub>CEV\<^sub>s pp_unary_QLN"
    using qln_member typed_pp_unary_QLN
    by (rule CEV_set_derivable.Assumption)
  have first_raw:
      "[] ; pp_full_QLN_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        subst0 pp_F
          (Forall Prop
            (Imp
              (Conj
                (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (Var 1))
                (pp_fun Prop (Var 0)))
              ((\<box>\<^sub>o (App (Var 1) (Var 0))) \<longleftrightarrow>\<^sub>o
                Forall Prop (App (Var 2) (Var 0)))))"
    using qln typed_pp_F
    unfolding pp_unary_QLN_def
    by (rule CEV_set_forall_elim)
  have first:
      "[] ; pp_full_QLN_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        Forall Prop
          (Imp
            (Conj
              (pp_pure (Prop \<rightarrow>\<^sub>o Prop) pp_F)
              (pp_fun Prop (Var 0)))
            ((\<box>\<^sub>o (App pp_F (Var 0))) \<longleftrightarrow>\<^sub>o
              Forall Prop (App pp_F (Var 0))))"
    using first_raw
    by (simp add: subst0_def pp_F_def pp_K_def pp_pure_def pp_Pure_def
        pp_fun_def pp_Fun_def ObjBox_def ObjTrue_def shift_def
        eval_nat_numeral)
  have second_raw:
      "[] ; pp_full_QLN_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        subst0 pp_r
          (Imp
            (Conj
              (pp_pure (Prop \<rightarrow>\<^sub>o Prop) pp_F)
              (pp_fun Prop (Var 0)))
            ((\<box>\<^sub>o (App pp_F (Var 0))) \<longleftrightarrow>\<^sub>o
              Forall Prop (App pp_F (Var 0))))"
    using first typed_pp_r
    by (rule CEV_set_forall_elim)
  show ?thesis
    using second_raw
    by (simp add: pp_F_r_QLN_instance_def pp_F_universal_def
        pp_F_def pp_K_def pp_pure_def pp_Pure_def pp_fun_def pp_Fun_def
        pp_r_def ObjBox_def ObjTrue_def subst0_def subst_lift_shift shift_def)
qed

lemma pp_QLN_r_derives_pure_F:
  "[] ; pp_full_QLN_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_pure (Prop \<rightarrow>\<^sub>o Prop) pp_F"
  using pp_full_QLN_derives_pure_F
  by (rule CEV_set_derivable_mono)
    (auto simp: pp_full_QLN_r_axioms_def)

lemma pp_QLN_r_derives_fun_r:
  "[] ; pp_full_QLN_r_axioms \<turnstile>\<^sub>CEV\<^sub>s pp_fun Prop pp_r"
  using typed_pp_fun[OF typed_pp_r]
  by (intro CEV_set_derivable.Assumption)
    (simp add: pp_full_QLN_r_axioms_def)

lemma pp_QLN_r_derives_not_F_universal:
  "[] ; pp_full_QLN_r_axioms \<turnstile>\<^sub>CEV\<^sub>s Neg pp_F_universal"
  using pp_full_QLN_derives_not_F_universal
  by (rule CEV_set_derivable_mono)
    (auto simp: pp_full_QLN_r_axioms_def)

theorem pp_QLN_r_derives_not_box_F:
  "[] ; pp_full_QLN_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    Neg (\<box>\<^sub>o (App pp_F pp_r))"
proof -
  let ?A = "\<box>\<^sub>o (App pp_F pp_r)"
  let ?B = "pp_F_universal"
  have pure_and_fun:
      "[] ; pp_full_QLN_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        Conj
          (pp_pure (Prop \<rightarrow>\<^sub>o Prop) pp_F)
          (pp_fun Prop pp_r)"
    using pp_QLN_r_derives_pure_F pp_QLN_r_derives_fun_r
    by (rule CEV_set_conj_intro)
  have bicond:
      "[] ; pp_full_QLN_r_axioms \<turnstile>\<^sub>CEV\<^sub>s (?A \<longleftrightarrow>\<^sub>o ?B)"
    using pure_and_fun pp_QLN_r_derives_F_QLN_instance
    unfolding pp_F_r_QLN_instance_def
    by (rule CEV_set_derivable.Derive_MP)
  have A_type: "[] \<turnstile> ?A : Prop"
    by (rule infer_type_sound)
      (simp add: pp_F_def pp_K_def pp_pure_def pp_Pure_def pp_r_def
        ObjBox_def ObjTrue_def shift_def lookup_def)
  have B_type: "[] \<turnstile> ?B : Prop"
    by (rule typed_pp_F_universal)
  have taut:
      "prop_tautology [] (Imp (?A \<longleftrightarrow>\<^sub>o ?B) (Imp ?A ?B))"
    unfolding prop_tautology_def
    using A_type B_type by auto
  have local_taut:
      "[] ; pp_full_QLN_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        Imp (?A \<longleftrightarrow>\<^sub>o ?B) (Imp ?A ?B)"
    using taut by (rule CEV_set_prop_tautology)
  have forward:
      "[] ; pp_full_QLN_r_axioms \<turnstile>\<^sub>CEV\<^sub>s Imp ?A ?B"
    using bicond local_taut by (rule CEV_set_derivable.Derive_MP)
  show ?thesis
    using pp_QLN_r_derives_not_F_universal forward
    by (rule CEV_set_modus_tollens_neg)
qed

theorem pp_QSS_r_derives_not_box_F:
  "[] ; pp_full_QLN_QSS_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    Neg (\<box>\<^sub>o (App pp_F pp_r))"
  using pp_QLN_r_derives_not_box_F
  by (rule CEV_set_derivable_mono)
    (rule pp_full_QLN_r_subset_QSS_r)

theorem pp_QSS_r_boomerang:
  "[] ; pp_full_QLN_QSS_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    Conj (App pp_F pp_r) (Neg (\<box>\<^sub>o (App pp_F pp_r)))"
  using pp_QSS_r_derives_F_r pp_QSS_r_derives_not_box_F
  by (rule CEV_set_conj_intro)

definition pp_F_r_recombination_instance :: oterm where
  "pp_F_r_recombination_instance =
    Imp
      (Conj
        (pp_pure (Prop \<rightarrow>\<^sub>o Prop) pp_F)
        (pp_fun Prop pp_r))
      (Imp
        (\<box>\<^sub>o (App pp_F pp_r))
        pp_F_universal)"

lemma typed_pp_F_r_recombination_instance:
  "[] \<turnstile> pp_F_r_recombination_instance : Prop"
  by (rule infer_type_sound)
    (simp add: pp_F_r_recombination_instance_def pp_F_universal_def
      pp_F_def pp_K_def pp_pure_def pp_Pure_def pp_fun_def pp_Fun_def
      pp_r_def ObjBox_def ObjTrue_def shift_def lookup_def)

lemma pp_named_r_derives_F_recombination_instance:
  "[] ; pp_full_QLN_named_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
    pp_F_r_recombination_instance"
proof -
  have unary_member:
      "pp_unary_recombination \<in> pp_full_QLN_named_r_axioms"
    by (simp add: pp_full_QLN_named_r_axioms_def)
  have unary:
      "[] ; pp_full_QLN_named_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        pp_unary_recombination"
    using unary_member typed_pp_unary_recombination
    by (rule CEV_set_derivable.Assumption)
  have first_raw:
      "[] ; pp_full_QLN_named_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        subst0 pp_F
          (Forall Prop
            (Imp
              (Conj
                (pp_pure (Prop \<rightarrow>\<^sub>o Prop) (Var 1))
                (pp_fun Prop (Var 0)))
              (Imp
                (\<box>\<^sub>o (App (Var 1) (Var 0)))
                (Forall Prop (App (Var 2) (Var 0))))))"
    using unary typed_pp_F
    unfolding pp_unary_recombination_def
    by (rule CEV_set_forall_elim)
  have first:
      "[] ; pp_full_QLN_named_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        Forall Prop
          (Imp
            (Conj
              (pp_pure (Prop \<rightarrow>\<^sub>o Prop) pp_F)
              (pp_fun Prop (Var 0)))
            (Imp
              (\<box>\<^sub>o (App pp_F (Var 0)))
              (Forall Prop (App pp_F (Var 0)))))"
    using first_raw
    by (simp add: subst0_def pp_F_def pp_K_def pp_pure_def pp_Pure_def
        pp_fun_def pp_Fun_def ObjBox_def ObjTrue_def shift_def
        eval_nat_numeral)
  have second_raw:
      "[] ; pp_full_QLN_named_r_axioms \<turnstile>\<^sub>CEV\<^sub>s
        subst0 pp_r
          (Imp
            (Conj
              (pp_pure (Prop \<rightarrow>\<^sub>o Prop) pp_F)
              (pp_fun Prop (Var 0)))
            (Imp
              (\<box>\<^sub>o (App pp_F (Var 0)))
              (Forall Prop (App pp_F (Var 0)))))"
    using first typed_pp_r
    by (rule CEV_set_forall_elim)
  show ?thesis
    using second_raw
    by (simp add: pp_F_r_recombination_instance_def pp_F_universal_def
        pp_F_def pp_K_def pp_pure_def pp_Pure_def pp_fun_def pp_Fun_def
        pp_r_def ObjBox_def ObjTrue_def subst0_def subst_lift_shift shift_def)
qed

