%------------------------------------------------------------------------------
% Goodman: finite THF refutation target for Theory + PP
%------------------------------------------------------------------------------
%
% Purpose:
%   Ask Vampire to derive a contradiction from a finite, explicitly typed
%   fragment of Goodman's background theory together with PP.
%
% Status:
%   This is a proof-search input, not a complete encoding of the schematic
%   theory.  THF0 cannot quantify over simple types, so the infinitely many
%   instances of Purity, application closure, Modalized Functionality, and
%   the absence of fundamental entities at non-propositional types are
%   represented here only at the types displayed below.
%
%   A Vampire refutation is therefore useful evidence only after its used
%   axioms are translated back into the Isabelle object language and the
%   derivation is checked there.  "Satisfiable" or "unknown" does not establish
%   the consistency of the full theory.
%
% Object types represented:
%   prop    propositions
%   op1     unary propositional operators, prop -> prop
%   op2     predicates of unary operators, op1 -> prop
%
% Application is explicit and world-indexed.  Thus op1 and op2 are abstract
% intensional objects; THF's native function extensionality does not identify
% them.  is_pure_p and is_pure_o are defined by application of the relevant
% Pure objects, so the PP axiom below is genuinely self-applicative:
%
%   PP: Pure_(op1)(Pure_prop).
%
% Suggested command:
%   /usr/local/bin/vampire -t 300 \
%     fresh_attack/goodman_pp_refutation_finite.thf.in
%------------------------------------------------------------------------------

thf(world_type,type,world:$tType).
thf(prop_type,type,prop:$tType).
thf(op1_type,type,op1:$tType).
thf(op2_type,type,op2:$tType).

thf(holds_type,type,holds:world>prop>$o).
thf(app_p_type,type,app_p:world>op1>prop>prop).
thf(app_o_type,type,app_o:world>op2>op1>prop).

thf(is_pure_p_type,type,is_pure_p:world>prop>$o).
thf(is_pure_o_type,type,is_pure_o:world>op1>$o).
thf(is_fun_p_type,type,is_fun_p:world>prop>$o).
thf(is_fun_o_type,type,is_fun_o:world>op1>$o).
thf(is_fun_oo_type,type,is_fun_oo:world>op2>$o).

thf(pure_p_type,type,pure_p:op1).
thf(pure_o_type,type,pure_o:op2).
thf(fun_p_type,type,fun_p:op1).
thf(fun_o_type,type,fun_o:op2).

thf(top_p_type,type,top_p:prop).
thf(bot_p_type,type,bot_p:prop).
thf(id_o_type,type,id_o:op1).
thf(not_o_type,type,not_o:op1).
thf(box_o_type,type,box_o:op1).

% Pure and Fun are represented by their classifier objects.
thf(pure_prop_definition,axiom,
    ! [W:world,P:prop] :
      ( (is_pure_p @ W @ P)
      <=> (holds @ W @ (app_p @ W @ pure_p @ P)) )).

thf(pure_op_definition,axiom,
    ! [W:world,X:op1] :
      ( (is_pure_o @ W @ X)
      <=> (holds @ W @ (app_o @ W @ pure_o @ X)) )).

thf(fun_prop_definition,axiom,
    ! [W:world,P:prop] :
      ( (is_fun_p @ W @ P)
      <=> (holds @ W @ (app_p @ W @ fun_p @ P)) )).

thf(fun_op_definition,axiom,
    ! [W:world,X:op1] :
      ( (is_fun_o @ W @ X)
      <=> (holds @ W @ (app_o @ W @ fun_o @ X)) )).

% A small stock of closed logical objects and their interpretations.
thf(top_truth,axiom,
    ! [W:world] : (holds @ W @ top_p)).

thf(bottom_falsity,axiom,
    ! [W:world] : ~(holds @ W @ bot_p)).

thf(identity_application,axiom,
    ! [W:world,P:prop] :
      ((app_p @ W @ id_o @ P) = P)).

thf(negation_truth,axiom,
    ! [W:world,P:prop] :
      ( (holds @ W @ (app_p @ W @ not_o @ P))
      <=> ~(holds @ W @ P) )).

% Box is interpreted by truth at every world.  This is the universal-frame
% presentation of the intended necessity operator.
thf(box_truth,axiom,
    ! [W:world,P:prop] :
      ( (holds @ W @ (app_p @ W @ box_o @ P))
      <=> ! [V:world] : (holds @ V @ P) )).

% Selected instances of the purity-of-logical-vocabulary schema.
thf(pure_top,axiom,
    ! [W:world] : (is_pure_p @ W @ top_p)).

thf(pure_bottom,axiom,
    ! [W:world] : (is_pure_p @ W @ bot_p)).

thf(pure_identity,axiom,
    ! [W:world] : (is_pure_o @ W @ id_o)).

thf(pure_negation,axiom,
    ! [W:world] : (is_pure_o @ W @ not_o)).

thf(pure_box,axiom,
    ! [W:world] : (is_pure_o @ W @ box_o)).

% Application closure at prop -> prop.
thf(pure_application_prop,axiom,
    ! [W:world,X:op1,P:prop] :
      ( ((is_pure_o @ W @ X) & (is_pure_p @ W @ P))
     => (is_pure_p @ W @ (app_p @ W @ X @ P)) )).

% Exactly one fundamental proposition.
thf(unique_fundamental_proposition,axiom,
    ! [W:world] :
      ? [P:prop] :
        ( (is_fun_p @ W @ P)
        & ! [Q:prop] : ((is_fun_p @ W @ Q) => (Q = P)) )).

% No fundamental entities at the represented non-propositional types.
thf(no_fundamental_op1,axiom,
    ! [W:world,X:op1] : ~(is_fun_o @ W @ X)).

thf(no_fundamental_op2,axiom,
    ! [W:world,H:op2] : ~(is_fun_oo @ W @ H)).

% Zeroary QLN: Recombination and Exhaustion.
thf(zeroary_recombination,axiom,
    ! [W:world,P:prop] :
      ( ((is_pure_p @ W @ P)
       & (! [V:world] : (holds @ V @ P)))
     => (holds @ W @ P) )).

thf(zeroary_exhaustion,axiom,
    ! [W:world,P:prop] :
      ( ((is_pure_p @ W @ P)
       & (holds @ W @ P))
     => (! [V:world] : (holds @ V @ P)) )).

% Unary QLN, split into Recombination and Exhaustion.
thf(unary_recombination,axiom,
    ! [W:world,X:op1,P:prop] :
      ( ((is_pure_o @ W @ X)
       & (is_fun_p @ W @ P)
       & (! [V:world] : (holds @ V @ (app_p @ V @ X @ P))))
     => (! [Q:prop] : (holds @ W @ (app_p @ W @ X @ Q))) )).

thf(unary_exhaustion,axiom,
    ! [W:world,X:op1,P:prop] :
      ( ((is_pure_o @ W @ X)
       & (is_fun_p @ W @ P)
       & (! [Q:prop] : (holds @ W @ (app_p @ W @ X @ Q))))
     => (! [V:world] : (holds @ V @ (app_p @ V @ X @ P))) )).

% Modalized Functionality at prop -> prop.
thf(modalized_functionality_op1,axiom,
    ! [W:world,X:op1,Y:op1] :
      ( (! [V:world,P:prop] :
           ((app_p @ V @ X @ P) = (app_p @ V @ Y @ P)))
     => (X = Y) )).

% Modalized Functionality at op1 -> prop.
thf(modalized_functionality_op2,axiom,
    ! [W:world,H:op2,K:op2] :
      ( (! [V:world,X:op1] :
           ((app_o @ V @ H @ X) = (app_o @ V @ K @ X)))
     => (H = K) )).

% Goodman's PP assumption: the purity predicate for unary propositional
% operators is itself pure.
thf(goodman_PP,axiom,
    ! [W:world] : (is_pure_o @ W @ pure_p)).

% Denial of consistency, presented as the refutation target.
thf(deny_goodman_consistency,conjecture,$false).
