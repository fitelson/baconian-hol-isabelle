%------------------------------------------------------------------------------
% Goodman: many-sorted first-order refutation target for Theory + PP
%------------------------------------------------------------------------------
%
% Purpose:
%   Ask Vampire to derive a contradiction from the same finite, explicitly
%   typed fragment of Goodman's background theory together with PP that is
%   represented in goodman_pp_refutation_finite.thf.in.
%
% Translation:
%   This is an axiom-for-axiom first-order reification of the THF input.
%   The THF input quantifies only over the four opaque base types displayed
%   below.  Its curried application symbols are replaced here by ordinary
%   many-sorted function and predicate symbols.  No object-language operator
%   is represented by a TFF function space.
%
% Status:
%   This is a proof-search input, not a complete encoding of the schematic
%   theory.  The infinitely many instances of Purity, application closure,
%   Modalized Functionality, and the absence of fundamental entities at
%   non-propositional types are represented only at the sorts displayed below.
%
%   A Vampire refutation is therefore useful evidence only after its used
%   axioms are translated back into the Isabelle object language and the
%   derivation is checked there.  "Satisfiable" or "unknown" does not establish
%   the consistency of the full theory.
%
% Object sorts represented:
%   prop    propositions
%   op1     unary propositional operators, represented opaquely
%   op2     predicates of unary operators, represented opaquely
%
% Application is explicit and world-indexed.  Built-in first-order equality
% therefore does not identify operators merely because they agree in
% application.  The displayed Modalized Functionality axioms state the
% relevant identifications explicitly.
%------------------------------------------------------------------------------

tff(world_type,type,world:$tType).
tff(prop_type,type,prop:$tType).
tff(op1_type,type,op1:$tType).
tff(op2_type,type,op2:$tType).

tff(holds_type,type,holds:(world * prop)>$o).
tff(app_p_type,type,app_p:(world * op1 * prop)>prop).
tff(app_o_type,type,app_o:(world * op2 * op1)>prop).

tff(is_pure_p_type,type,is_pure_p:(world * prop)>$o).
tff(is_pure_o_type,type,is_pure_o:(world * op1)>$o).
tff(is_fun_p_type,type,is_fun_p:(world * prop)>$o).
tff(is_fun_o_type,type,is_fun_o:(world * op1)>$o).
tff(is_fun_oo_type,type,is_fun_oo:(world * op2)>$o).

tff(pure_p_type,type,pure_p:op1).
tff(pure_o_type,type,pure_o:op2).
tff(fun_p_type,type,fun_p:op1).
tff(fun_o_type,type,fun_o:op2).

tff(top_p_type,type,top_p:prop).
tff(bot_p_type,type,bot_p:prop).
tff(id_o_type,type,id_o:op1).
tff(not_o_type,type,not_o:op1).
tff(box_o_type,type,box_o:op1).

% Pure and Fun are represented by their classifier objects.
tff(pure_prop_definition,axiom,
    ! [W:world,P:prop] :
      ( is_pure_p(W,P)
    <=> holds(W,app_p(W,pure_p,P)) )).

tff(pure_op_definition,axiom,
    ! [W:world,X:op1] :
      ( is_pure_o(W,X)
    <=> holds(W,app_o(W,pure_o,X)) )).

tff(fun_prop_definition,axiom,
    ! [W:world,P:prop] :
      ( is_fun_p(W,P)
    <=> holds(W,app_p(W,fun_p,P)) )).

tff(fun_op_definition,axiom,
    ! [W:world,X:op1] :
      ( is_fun_o(W,X)
    <=> holds(W,app_o(W,fun_o,X)) )).

% A small stock of closed logical objects and their interpretations.
tff(top_truth,axiom,
    ! [W:world] : holds(W,top_p)).

tff(bottom_falsity,axiom,
    ! [W:world] : ~ holds(W,bot_p)).

tff(identity_application,axiom,
    ! [W:world,P:prop] :
      (app_p(W,id_o,P) = P)).

tff(negation_truth,axiom,
    ! [W:world,P:prop] :
      ( holds(W,app_p(W,not_o,P))
    <=> ~ holds(W,P) )).

% Box is interpreted by truth at every world.  This is the universal-frame
% presentation of the intended necessity operator.
tff(box_truth,axiom,
    ! [W:world,P:prop] :
      ( holds(W,app_p(W,box_o,P))
    <=> ! [V:world] : holds(V,P) )).

% Selected instances of the purity-of-logical-vocabulary schema.
tff(pure_top,axiom,
    ! [W:world] : is_pure_p(W,top_p)).

tff(pure_bottom,axiom,
    ! [W:world] : is_pure_p(W,bot_p)).

tff(pure_identity,axiom,
    ! [W:world] : is_pure_o(W,id_o)).

tff(pure_negation,axiom,
    ! [W:world] : is_pure_o(W,not_o)).

tff(pure_box,axiom,
    ! [W:world] : is_pure_o(W,box_o)).

% Application closure at prop -> prop.
tff(pure_application_prop,axiom,
    ! [W:world,X:op1,P:prop] :
      ( (is_pure_o(W,X) & is_pure_p(W,P))
     => is_pure_p(W,app_p(W,X,P)) )).

% Exactly one fundamental proposition.
tff(unique_fundamental_proposition,axiom,
    ! [W:world] :
      ? [P:prop] :
        ( is_fun_p(W,P)
        & ! [Q:prop] : (is_fun_p(W,Q) => Q = P) )).

% No fundamental entities at the represented non-propositional types.
tff(no_fundamental_op1,axiom,
    ! [W:world,X:op1] : ~ is_fun_o(W,X)).

tff(no_fundamental_op2,axiom,
    ! [W:world,H:op2] : ~ is_fun_oo(W,H)).

% Zeroary QLN: Recombination and Exhaustion.
tff(zeroary_recombination,axiom,
    ! [W:world,P:prop] :
      ( (is_pure_p(W,P)
         & ! [V:world] : holds(V,P))
     => holds(W,P) )).

tff(zeroary_exhaustion,axiom,
    ! [W:world,P:prop] :
      ( (is_pure_p(W,P)
         & holds(W,P))
     => ! [V:world] : holds(V,P) )).

% Unary QLN, split into Recombination and Exhaustion.
tff(unary_recombination,axiom,
    ! [W:world,X:op1,P:prop] :
      ( (is_pure_o(W,X)
         & is_fun_p(W,P)
         & ! [V:world] : holds(V,app_p(V,X,P)))
     => ! [Q:prop] : holds(W,app_p(W,X,Q)) )).

tff(unary_exhaustion,axiom,
    ! [W:world,X:op1,P:prop] :
      ( (is_pure_o(W,X)
         & is_fun_p(W,P)
         & ! [Q:prop] : holds(W,app_p(W,X,Q)))
     => ! [V:world] : holds(V,app_p(V,X,P)) )).

% Modalized Functionality at prop -> prop.
tff(modalized_functionality_op1,axiom,
    ! [W:world,X:op1,Y:op1] :
      ( (! [V:world,P:prop] :
           (app_p(V,X,P) = app_p(V,Y,P)))
     => X = Y )).

% Modalized Functionality at op1 -> prop.
tff(modalized_functionality_op2,axiom,
    ! [W:world,H:op2,K:op2] :
      ( (! [V:world,X:op1] :
           (app_o(V,H,X) = app_o(V,K,X)))
     => H = K )).

% Goodman's PP assumption: the purity predicate for unary propositional
% operators is itself pure.
tff(goodman_PP,axiom,
    ! [W:world] : is_pure_o(W,pure_p)).

% Denial of consistency, presented as the refutation target.
tff(deny_goodman_consistency,conjecture,$false).
