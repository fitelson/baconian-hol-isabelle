% Algebraic bridge: composition classification implies weak L2.
% No PP, Recombination, Exhaustion, or existence premise is needed.

include('00_common_semantics.tff.in').

tff(assume_composition_classification,axiom,
    ! [W:world] : composition_classification(W)).

tff(classification_implies_weak_L2,conjecture,
    ! [W:world] : weak_L2(W)).
