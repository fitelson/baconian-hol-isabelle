% Combine the collision-agreement lemma with composition classification.
% The first axiom is admitted here only after file 02 has been proved.

include('00_algebraic_base.thf.in').

thf(collision_implies_agreements_lemma,axiom,
    ! [W:world,X:prop>prop,Y:prop>prop,P:prop,Q:prop] :
      (((pure_op_at @ W @ X)
        & (pure_op_at @ W @ Y)
        & (fun_prime @ W @ P)
        & (fun_prime @ W @ Q)
        & ((X @ P) = (Y @ Q)))
       =>
       (same_agreements @ W @ X @ Y))).

thf(classification_implies_L2,conjecture,
    ! [W:world] :
      ((composition_classification @ W) => (weak_L2 @ W))).
